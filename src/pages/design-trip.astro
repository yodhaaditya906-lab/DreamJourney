---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { userId, sessionClaims } = Astro.locals.auth();
const clerkUser = await Astro.locals.currentUser();
if (clerkUser) {
    const hasDomisili = clerkUser.unsafeMetadata?.domisili;
    const hasDob = clerkUser.unsafeMetadata?.dob;
    
    if (!hasDomisili || !hasDob) {
        return Astro.redirect('/onboarding?redirect_url=/design-trip');
    }
}

let dbUser = null;
if (userId) {
    const { data } = await supabase.from('users').select('*').eq('id', userId).maybeSingle();
    dbUser = data;
}

const currentUsername = (
    dbUser?.username || 
    (sessionClaims?.username as string) || 
    clerkUser?.username || 
    clerkUser?.emailAddresses?.[0]?.emailAddress?.split('@')[0] || 
    ''
).toLowerCase();

const currentUserEmail = (
    dbUser?.email || 
    clerkUser?.emailAddresses?.[0]?.emailAddress || 
    ''
).toLowerCase();
---

<Layout title="Rancang Trip & Kalkulasi Biaya - DreamJourney">
    <main class="pt-24 pb-16 bg-slate-50/70 min-h-screen relative overflow-hidden" data-current-username={currentUsername} data-current-email={currentUserEmail}>
        <div class="container mx-auto px-4 w-full max-w-6xl relative z-10 space-y-6">
            
            <!-- Back Navigation & Title Header -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <a href="/planner" class="inline-flex items-center gap-2 text-xs md:text-sm font-bold text-slate-600 hover:text-indigo-600 transition-all group">
                    <i data-feather="arrow-left" class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform"></i>
                    <span>Kembali ke Rencana Perjalanan</span>
                </a>
                <span class="text-xs font-semibold text-slate-400">DreamJourney Trip & Tabungan Wizard</span>
            </div>

            <!-- Stepper Indicator Bar (3 Steps Wizard) -->
            <div id="stepper-bar" class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex items-center justify-between max-w-3xl mx-auto mb-6">
                <!-- Step 1: Active -->
                <div id="step-indicator-1" class="flex items-center gap-2.5 text-indigo-600">
                    <div id="step-badge-1" class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-extrabold text-xs shadow-md shadow-indigo-500/20">
                        1
                    </div>
                    <span class="text-xs md:text-sm font-extrabold">Atur Trip & Tabungan</span>
                </div>

                <div class="flex-1 max-w-[60px] md:max-w-[100px] h-0.5 bg-slate-200 mx-2"></div>

                <!-- Step 2: Inactive -->
                <div id="step-indicator-2" class="flex items-center gap-2.5 text-slate-400">
                    <div id="step-badge-2" class="w-8 h-8 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center font-bold text-xs border border-slate-200">
                        2
                    </div>
                    <span class="text-xs md:text-sm font-semibold hidden sm:inline">Bayar QRIS</span>
                    <span class="text-xs md:text-sm font-semibold sm:hidden">QRIS</span>
                </div>

                <div class="flex-1 max-w-[60px] md:max-w-[100px] h-0.5 bg-slate-200 mx-2"></div>

                <!-- Step 3: Inactive -->
                <div id="step-indicator-3" class="flex items-center gap-2.5 text-slate-400">
                    <div id="step-badge-3" class="w-8 h-8 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center font-bold text-xs border border-slate-200">
                        3
                    </div>
                    <span class="text-xs md:text-sm font-semibold">Selesai</span>
                </div>
            </div>

            <!-- STEP 1: FORM & BREAKDOWN LAYOUT -->
            <div id="view-step-1" class="space-y-6">
                <div class="text-center max-w-2xl mx-auto mb-4">
                    <span class="inline-block px-3.5 py-1 bg-indigo-50 border border-indigo-100 text-indigo-700 font-bold rounded-full mb-2 text-xs tracking-wider uppercase">KALKULATOR PERJALANAN</span>
                    <h1 class="text-2xl md:text-4xl font-black text-slate-900 tracking-tight">Rancang Trip & Kalkulasi Biaya</h1>
                    <p class="text-slate-600 text-xs sm:text-sm mt-2">Catat kebutuhan penginapan, transportasi, dan wahana Anda. Sistem akan menghitung total biaya dan merekomendasikan skema tabungan.</p>
                </div>

                <form id="design-trip-form" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                    
                    <!-- LEFT COLUMN: Input Steps & Options -->
                    <div class="lg:col-span-7 space-y-6">
                        
                        <!-- 1. INFORMASI DASAR PERJALANAN -->
                        <div class="bg-white rounded-3xl shadow-sm border border-slate-100/90 overflow-hidden">
                            <div class="bg-slate-50/90 px-6 py-4 border-b border-slate-200/70 shadow-sm rounded-b-2xl flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <span class="text-indigo-600 font-black text-xl md:text-2xl">1</span>
                                    <h3 class="text-lg font-extrabold text-slate-900">Informasi Dasar</h3>
                                </div>
                            </div>

                            <div class="p-6 md:p-8 space-y-5">
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="md:col-span-2">
                                        <label class="block text-slate-700 text-xs font-bold mb-1.5 uppercase tracking-wider">Ke mana Anda ingin pergi? <span class="text-red-500">*</span></label>
                                        <input type="text" id="dest-input" placeholder="misal: Bali, Tokyo, Labuan Bajo, Paris" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-slate-50 focus:bg-white" required>
                                    </div>
                                    
                                    <div>
                                        <label class="block text-slate-700 text-xs font-bold mb-1.5 uppercase tracking-wider">Tipe Perjalanan <span class="text-red-500">*</span></label>
                                        <select id="trip-type" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition bg-slate-50 focus:bg-white" required>
                                            <option value="Solo">Solo Trip (Sendiri)</option>
                                            <option value="Couple">Couple (2 Orang)</option>
                                            <option value="Family">Keluarga</option>
                                            <option value="Group">Grup Teman</option>
                                        </select>
                                    </div>

                                    <!-- Dynamic Group Detail (Anggota Grup Container) -->
                                    <div id="container-group" class="hidden md:col-span-2 bg-blue-50/70 p-4 sm:p-5 rounded-2xl border border-blue-200/80 space-y-3.5 transition-all">
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <i data-feather="users" class="w-4 h-4 text-blue-700"></i>
                                                <label class="block text-sm font-bold text-blue-950">Anggota Grup</label>
                                            </div>
                                            <p class="text-xs font-semibold text-blue-800/80 mt-0.5">Ajak Teman Menabung Bersama</p>
                                        </div>

                                        <!-- Search / Invite Bar -->
                                        <div class="bg-white p-1.5 pl-3.5 rounded-xl border border-blue-200 focus-within:ring-2 focus-within:ring-indigo-500 focus-within:border-transparent transition flex items-center shadow-2xs">
                                            <input type="text" id="input-friend" placeholder="Ketik username / email teman disini..." class="flex-1 bg-transparent border-none outline-none text-xs sm:text-sm text-slate-800 placeholder-slate-400 py-1 font-medium">
                                            <button type="button" id="btn-add-friend" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-1 shadow-2xs shrink-0 cursor-pointer">
                                                <i data-feather="plus" class="w-3.5 h-3.5"></i> Undang
                                            </button>
                                        </div>
                                        <p id="friend-validation-msg" class="text-xs font-semibold text-red-600 hidden"></p>

                                        <!-- Header Jumlah & Daftar Anggota yang Ditambahkan (Di bawah search bar) -->
                                        <div id="friend-list-section" class="hidden space-y-2 pt-1">
                                            <div class="flex justify-between items-center text-xs font-bold text-blue-950">
                                                <span id="group-counter">Anggota yang Ditambahkan (0)</span>
                                            </div>
                                            
                                            <!-- Container Card List Anggota -->
                                            <div id="friend-chips-container" class="space-y-2"></div>
                                        </div>
                                        
                                        <p class="text-xs text-blue-800/80 leading-relaxed flex items-center gap-1.5 pt-1 border-t border-blue-100">
                                            <i data-feather="info" class="w-3.5 h-3.5 text-blue-600 shrink-0"></i> 
                                            <span>Undang teman Anda untuk menabung bersama. Mereka akan menerima undangan di dashboard mereka.</span>
                                        </p>
                                    </div>

                                    <div>
                                        <label class="block text-slate-700 text-xs font-bold mb-1.5 uppercase tracking-wider">Tanggal Keberangkatan <span class="text-red-500">*</span></label>
                                        <input type="date" id="departure-date" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 outline-none transition bg-slate-50 focus:bg-white" required>
                                    </div>
                                    
                                    <div>
                                        <label class="block text-slate-700 text-xs font-bold mb-1.5 uppercase tracking-wider">Target Selesai Menabung <span class="text-red-500">*</span></label>
                                        <input type="date" id="saving-end-date" class="w-full border border-slate-200 rounded-xl px-4 py-3 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-indigo-500 outline-none transition bg-slate-50 focus:bg-white" required>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. AKOMODASI PENGINAPAN -->
                        <div class="bg-white rounded-3xl shadow-sm border border-slate-100/90 overflow-hidden">
                            <div class="bg-slate-50/90 px-6 py-4 border-b border-slate-200/70 shadow-sm rounded-b-2xl flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="text-indigo-600 font-black text-xl md:text-2xl">2</span>
                                    <h3 class="text-lg font-extrabold text-slate-900">Akomodasi Penginapan</h3>
                                </div>
                                <button type="button" id="btn-add-hotel" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer">
                                    <i data-feather="plus" class="w-3.5 h-3.5"></i> Tambah
                                </button>
                            </div>
                            
                            <div class="p-6 md:p-8 space-y-4">
                                <div id="hotel-list" class="space-y-3">
                                    <div class="expense-row flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center bg-slate-50/80 p-3 rounded-2xl border border-slate-200/80">
                                        <input type="text" placeholder="Nama Hotel / Link Airbnb" class="flex-1 border border-slate-300 rounded-xl px-3.5 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-medium" required>
                                        <div class="w-full sm:w-36 relative flex items-center">
                                            <span class="absolute left-3 font-bold text-slate-400 text-xs pointer-events-none">Rp.</span>
                                            <input type="text" placeholder="0" class="cost-input w-full border border-slate-300 rounded-xl pl-9 pr-3 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-bold text-slate-800" required>
                                        </div>
                                        <select class="split-select border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 bg-white focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer shrink-0 shadow-2xs">
                                            <option value="split" selected>👥 Patungan</option>
                                            <option value="personal">👤 Per Orang</option>
                                        </select>
                                        <button type="button" class="btn-remove-row text-slate-400 hover:text-red-600 p-2 rounded-xl hover:bg-red-50 transition cursor-pointer shrink-0">
                                            <i data-feather="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. TRANSPORTASI -->
                        <div class="bg-white rounded-3xl shadow-sm border border-slate-100/90 overflow-hidden">
                            <div class="bg-slate-50/90 px-6 py-4 border-b border-slate-200/70 shadow-sm rounded-b-2xl flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="text-indigo-600 font-black text-xl md:text-2xl">3</span>
                                    <h3 class="text-lg font-extrabold text-slate-900">Transportasi</h3>
                                </div>
                                <button type="button" id="btn-add-transport" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer">
                                    <i data-feather="plus" class="w-3.5 h-3.5"></i> Tambah
                                </button>
                            </div>
                            
                            <div class="p-6 md:p-8 space-y-4">
                                <div id="transport-list" class="space-y-3">
                                    <div class="expense-row flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center bg-slate-50/80 p-3 rounded-2xl border border-slate-200/80">
                                        <input type="text" placeholder="Tiket Pesawat / Kereta / Sewa Mobil" class="flex-1 border border-slate-300 rounded-xl px-3.5 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-medium" required>
                                        <div class="w-full sm:w-36 relative flex items-center">
                                            <span class="absolute left-3 font-bold text-slate-400 text-xs pointer-events-none">Rp.</span>
                                            <input type="text" placeholder="0" class="cost-input w-full border border-slate-300 rounded-xl pl-9 pr-3 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-bold text-slate-800" required>
                                        </div>
                                        <select class="split-select border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 bg-white focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer shrink-0 shadow-2xs">
                                            <option value="personal" selected>👤 Per Orang</option>
                                            <option value="split">👥 Patungan</option>
                                        </select>
                                        <button type="button" class="btn-remove-row text-slate-400 hover:text-red-600 p-2 rounded-xl hover:bg-red-50 transition cursor-pointer shrink-0">
                                            <i data-feather="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. AKTIVITAS & WAHANA -->
                        <div class="bg-white rounded-3xl shadow-sm border border-slate-100/90 overflow-hidden">
                            <div class="bg-slate-50/90 px-6 py-4 border-b border-slate-200/70 shadow-sm rounded-b-2xl flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="text-indigo-600 font-black text-xl md:text-2xl">4</span>
                                    <h3 class="text-lg font-extrabold text-slate-900">Aktivitas & Wahana</h3>
                                </div>
                                <button type="button" id="btn-add-activity" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer">
                                    <i data-feather="plus" class="w-3.5 h-3.5"></i> Tambah
                                </button>
                            </div>
                            
                            <div class="p-6 md:p-8 space-y-4">
                                <div id="activity-list" class="space-y-3">
                                    <div class="expense-row flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center bg-slate-50/80 p-3 rounded-2xl border border-slate-200/80">
                                        <input type="text" placeholder="Tiket Wahana / Tour / Aktivitas" class="flex-1 border border-slate-300 rounded-xl px-3.5 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-medium" required>
                                        <div class="w-full sm:w-36 relative flex items-center">
                                            <span class="absolute left-3 font-bold text-slate-400 text-xs pointer-events-none">Rp.</span>
                                            <input type="text" placeholder="0" class="cost-input w-full border border-slate-300 rounded-xl pl-9 pr-3 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-bold text-slate-800" required>
                                        </div>
                                        <select class="split-select border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 bg-white focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer shrink-0 shadow-2xs">
                                            <option value="split" selected>👥 Patungan</option>
                                            <option value="personal">👤 Per Orang</option>
                                        </select>
                                        <button type="button" class="btn-remove-row text-slate-400 hover:text-red-600 p-2 rounded-xl hover:bg-red-50 transition cursor-pointer shrink-0">
                                            <i data-feather="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 5. PENGELUARAN LAIN-LAIN -->
                        <div class="bg-white rounded-3xl shadow-sm border border-slate-100/90 overflow-hidden">
                            <div class="bg-slate-50/90 px-6 py-4 border-b border-slate-200/70 shadow-sm rounded-b-2xl flex justify-between items-center">
                                <div class="flex items-center gap-3">
                                    <span class="text-indigo-600 font-black text-xl md:text-2xl">5</span>
                                    <h3 class="text-lg font-extrabold text-slate-900">Pengeluaran Lain</h3>
                                </div>
                                <button type="button" id="btn-add-other" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 bg-indigo-50 hover:bg-indigo-100 px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 cursor-pointer">
                                    <i data-feather="plus" class="w-3.5 h-3.5"></i> Tambah
                                </button>
                            </div>
                            
                            <div class="p-6 md:p-8 space-y-4">
                                <div id="other-list" class="space-y-3">
                                    <div class="expense-row flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center bg-slate-50/80 p-3 rounded-2xl border border-slate-200/80">
                                        <input type="text" placeholder="Visa / Asuransi / Belanja Oleh-oleh" class="flex-1 border border-slate-300 rounded-xl px-3.5 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-medium">
                                        <div class="w-full sm:w-36 relative flex items-center">
                                            <span class="absolute left-3 font-bold text-slate-400 text-xs pointer-events-none">Rp.</span>
                                            <input type="text" placeholder="0" class="cost-input w-full border border-slate-300 rounded-xl pl-9 pr-3 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-bold text-slate-800">
                                        </div>
                                        <select class="split-select border border-slate-300 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 bg-white focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer shrink-0 shadow-2xs">
                                            <option value="split" selected>👥 Patungan</option>
                                            <option value="personal">👤 Per Orang</option>
                                        </select>
                                        <button type="button" class="btn-remove-row text-slate-400 hover:text-red-600 p-2 rounded-xl hover:bg-red-50 transition cursor-pointer shrink-0">
                                            <i data-feather="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 6. PENGATURAN SKEMA & METODE -->
                        <div class="bg-white rounded-3xl shadow-sm border border-slate-100/90 overflow-hidden">
                            <div class="bg-slate-50/90 px-6 py-4 border-b border-slate-200/70 shadow-sm rounded-b-2xl flex items-center gap-3">
                                <span class="text-indigo-600 font-black text-xl md:text-2xl">6</span>
                                <h3 class="text-lg font-extrabold text-slate-900">Skema & Metode Pembayaran</h3>
                            </div>

                            <div class="p-6 md:p-8 space-y-5">
                                <!-- Buffer Ekstra Input -->
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-1 uppercase tracking-wider">Tambahan Uang Jaga-jaga (Buffer Darurat)</label>
                                    <div class="flex flex-col sm:flex-row gap-2.5 items-stretch sm:items-center">
                                        <div class="relative flex-1 flex items-center">
                                            <span class="absolute left-3.5 font-bold text-slate-400 text-xs pointer-events-none">Rp.</span>
                                            <input type="text" id="buffer-input" placeholder="0" class="cost-input w-full border border-slate-200 rounded-xl pl-10 pr-4 py-2.5 font-bold text-slate-800 text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none">
                                        </div>
                                        <select id="buffer-split-select" class="split-select border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs font-bold text-slate-800 bg-white focus:ring-2 focus:ring-indigo-500 outline-none cursor-pointer shrink-0 shadow-2xs">
                                            <option value="split" selected>👥 Patungan</option>
                                            <option value="personal">👤 Per Orang</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Frekuensi Menabung -->
                                <div>
                                    <label class="block text-xs font-bold text-slate-700 mb-2 uppercase tracking-wider">Pilih Frekuensi Menabung:</label>
                                    <div class="grid grid-cols-3 gap-2">
                                        <label class="border border-slate-200 bg-slate-50 rounded-xl p-3 text-center cursor-pointer hover:bg-indigo-50 peer-checked:border-indigo-600 peer-checked:bg-white transition relative shadow-2xs">
                                            <input type="radio" name="saving-freq" value="1" class="hidden peer" checked>
                                            <span class="text-xs font-black text-slate-800 block mb-0.5">Harian</span>
                                            <span class="text-[10px] text-slate-400 font-semibold">Tiap Hari</span>
                                            <div class="absolute inset-0 border-2 border-transparent peer-checked:border-indigo-600 rounded-xl pointer-events-none transition-all"></div>
                                        </label>
                                        <label class="border border-slate-200 bg-slate-50 rounded-xl p-3 text-center cursor-pointer hover:bg-indigo-50 peer-checked:border-indigo-600 peer-checked:bg-white transition relative shadow-2xs">
                                            <input type="radio" name="saving-freq" value="7" class="hidden peer">
                                            <span class="text-xs font-black text-slate-800 block mb-0.5">Mingguan</span>
                                            <span class="text-[10px] text-slate-400 font-semibold">Akhir Pekan</span>
                                            <div class="absolute inset-0 border-2 border-transparent peer-checked:border-indigo-600 rounded-xl pointer-events-none transition-all"></div>
                                        </label>
                                        <label class="border border-slate-200 bg-slate-50 rounded-xl p-3 text-center cursor-pointer hover:bg-indigo-50 peer-checked:border-indigo-600 peer-checked:bg-white transition relative shadow-2xs">
                                            <input type="radio" name="saving-freq" value="30" class="hidden peer">
                                            <span class="text-xs font-black text-slate-800 block mb-0.5">Bulanan</span>
                                            <span class="text-[10px] text-slate-400 font-semibold">Sesuai Gajian</span>
                                            <div class="absolute inset-0 border-2 border-transparent peer-checked:border-indigo-600 rounded-xl pointer-events-none transition-all"></div>
