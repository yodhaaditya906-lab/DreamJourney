                        <input type="text" value="${costFormatted}" placeholder="0" class="cost-input w-full border border-slate-300 rounded-xl pl-9 pr-3 py-2 focus:ring-2 focus:ring-indigo-500 outline-none text-xs sm:text-sm bg-white font-bold text-slate-800" required>
