<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Elements & Dynamic Row Lists
        const form = document.getElementById('design-trip-form') as HTMLFormElement;
        const tripTypeSelect = document.getElementById('trip-type') as HTMLSelectElement;
        const splitBillToggleContainer = document.getElementById('split-bill-toggle-container');
        const checkboxSplitBill = document.getElementById('checkbox-split-bill') as HTMLInputElement;
        const containerGroup = document.getElementById('container-group');

        // Target Summary Elements
        const destInput = document.getElementById('dest-input') as HTMLInputElement;
        const summaryDestTitle = document.getElementById('summary-dest-title');
        const summaryTotalTarget = document.getElementById('summary-total-target');
        const summaryHotelTotal = document.getElementById('summary-hotel-total');
        const summaryTransportTotal = document.getElementById('summary-transport-total');
        const summaryActivityTotal = document.getElementById('summary-activity-total');
        const summaryOtherTotal = document.getElementById('summary-other-total');
        const summaryBufferTotal = document.getElementById('summary-buffer-total');
        const summarySavingRate = document.getElementById('summary-saving-rate');
        const btnSubmitLabel = document.getElementById('btn-submit-label');

        // Mode Radios
        const modeDraft = document.getElementById('radio-mode-draft') as HTMLInputElement;
        const modeActive = document.getElementById('radio-mode-active') as HTMLInputElement;

        // Action Mode (Draft vs Active) Listener to update Button Label
        function updateSubmitButtonLabel() {
            if (btnSubmitLabel) {
                if (modeDraft && modeDraft.checked) {
                    btnSubmitLabel.innerHTML = '💾 Simpan Rencana (Draf)';
                } else {
                    btnSubmitLabel.innerHTML = '🚀 Lanjut ke Pembayaran QRIS';
                }
            }
        }

        modeDraft?.addEventListener('change', updateSubmitButtonLabel);
        modeActive?.addEventListener('change', updateSubmitButtonLabel);
        updateSubmitButtonLabel();

        // Stepper Elements
        const viewStep1 = document.getElementById('view-step-1');
        const viewStep2 = document.getElementById('view-step-2');
        const viewStep3 = document.getElementById('view-step-3');

        // Trip Type Change Handler (Directly shows Anggota Grup when not Solo)
        tripTypeSelect?.addEventListener('change', () => {
            const val = tripTypeSelect.value;
            if (val !== 'Solo') {
                containerGroup?.classList.remove('hidden');
            } else {
                containerGroup?.classList.add('hidden');
                groupMembersData = [];
                groupFriends = [];
                renderFriends();
                calculateBreakdown();
            }
        });

        // Friend List Data & Logic (Matching Image 1)
        interface GroupMemberData {
            username: string;
            fullName: string;
            avatarUrl?: string | null;
        }

        let groupMembersData: GroupMemberData[] = [];
        let groupFriends: string[] = [];

        const btnAddFriend = document.getElementById('btn-add-friend');
        const inputFriend = document.getElementById('input-friend') as HTMLInputElement;
        const friendChipsContainer = document.getElementById('friend-chips-container');
        const groupCounter = document.getElementById('group-counter');
        const friendMsg = document.getElementById('friend-validation-msg');
        const friendListSection = document.getElementById('friend-list-section');

        // Allow pressing Enter in input-friend to add friend
        inputFriend?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                btnAddFriend?.click();
            }
        });

        const avatarColors = [
            'bg-cyan-500', 'bg-pink-500', 'bg-amber-500', 'bg-blue-500',
            'bg-purple-500', 'bg-emerald-500', 'bg-rose-500', 'bg-indigo-600'
        ];

        function getAvatarBg(str: string): string {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                hash = str.charCodeAt(i) + ((hash << 5) - hash);
            }
            const index = Math.abs(hash) % avatarColors.length;
            return avatarColors[index];
        }

        function getInitials(name: string): string {
            const parts = name.trim().split(' ').filter(Boolean);
            if (parts.length >= 2) {
                return (parts[0][0] + parts[1][0]).toUpperCase();
            }
            return name.substring(0, 2).toUpperCase();
        }

        function renderFriends() {
            if (!friendChipsContainer || !groupCounter) return;
            friendChipsContainer.innerHTML = '';

            if (friendListSection) {
                if (groupMembersData.length > 0) {
                    friendListSection.classList.remove('hidden');
                } else {
                    friendListSection.classList.add('hidden');
                }
            }

            groupCounter.innerText = `Anggota yang Ditambahkan (${groupMembersData.length})`;

            groupMembersData.forEach((friend, idx) => {
                const item = document.createElement('div');
                item.className = 'flex items-center justify-between p-3 bg-white rounded-2xl border border-slate-100 shadow-2xs hover:border-blue-200 transition w-full';
                
                const displayName = friend.fullName || friend.username;
                const initials = getInitials(displayName);
                const bgColor = getAvatarBg(displayName);

                const avatarHtml = friend.avatarUrl 
                    ? `<img src="${friend.avatarUrl}" alt="${displayName}" class="w-10 h-10 rounded-full object-cover border border-slate-100 shadow-2xs shrink-0">`
                    : `<div class="w-10 h-10 rounded-full ${bgColor} text-white font-black text-xs flex items-center justify-center uppercase shadow-2xs shrink-0">${initials}</div>`;

                item.innerHTML = `
                    <div class="flex items-center gap-3 min-w-0">
                        ${avatarHtml}
                        <div class="flex flex-col min-w-0">
                            <span class="font-black text-xs sm:text-sm text-slate-900 truncate">${displayName}</span>
                            <span class="text-[11px] text-slate-500 font-semibold truncate">@${friend.username}</span>
                        </div>
                    </div>
                    <button type="button" class="p-1 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition btn-remove-friend cursor-pointer shrink-0 ml-2" data-idx="${idx}" title="Hapus">
                        <i data-feather="x" class="w-4 h-4"></i>
                    </button>
                `;
                friendChipsContainer.appendChild(item);
            });

            if ((window as any).feather) {
                (window as any).feather.replace();
            }

            // Remove logic
            const removeBtns = document.querySelectorAll('.btn-remove-friend');
            removeBtns.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const idxStr = (e.currentTarget as HTMLElement).getAttribute('data-idx');
                    if (idxStr !== null) {
                        const i = parseInt(idxStr, 10);
                        groupMembersData.splice(i, 1);
                        groupFriends = groupMembersData.map(m => m.username);
                        renderFriends();
                        calculateBreakdown();
                    }
                });
            });
        }

        // Add Friend Button handler with API lookup & fallback
        btnAddFriend?.addEventListener('click', async () => {
            if (!inputFriend) return;
            const val = inputFriend.value.trim().replace(/^@/, '');
            
            if (friendMsg) {
                friendMsg.classList.add('hidden');
                friendMsg.innerText = '';
            }

            if (!val) return;

            if (groupMembersData.some(m => m.username.toLowerCase() === val.toLowerCase())) {
                if (friendMsg) {
                    friendMsg.innerText = `⚠️ Username "${val}" sudah ada dalam daftar anggota.`;
                    friendMsg.classList.remove('hidden');
                }
                return;
            }

            const mainEl = document.querySelector('main');
            const currentUsername = (mainEl?.getAttribute('data-current-username') || '').toLowerCase();
            const currentUserEmail = (mainEl?.getAttribute('data-current-email') || '').toLowerCase();
            const valLower = val.toLowerCase();

            if (
                (currentUsername && valLower === currentUsername) ||
                (currentUserEmail && valLower === currentUserEmail) ||
                (currentUserEmail && valLower === currentUserEmail.split('@')[0])
            ) {
                if (friendMsg) {
                    friendMsg.innerText = `⚠️ Anda tidak dapat mengundang akun Anda sendiri ke dalam grup.`;
                    friendMsg.classList.remove('hidden');
                }
                return;
            }

            const originalText = btnAddFriend.innerHTML;
            btnAddFriend.innerHTML = '<i data-feather="loader" class="w-3.5 h-3.5 animate-spin"></i> Cek...';
            (btnAddFriend as HTMLButtonElement).disabled = true;

            try {
                const res = await fetch(`/api/check-username?username=${encodeURIComponent(val)}`);
                const data = await res.json();

                if (res.ok && !data.isAvailable && data.user) {
                    const u = data.user;
                    const fetchedUname = (u.username || '').toLowerCase();
                    const fetchedEmail = (u.email || '').toLowerCase();

                    if (
                        (currentUsername && fetchedUname === currentUsername) ||
                        (currentUserEmail && fetchedEmail === currentUserEmail)
                    ) {
                        if (friendMsg) {
                            friendMsg.innerText = `⚠️ Anda tidak dapat mengundang akun Anda sendiri ke dalam grup.`;
                            friendMsg.classList.remove('hidden');
                        }
                        return;
                    }

                    groupMembersData.push({
                        username: u.username || val,
                        fullName: u.fullName || u.username || val,
                        avatarUrl: u.avatarUrl || null
                    });
                } else {
                    // Fallback
                    groupMembersData.push({
                        username: val,
                        fullName: val,
                        avatarUrl: null
                    });
                }
                groupFriends = groupMembersData.map(m => m.username);
                inputFriend.value = '';
                renderFriends();
                calculateBreakdown();
            } catch (err) {
                // Fallback
                groupMembersData.push({
                    username: val,
                    fullName: val,
                    avatarUrl: null
                });
                groupFriends = groupMembersData.map(m => m.username);
                inputFriend.value = '';
                renderFriends();
                calculateBreakdown();
            } finally {
                btnAddFriend.innerHTML = originalText;
                (btnAddFriend as HTMLButtonElement).disabled = false;
                if ((window as any).feather) (window as any).feather.replace();
            }
        });

        // Add Row Functions for lists (with Patungan dropdown select)
