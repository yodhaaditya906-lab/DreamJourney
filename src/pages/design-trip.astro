                        split: splitSel?.value || 'split'
                    });
                }
            });
            return rows;
        }

        function setSectionRowData(listId: string, rowsData: { name?: string; cost?: string | number; split?: string }[], placeholderName: string, defaultSplit: boolean = true) {
            const list = document.getElementById(listId);
