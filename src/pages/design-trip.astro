            if ((window as any).feather) (window as any).feather.replace();
            bindCostInputs();
            bindSplitSelects();
        }

        // FORM SUBMISSION (STEP 1)
        form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const { grandTotalRombongan, grandTotalPersonal, amountPerFreq, labelUnit } = calculateBreakdown();

            const isDraft = modeDraft && modeDraft.checked;
            const title = destInput?.value.trim() || 'Perjalanan Impian';

            const bufferInput = document.getElementById('buffer-input') as HTMLInputElement;
            const bufferSplitSelect = document.getElementById('buffer-split-select') as HTMLSelectElement;
            const freqInput = document.querySelector('input[name="saving-freq"]:checked') as HTMLInputElement;

            const goalId = editingGoalId || ('goal_' + Date.now());

            const goalData = {
                id: goalId,
                title: title,
                target_amount: grandTotalPersonal,
                total_rombongan_amount: grandTotalRombongan,
                auto_debit_amount: amountPerFreq,
                frequency: labelUnit,
                trip_type: tripTypeSelect?.value || 'Solo',
                group_members_data: groupMembersData,
                group_members: groupFriends,
                departure_date: (document.getElementById('departure-date') as HTMLInputElement)?.value || '',
                saving_end_date: (document.getElementById('saving-end-date') as HTMLInputElement)?.value || '',
                hotels: getSectionRowData('hotel-list'),
                transports: getSectionRowData('transport-list'),
                activities: getSectionRowData('activity-list'),
                others: getSectionRowData('other-list'),
                buffer_amount: bufferInput?.value || '',
                buffer_split: bufferSplitSelect?.value || 'split',
                saving_freq: freqInput?.value || '1',
                saving_type: 'Konvensional',
                payment_method: 'QRIS',
                status: isDraft ? 'draft' : 'active',
                created_at: new Date().toISOString()
            };

            // Save to LocalStorage array (Replace existing goal if editing, or unshift if new)
            let existingGoals = JSON.parse(localStorage.getItem('dreamjourney_custom_goals') || '[]');
            const existingIndex = existingGoals.findIndex((g: any) => g.id === goalId);
            if (existingIndex >= 0) {
                existingGoals[existingIndex] = goalData;
            } else {
                existingGoals.unshift(goalData);
            }
            localStorage.setItem('dreamjourney_custom_goals', JSON.stringify(existingGoals));

            // Also post to Supabase API if possible
            try {
                await fetch('/api/goals', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(goalData)
                });
            } catch (err) {
                console.log('Supabase API post fallback:', err);
            }

            if (isDraft) {
                // USER CHOSE SIMPAN SEBAGAI DRAF:
                // Alert Toast notification and redirect directly to /planner! NO Step 2 / QRIS.
                alert(`✨ Rencana Perjalanan "${title}" berhasil disimpan sebagai Draf!\n\nAnda dapat melihat dan mengeditnya kembali kapan saja di halaman Rencana Perjalanan.`);
                window.location.href = '/planner';
            } else {
                // USER CHOSE LANGSUNG MULAI NABUNG:
                // Move UI to Step 2: Bayar QRIS!
                viewStep1?.classList.add('hidden');
                viewStep2?.classList.remove('hidden');

                // Update Stepper
                if (stepBadge1) stepBadge1.className = 'w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-extrabold text-xs shadow-md';
                if (stepBadge2) stepBadge2.className = 'w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-extrabold text-xs shadow-md shadow-indigo-500/20';

                // Display First Setoran Amount
                const qrisAmountDisplay = document.getElementById('qris-amount-display');
                if (qrisAmountDisplay) qrisAmountDisplay.innerText = `Rp ${amountPerFreq.toLocaleString('id-ID')}`;
            }
        });

        // STEP 2 QRIS CONFIRMATION -> STEP 3 SELESAI
        const btnConfirmQris = document.getElementById('btn-confirm-qris');
        btnConfirmQris?.addEventListener('click', () => {
            viewStep2?.classList.add('hidden');
            viewStep3?.classList.remove('hidden');

            // Update Stepper to Step 3 Active
            if (stepBadge2) stepBadge2.className = 'w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-extrabold text-xs shadow-md';
            if (stepBadge3) stepBadge3.className = 'w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center font-extrabold text-xs shadow-md shadow-indigo-500/20';

            // Set final summary values
            const finalDestName = document.getElementById('final-dest-name');
            const finalTargetAmount = document.getElementById('final-target-amount');

            const { grandTotalPersonal } = calculateBreakdown();
            if (finalDestName) finalDestName.innerText = destInput?.value.trim() || 'Bali';
            if (finalTargetAmount) finalTargetAmount.innerText = `Rp ${grandTotalPersonal.toLocaleString('id-ID')}`;
        });

        // Load Draft / Goal Data from URL Param (?id=... or ?edit=...)
        const urlParams = new URLSearchParams(window.location.search);
        const targetId = urlParams.get('id') || urlParams.get('edit') || urlParams.get('draftId');

        if (targetId) {
            const savedGoals = JSON.parse(localStorage.getItem('dreamjourney_custom_goals') || '[]');
            let targetGoal = savedGoals.find((g: any) => g.id === targetId);

            if (!targetGoal && savedGoals.length > 0) {
                targetGoal = savedGoals.find((g: any) => g.title && g.title.toLowerCase() === targetId.toLowerCase());
            }

            if (targetGoal) {
                editingGoalId = targetGoal.id;

                if (destInput && targetGoal.title) {
                    destInput.value = targetGoal.title;
                }

                if (tripTypeSelect && targetGoal.trip_type) {
                    tripTypeSelect.value = targetGoal.trip_type;
                    if (targetGoal.trip_type !== 'Solo') {
                        containerGroup?.classList.remove('hidden');
                    } else {
                        containerGroup?.classList.add('hidden');
                    }
                }

                if (Array.isArray(targetGoal.group_members_data) && targetGoal.group_members_data.length > 0) {
                    groupMembersData = targetGoal.group_members_data;
                    groupFriends = targetGoal.group_members || groupMembersData.map(m => m.username);
                    renderFriends();
                } else if (Array.isArray(targetGoal.group_members) && targetGoal.group_members.length > 0) {
                    groupMembersData = targetGoal.group_members.map((uname: string) => ({
                        username: uname,
                        fullName: uname,
                        avatarUrl: null
                    }));
                    groupFriends = targetGoal.group_members;
                    renderFriends();
                }

                const depDateInput = document.getElementById('departure-date') as HTMLInputElement;
                const endDateInput = document.getElementById('saving-end-date') as HTMLInputElement;
                if (depDateInput && targetGoal.departure_date) depDateInput.value = targetGoal.departure_date;
                if (endDateInput && targetGoal.saving_end_date) endDateInput.value = targetGoal.saving_end_date;

                const hasSavedRows = (targetGoal.hotels && targetGoal.hotels.length > 0 && targetGoal.hotels.some((h: any) => h.cost)) ||
                                     (targetGoal.transports && targetGoal.transports.length > 0 && targetGoal.transports.some((t: any) => t.cost)) ||
                                     (targetGoal.activities && targetGoal.activities.length > 0 && targetGoal.activities.some((a: any) => a.cost)) ||
                                     (targetGoal.others && targetGoal.others.length > 0 && targetGoal.others.some((o: any) => o.cost));

                if (hasSavedRows) {
                    if (targetGoal.hotels) setSectionRowData('hotel-list', targetGoal.hotels, 'Nama Hotel / Link Airbnb', true);
                    if (targetGoal.transports) setSectionRowData('transport-list', targetGoal.transports, 'Tiket Pesawat / Kereta / Sewa Mobil', false);
                    if (targetGoal.activities) setSectionRowData('activity-list', targetGoal.activities, 'Tiket Wahana / Tour / Aktivitas', true);
                    if (targetGoal.others) setSectionRowData('other-list', targetGoal.others, 'Visa / Asuransi / Belanja Oleh-oleh', true);
                } else if (targetGoal.total_rombongan_amount > 0 || targetGoal.target_amount > 0) {
                    // Fallback for older draft objects: populate target_amount into hotel-list
                    const fallbackCost = targetGoal.total_rombongan_amount || targetGoal.target_amount || 0;
                    setSectionRowData('hotel-list', [{ name: `Estimasi Biaya Trip ${targetGoal.title || ''}`, cost: fallbackCost, split: 'split' }], 'Nama Hotel / Link Airbnb', true);
                }

                const bufferInput = document.getElementById('buffer-input') as HTMLInputElement;
                const bufferSplitSelect = document.getElementById('buffer-split-select') as HTMLSelectElement;
                if (bufferInput && targetGoal.buffer_amount) bufferInput.value = targetGoal.buffer_amount;
                if (bufferSplitSelect && targetGoal.buffer_split) bufferSplitSelect.value = targetGoal.buffer_split;

                // Frequency Radio Selection
                let freqVal = targetGoal.saving_freq;
                if (!freqVal && targetGoal.frequency) {
                    if (targetGoal.frequency.includes('bulan') || targetGoal.frequency.includes('month')) freqVal = '30';
                    else if (targetGoal.frequency.includes('minggu') || targetGoal.frequency.includes('week')) freqVal = '7';
                    else if (targetGoal.frequency.includes('hari') || targetGoal.frequency.includes('day')) freqVal = '1';
                }
                if (freqVal) {
                    const freqRadio = document.querySelector(`input[name="saving-freq"][value="${freqVal}"]`) as HTMLInputElement;
                    if (freqRadio) freqRadio.checked = true;
                }

                if (targetGoal.status === 'draft' && modeDraft) {
                    modeDraft.checked = true;
                } else if (modeActive) {
                    modeActive.checked = true;
                }
                updateSubmitButtonLabel();

                calculateBreakdown();
            }
        }
    });
</script>
