        // Format Inputs with Thousand Separator
        function bindCostInputs() {
            document.querySelectorAll('.cost-input').forEach(input => {
                input.removeEventListener('input', handleCostInput);
                input.addEventListener('input', handleCostInput);
            });
        }

        function handleCostInput(e: Event) {
            const input = e.target as HTMLInputElement;
            const rawDigits = input.value.replace(/[^0-9]/g, '');
            if (rawDigits) {
                input.value = parseInt(rawDigits, 10).toLocaleString('id-ID');
            } else {
                input.value = '';
            }
            calculateBreakdown();
        }

        bindCostInputs();

        // Calculate Totals & Breakdown (Rombongan vs Personal Per Item)
        function calculateSectionTotals(listId: string) {
            const list = document.getElementById(listId);
            if (!list) return { rombongan: 0, personal: 0 };

            const groupSize = Math.max(1, 1 + groupMembersData.length);
            let rombongan = 0;
            let personal = 0;

            list.querySelectorAll('.expense-row').forEach((row) => {
                const costInp = row.querySelector('.cost-input') as HTMLInputElement;
                const splitSelect = row.querySelector('.split-select') as HTMLSelectElement;

                if (costInp) {
                    const rawVal = parseInt(costInp.value.replace(/[^0-9]/g, '') || '0', 10);
                    if (rawVal > 0) {
                        const isPatungan = splitSelect ? splitSelect.value === 'split' : true;
                        if (isPatungan) {
                            // Opsi Patungan: Angka input adalah Total Biaya Rombongan
                            rombongan += rawVal;
                            personal += Math.ceil(rawVal / groupSize);
                        } else {
                            // Opsi Per Orang: Angka input adalah Biaya Per Orang
                            personal += rawVal;
                            rombongan += rawVal * groupSize;
                        }
                    }
                }
            });

            return { rombongan, personal };
        }

        function calculateBreakdown() {
            const groupSize = Math.max(1, 1 + groupMembersData.length);

            const hotel = calculateSectionTotals('hotel-list');
            const transport = calculateSectionTotals('transport-list');
            const activity = calculateSectionTotals('activity-list');
            const other = calculateSectionTotals('other-list');

            const bufferInput = document.getElementById('buffer-input') as HTMLInputElement;
            const bufferSplitSelect = document.getElementById('buffer-split-select') as HTMLSelectElement;
            const rawBuffer = parseInt(bufferInput?.value.replace(/[^0-9]/g, '') || '0', 10);

            let bufferRombongan = 0;
            let bufferPersonal = 0;

            if (rawBuffer > 0) {
                const isBufferPatungan = bufferSplitSelect ? bufferSplitSelect.value === 'split' : true;
                if (isBufferPatungan) {
                    // Patungan: rawBuffer adalah total buffer rombongan
                    bufferRombongan = rawBuffer;
                    bufferPersonal = Math.ceil(rawBuffer / groupSize);
                } else {
                    // Per Orang: rawBuffer adalah buffer per individu
                    bufferPersonal = rawBuffer;
                    bufferRombongan = rawBuffer * groupSize;
                }
            }

            const grandTotalRombongan = hotel.rombongan + transport.rombongan + activity.rombongan + other.rombongan + bufferRombongan;
            const grandTotalPersonal = hotel.personal + transport.personal + activity.personal + other.personal + bufferPersonal;

            // Destination Title
            const destVal = destInput?.value.trim() || 'Bali, Indonesia';
            if (summaryDestTitle) summaryDestTitle.innerText = destVal;

            const summaryPersonalTarget = document.getElementById('summary-personal-target');
            const summaryGroupSizeLabel = document.getElementById('summary-group-size-label');

            if (summaryTotalTarget) summaryTotalTarget.innerText = `Rp ${grandTotalRombongan.toLocaleString('id-ID')}`;
            if (summaryPersonalTarget) summaryPersonalTarget.innerText = `Rp ${grandTotalPersonal.toLocaleString('id-ID')}`;
            if (summaryGroupSizeLabel) summaryGroupSizeLabel.innerText = `Porsi Anda (${groupSize} Orang di Rencana)`;

            if (summaryHotelTotal) summaryHotelTotal.innerText = `Rp ${hotel.personal.toLocaleString('id-ID')}`;
            if (summaryTransportTotal) summaryTransportTotal.innerText = `Rp ${transport.personal.toLocaleString('id-ID')}`;
            if (summaryActivityTotal) summaryActivityTotal.innerText = `Rp ${activity.personal.toLocaleString('id-ID')}`;
            if (summaryOtherTotal) summaryOtherTotal.innerText = `Rp ${other.personal.toLocaleString('id-ID')}`;
            if (summaryBufferTotal) summaryBufferTotal.innerText = `Rp ${bufferPersonal.toLocaleString('id-ID')}`;

            // Calculate Installment Rate based on Target Selesai Menabung date
            const freqInput = document.querySelector('input[name="saving-freq"]:checked') as HTMLInputElement;
            const freqVal = parseInt(freqInput?.value || '1', 10);

            const depDateInput = document.getElementById('departure-date') as HTMLInputElement;
            const endDateInput = document.getElementById('saving-end-date') as HTMLInputElement;

            const now = new Date();
            now.setHours(0, 0, 0, 0);

            let targetDate: Date | null = null;

            if (endDateInput && endDateInput.value) {
                targetDate = new Date(endDateInput.value);
            } else if (depDateInput && depDateInput.value) {
                targetDate = new Date(depDateInput.value);
            }

            // Hitung jumlah hari dari hari ini menuju tanggal selesai menabung
            let remainingDays = 180; // default 6 bulan jika tanggal belum diisi
            if (targetDate && !isNaN(targetDate.getTime())) {
                targetDate.setHours(0, 0, 0, 0);
                const diffMs = targetDate.getTime() - now.getTime();
                const calculatedDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
                remainingDays = Math.max(1, calculatedDays);
            }

            let amountPerFreq = grandTotalPersonal;
            let labelUnit = '/hari';

            if (freqVal === 1) {
                // Harian: Target Tabungan Anda ÷ Jumlah Hari Tersisa
                amountPerFreq = Math.ceil(grandTotalPersonal / remainingDays);
                labelUnit = '/hari';
            } else if (freqVal === 7) {
                // Mingguan: Target Tabungan Anda ÷ Jumlah Minggu Tersisa
                const remainingWeeks = Math.max(1, Math.ceil(remainingDays / 7));
                amountPerFreq = Math.ceil(grandTotalPersonal / remainingWeeks);
                labelUnit = '/minggu';
            } else if (freqVal === 30) {
                // Bulanan: Target Tabungan Anda ÷ Jumlah Bulan Tersisa
                const remainingMonths = Math.max(1, Math.ceil(remainingDays / 30));
                amountPerFreq = Math.ceil(grandTotalPersonal / remainingMonths);
                labelUnit = '/bulan';
            }

            if (summarySavingRate) {
                summarySavingRate.innerText = `Rp ${amountPerFreq.toLocaleString('id-ID')} ${labelUnit}`;
            }

            return { grandTotalRombongan, grandTotalPersonal, amountPerFreq, labelUnit };
        }

        // Destination & Date Input Listeners
        destInput?.addEventListener('input', calculateBreakdown);

        const depDateEl = document.getElementById('departure-date');
        const endDateEl = document.getElementById('saving-end-date');
        const bufferEl = document.getElementById('buffer-input');
        const bufferSplitSelectEl = document.getElementById('buffer-split-select');

        depDateEl?.addEventListener('change', calculateBreakdown);
        endDateEl?.addEventListener('change', calculateBreakdown);
        depDateEl?.addEventListener('input', calculateBreakdown);
        endDateEl?.addEventListener('input', calculateBreakdown);
        bufferEl?.addEventListener('input', calculateBreakdown);
        bufferSplitSelectEl?.addEventListener('change', calculateBreakdown);

        // Frequency Change Listener
        document.querySelectorAll('input[name="saving-freq"]').forEach(radio => {
            radio.addEventListener('change', calculateBreakdown);
        });

        let editingGoalId: string | null = null;

        function getSectionRowData(listId: string) {
            const list = document.getElementById(listId);
            if (!list) return [];
            const rows: { name: string; cost: string; split: string }[] = [];
            list.querySelectorAll('.expense-row').forEach(row => {
                const nameInp = row.querySelector('input[type="text"]:not(.cost-input)') as HTMLInputElement;
                const costInp = row.querySelector('.cost-input') as HTMLInputElement;
                const splitSel = row.querySelector('.split-select') as HTMLSelectElement;
                if (nameInp || costInp) {
                    rows.push({
                        name: nameInp?.value || '',
