        // Change Event Listener for Split Select Dropdowns
        function bindSplitSelects() {
            document.querySelectorAll('.split-select').forEach(sel => {
                sel.removeEventListener('change', calculateBreakdown);
                sel.addEventListener('change', calculateBreakdown);
            });
        }

        bindSplitSelects();

        // Remove row delegated event listener
        document.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest('.btn-remove-row');
            if (btn) {
                const row = btn.closest('.expense-row');
