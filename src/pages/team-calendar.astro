                <button id="confirm-modal-cancel-btn" class="px-5 py-2.5 bg-slate-300 hover:bg-slate-400/80 text-slate-700 font-bold text-xs rounded-xl transition cursor-pointer">
                    Cancel
                </button>
                <button id="confirm-modal-btn" class="px-5 py-2.5 bg-rose-500 hover:bg-rose-600 text-white font-bold text-xs rounded-xl shadow-xs transition cursor-pointer">
                    Yes, delete it!
                </button>
