<script is:inline define:vars={{ currentUsername, currentUserFullName, currentUserAvatar, isVerified }}>
    document.addEventListener("DOMContentLoaded", function () {
        const currentUser = {
            username: currentUsername,
            fullName: currentUserFullName,
            avatarUrl: currentUserAvatar,
            isOwner: true
        };

        if (window.Clerk && window.Clerk.user) {
            currentUser.fullName = window.Clerk.user.fullName || window.Clerk.user.firstName || currentUser.fullName;
            if (window.Clerk.user.imageUrl) {
                currentUser.avatarUrl = window.Clerk.user.imageUrl;
            }
            if (window.Clerk.user.username) {
                currentUser.username = window.Clerk.user.username.toLowerCase();
            }
        }

        const cachedAvatar = localStorage.getItem('dream_user_avatar_' + currentUser.username.toLowerCase());
        if (cachedAvatar) {
            currentUser.avatarUrl = cachedAvatar;
        }

        // Dynamic Avatar Generator per User
        function getAvatarUrl(m) {
            if (m && m.avatarUrl && !m.avatarUrl.includes('unsplash.com/photo-1534528741775')) {
                return m.avatarUrl;
            }
            const name = m?.fullName || m?.username || 'User';
            return `https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=random&color=fff&bold=true`;
        }

        const ownerDisplayEl = document.getElementById('event-owner-display');
        if (ownerDisplayEl) {
            ownerDisplayEl.textContent = `Jadwal ini untuk akun Anda (${currentUser.fullName} - @${currentUser.username})`;
        }

        // Custom Centered Confirmation Modal Helper
        function customConfirm({ title = "Confirmation", message = "Are you sure you want to delete this?", confirmText = "Yes, delete it!" } = {}) {
            return new Promise((resolve) => {
                const modal = document.getElementById('custom-confirm-modal');
                const titleEl = document.getElementById('confirm-modal-title');
                const msgEl = document.getElementById('confirm-modal-message');
                const confirmBtn = document.getElementById('confirm-modal-btn');
                const cancelBtn = document.getElementById('confirm-modal-cancel-btn');
                const closeBtn = document.getElementById('confirm-modal-close-btn');

                if (!modal || !titleEl || !msgEl || !confirmBtn || !cancelBtn) {
                    resolve(confirm(message));
                    return;
                }

                titleEl.textContent = title;
                msgEl.textContent = message;
                confirmBtn.textContent = confirmText;

                modal.classList.remove('hidden');
                if (window.feather) window.feather.replace();

                function cleanup(result) {
                    modal.classList.add('hidden');
                    confirmBtn.removeEventListener('click', onConfirm);
                    cancelBtn.removeEventListener('click', onCancel);
                    closeBtn?.removeEventListener('click', onCancel);
                    resolve(result);
                }

                function onConfirm() {
                    cleanup(true);
                }

                function onCancel() {
                    cleanup(false);
                }

                confirmBtn.addEventListener('click', onConfirm, { once: true });
                cancelBtn.addEventListener('click', onCancel, { once: true });
                if (closeBtn) closeBtn.addEventListener('click', onCancel, { once: true });
            });
        }

        // Multi-Team State
        let teams = [];
        let allEvents = [];
        let notifications = [];
        let activeTeamId = null;
        let currentDate = new Date();
        let selectedDateStr = formatDateKey(new Date());

        let tempCreateMembers = [];

        const memberColors = [
            { bg: 'bg-blue-500', text: 'text-blue-600', badge: 'bg-blue-50 text-blue-700 border-blue-100' },
            { bg: 'bg-purple-500', text: 'text-purple-600', badge: 'bg-purple-50 text-purple-700 border-purple-100' },
            { bg: 'bg-emerald-500', text: 'text-emerald-600', badge: 'bg-emerald-50 text-emerald-700 border-emerald-100' },
            { bg: 'bg-amber-500', text: 'text-amber-600', badge: 'bg-amber-50 text-amber-700 border-amber-100' },
            { bg: 'bg-rose-500', text: 'text-rose-600', badge: 'bg-rose-50 text-rose-700 border-rose-100' },
        ];

        function getMemberColor(username) {
            const idx = Math.abs(hashCode(username || 'user')) % memberColors.length;
            return memberColors[idx];
        }

        function hashCode(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                hash = str.charCodeAt(i) + ((hash << 5) - hash);
            }
            return hash;
        }

        function formatDateKey(dateObj) {
            const year = dateObj.getFullYear();
            const month = String(dateObj.getMonth() + 1).padStart(2, '0');
            const day = String(dateObj.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // Init & Data Loading
        async function initData() {
            const localTeams = localStorage.getItem('dream_multi_teams');
            if (localTeams) {
                try { 
                    teams = JSON.parse(localTeams);
                    teams = teams.filter(t => t.id !== 'team_default_1');
                } catch (e) {}
            }
            const localEvents = localStorage.getItem('dream_multi_team_events');
            if (localEvents) {
                try { allEvents = JSON.parse(localEvents); } catch (e) {}
            }
            
            loadNotificationsCache();

            // Sync from API
            try {
                const res = await fetch(`/api/team-calendar?username=${encodeURIComponent(currentUser.username)}`);
                if (res.ok) {
                    const data = await res.json();
                    if (data.teams && data.teams.length > 0) {
                        const mergedMap = new Map();
                        [...teams, ...data.teams.filter(t => t.id !== 'team_default_1')].forEach(t => mergedMap.set(t.id, t));
                        teams = Array.from(mergedMap.values());
                        saveLocalTeams();
                    }
                    if (data.events && data.events.length > 0) {
                        const mergedEvtMap = new Map();
                        [...allEvents, ...data.events].forEach(e => mergedEvtMap.set(e.id, e));
                        allEvents = Array.from(mergedEvtMap.values());
                        saveLocalEvents();
                    }
                    if (data.notifications && data.notifications.length > 0) {
                        const mergedNotifMap = new Map();
                        data.notifications.forEach(n => mergedNotifMap.set(n.id, n));
                        notifications.forEach(n => {
                            const existing = mergedNotifMap.get(n.id);
                            if (!existing || n.status === 'READ' || n.status === 'ACCEPTED' || n.status === 'REJECTED') {
                                mergedNotifMap.set(n.id, n);
                            }
                        });
                        notifications = Array.from(mergedNotifMap.values());
                        saveLocalNotifs();
                    }
                }
            } catch (err) {
                console.warn("Server sync notice:", err);
            }

            renderTeamsOverview();
            renderNotifications();
        }

        function loadNotificationsCache() {
            notifications = [];
            const localNotifs = localStorage.getItem('dream_team_notifications');
            if (localNotifs) {
                try { notifications = JSON.parse(localNotifs); } catch (e) {}
            }
            const globalNotifsStr = localStorage.getItem('dream_global_team_notifications');
            if (globalNotifsStr) {
                try {
                    const globalNotifs = JSON.parse(globalNotifsStr);
                    const myGlobalNotifs = globalNotifs.filter(n => n.recipient_username.toLowerCase() === currentUser.username.toLowerCase());
                    const mergedMap = new Map();
                    myGlobalNotifs.forEach(n => mergedMap.set(n.id, n));
                    notifications.forEach(n => {
                        const existing = mergedMap.get(n.id);
                        if (!existing || n.status === 'READ' || n.status === 'ACCEPTED' || n.status === 'REJECTED') {
                            mergedMap.set(n.id, n);
                        }
                    });
                    notifications = Array.from(mergedMap.values());
                } catch (e) {}
            }
        }

        function pushGlobalNotification(notifObj) {
            let globalNotifs = [];
            const str = localStorage.getItem('dream_global_team_notifications');
            if (str) {
                try { globalNotifs = JSON.parse(str); } catch (e) {}
            }
            globalNotifs.unshift(notifObj);
            localStorage.setItem('dream_global_team_notifications', JSON.stringify(globalNotifs));
        }

        function saveLocalTeams() {
            localStorage.setItem('dream_multi_teams', JSON.stringify(teams));
        }

        function saveLocalEvents() {
            localStorage.setItem('dream_multi_team_events', JSON.stringify(allEvents));
        }

        function saveLocalNotifs() {
            localStorage.setItem('dream_team_notifications', JSON.stringify(notifications));

            // Sync with dream_global_team_notifications so refresh never restores old unread status
            const globalStr = localStorage.getItem('dream_global_team_notifications');
            if (globalStr) {
                try {
                    const globalNotifs = JSON.parse(globalStr);
                    globalNotifs.forEach(gn => {
                        if (gn.recipient_username.toLowerCase() === currentUser.username.toLowerCase()) {
                            const localMatch = notifications.find(n => n.id === gn.id);
                            if (localMatch) {
                                gn.status = localMatch.status;
                            }
                        }
                    });
                    localStorage.setItem('dream_global_team_notifications', JSON.stringify(globalNotifs));
                } catch (e) {}
            }
        }

        // Leave Team Logic
        async function leaveTeam(teamId) {
            const targetTeam = teams.find(t => t.id === teamId);
            if (!targetTeam) return;

            const isConfirmed = await customConfirm({
                title: "Konfirmasi Keluar Tim",
                message: `Apakah Anda yakin ingin keluar dari tim "${targetTeam.name}"?`,
                confirmText: "Ya, Keluar Tim"
            });

            if (isConfirmed) {
                targetTeam.members = (targetTeam.members || []).filter(m => m.username.toLowerCase() !== currentUser.username.toLowerCase());
                saveLocalTeams();

                const notifObj = {
                    id: 'notif_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                    recipient_username: targetTeam.owner_username.toLowerCase(),
                    sender_username: currentUser.username.toLowerCase(),
                    type: 'REMOVED_FROM_TEAM',
                    team_name: targetTeam.name,
                    title: `Anggota Keluar Tim: ${targetTeam.name}`,
                    message: `@${currentUser.username} telah keluar dari tim "${targetTeam.name}".`,
                    status: 'UNREAD',
                    created_at: new Date().toISOString()
                };
                pushGlobalNotification(notifObj);

                try {
                    await fetch('/api/team-calendar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'UPDATE_MEMBERS', teamId: teamId, members: targetTeam.members })
                    });
                } catch (err) {}

                renderTeamsOverview();
            }
        }

        // RENDER INBOX NOTIFICATIONS
        function renderNotifications() {
            const container = document.getElementById('inbox-items-container');
            const countBadge = document.getElementById('inbox-badge-count');
            if (!container || !countBadge) return;

            const unreadNotifs = notifications.filter(n => n.recipient_username.toLowerCase() === currentUser.username.toLowerCase() && n.status === 'UNREAD');
            if (unreadNotifs.length > 0) {
                countBadge.textContent = unreadNotifs.length;
                countBadge.classList.remove('hidden');
            } else {
                countBadge.classList.add('hidden');
            }

            container.innerHTML = '';
            const myNotifs = notifications.filter(n => n.recipient_username.toLowerCase() === currentUser.username.toLowerCase());

            if (myNotifs.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-6 text-slate-400">
                        <i data-feather="bell-off" class="w-8 h-8 mx-auto mb-2 opacity-50"></i>
                        <p class="text-xs font-semibold">Belum Ada Notifikasi</p>
                        <p class="text-[10px] mt-0.5">Semua info tim dan undangan akan muncul di sini.</p>
                    </div>
                `;
                if (window.feather) window.feather.replace();
                return;
            }

            myNotifs.forEach(notif => {
                const itemEl = document.createElement('div');
                itemEl.className = `p-3 rounded-2xl border text-xs transition ${notif.status === 'PENDING' ? 'bg-blue-50/90 border-blue-200' : 'bg-slate-50/60 border-slate-100'}`;
                
                let actionsHtml = '';
                if (notif.type === 'TEAM_INVITE' && notif.status === 'PENDING') {
                    actionsHtml = `
                        <div class="flex items-center gap-2 mt-2 pt-2 border-t border-blue-100">
                            <button class="btn-process-invite px-3.5 py-1.5 bg-primary hover:bg-primary-dark text-white font-bold text-[11px] rounded-xl transition cursor-pointer shadow-xs" data-id="${notif.id}" data-team-id="${notif.team_id}" data-accept="true">
                                Setuju & Gabung
                            </button>
                            <button class="btn-process-invite px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 font-semibold text-[11px] rounded-xl transition cursor-pointer" data-id="${notif.id}" data-team-id="${notif.team_id}" data-accept="false">
                                Tolak
                            </button>
                        </div>
                    `;
                } else if (notif.status === 'ACCEPTED') {
                    actionsHtml = `<span class="inline-block text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-lg mt-1.5 border border-emerald-100">✓ Sudah Bergabung</span>`;
                } else if (notif.status === 'REJECTED') {
                    actionsHtml = `<span class="inline-block text-[10px] font-bold text-slate-400 bg-slate-100 px-2.5 py-1 rounded-lg mt-1.5">Undangan Ditolak</span>`;
                }

                itemEl.innerHTML = `
                    <div class="flex items-start justify-between gap-2">
                        <h4 class="font-bold text-slate-900 text-xs">${notif.title || 'Notifikasi Tim'}</h4>
                        <span class="text-[9px] text-slate-400 font-medium">${notif.created_at ? new Date(notif.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) : 'Baru'}</span>
                    </div>
                    <p class="text-[11px] text-slate-600 mt-0.5 leading-relaxed">${notif.message}</p>
                    ${actionsHtml}
                `;

                container.appendChild(itemEl);
            });

            container.querySelectorAll('.btn-process-invite').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const notifId = e.currentTarget.getAttribute('data-id');
                    const teamId = e.currentTarget.getAttribute('data-team-id');
                    const isAccept = e.currentTarget.getAttribute('data-accept') === 'true';

                    const notif = notifications.find(n => n.id === notifId);
                    if (notif) {
                        notif.status = isAccept ? 'ACCEPTED' : 'REJECTED';
                        saveLocalNotifs();
                        renderNotifications();

                        if (isAccept) {
                            try {
                                const res = await fetch(`/api/team-calendar?teamId=${teamId}`);
                                const data = await res.json();
                                let targetTeam = data.teams?.find(t => t.id === teamId);
                                
                                if (!targetTeam) {
                                    targetTeam = teams.find(t => t.id === teamId);
                                }

                                if (targetTeam) {
                                    const members = targetTeam.members || [];
                                    if (!members.some(m => m.username.toLowerCase() === currentUser.username.toLowerCase())) {
                                        members.push(currentUser);
                                        targetTeam.members = members;
                                    }
                                    if (!teams.some(t => t.id === targetTeam.id)) {
                                        teams.push(targetTeam);
                                    }
                                    saveLocalTeams();
                                    renderTeamsOverview();
                                }
                            } catch (err) {}
                        }

                        try {
                            await fetch('/api/team-calendar', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    action: 'PROCESS_TEAM_INVITATION',
                                    notifId,
                                    teamId,
                                    accept: isAccept,
                                    username: currentUser.username,
                                    userObj: currentUser
                                })
                            });
                        } catch (err) {}
                    }
                });
            });

            if (window.feather) window.feather.replace();
        }

        // Toggle Inbox Panel
        const inboxToggleBtn = document.getElementById('inbox-toggle-btn');
        const inboxDropdown = document.getElementById('inbox-dropdown-panel');
        const markAllReadBtn = document.getElementById('mark-all-read-btn');

        if (inboxToggleBtn && inboxDropdown) {
            inboxToggleBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                inboxDropdown.classList.toggle('hidden');
            });
            document.addEventListener('click', (e) => {
                if (!inboxDropdown.contains(e.target) && !inboxToggleBtn.contains(e.target)) {
                    inboxDropdown.classList.add('hidden');
                }
            });
        }

        if (markAllReadBtn) {
            markAllReadBtn.addEventListener('click', async () => {
                notifications.forEach(n => {
                    if (n.recipient_username.toLowerCase() === currentUser.username.toLowerCase()) {
                        if (n.status === 'UNREAD' || n.status === 'PENDING') {
                            n.status = 'READ';
                        }
                    }
                });
                saveLocalNotifs();
                renderNotifications();

                try {
                    await fetch('/api/team-calendar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'MARK_NOTIF_READ', username: currentUser.username })
                    });
                } catch (err) {}
            });
        }

        // RENDER VIEW 1: DAFTAR TIM SAYA
        function renderTeamsOverview() {
            const overviewView = document.getElementById('teams-overview-view');
            const detailView = document.getElementById('team-calendar-detail-view');
            const gridContainer = document.getElementById('teams-grid-container');
            const badgeCount = document.getElementById('teams-count-badge');

            if (!overviewView || !detailView || !gridContainer || !badgeCount) return;

            overviewView.classList.remove('hidden');
            detailView.classList.add('hidden');
            activeTeamId = null;

            const myTeams = teams.filter(t => {
                const isOwner = (t.owner_username || '').toLowerCase() === currentUser.username.toLowerCase();
                const isMember = (t.members || []).some(m => (m.username || '').toLowerCase() === currentUser.username.toLowerCase());
                return isOwner || isMember;
            });

            badgeCount.textContent = `${myTeams.length} Tim`;
            gridContainer.innerHTML = '';

            if (myTeams.length === 0) {
                gridContainer.innerHTML = `
                    <div class="col-span-full text-center py-16 px-6 bg-white rounded-3xl border border-dashed border-slate-200/90 shadow-2xs my-4 max-w-lg mx-auto">
                        <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i data-feather="users" class="w-8 h-8"></i>
                        </div>
                        <h3 class="text-xl font-extrabold text-slate-900 mb-1.5">Belum Ada Tim</h3>
                        <p class="text-xs md:text-sm text-slate-500 font-medium leading-relaxed mb-6">
                            Anda belum memiliki tim liburan. Buat tim pertama Anda (seperti Keluarga, Teman Kerja, atau Komunitas) atau tunggu undangan dari teman.
                        </p>
                        <button id="btn-create-first-team" class="inline-flex items-center gap-2 px-6 py-3 bg-primary hover:bg-primary-dark text-white font-bold text-xs rounded-xl shadow-sm hover:shadow transition cursor-pointer">
                            <i data-feather="plus" class="w-4 h-4"></i>
                            <span>Buat Tim Baru</span>
                        </button>
                    </div>
                `;
                document.getElementById('btn-create-first-team')?.addEventListener('click', openCreateTeamModal);
                if (window.feather) window.feather.replace();
                return;
            }

            myTeams.forEach(team => {
                const members = team.members || [currentUser];
                const teamEvents = allEvents.filter(e => e.team_id === team.id);
                const isOwner = team.owner_username.toLowerCase() === currentUser.username.toLowerCase();
                
                const categoryIconMap = {
                    'Keluarga': 'heart',
                    'Teman': 'smile',
                    'Pekerjaan': 'briefcase',
                    'Komunitas': 'compass',
                    'Lainnya': 'users'
                };
                const iconName = categoryIconMap[team.category] || 'users';

                const cardEl = document.createElement('div');
                cardEl.className = "bg-white rounded-3xl p-6 shadow-sm border border-slate-200/80 hover:shadow-md hover:border-blue-200 transition-all flex flex-col justify-between group";

                let avatarsHtml = `<div class="flex items-center -space-x-2 overflow-hidden">`;
                members.slice(0, 4).forEach(m => {
                    const avatar = getAvatarUrl(m);
                    avatarsHtml += `<img src="${avatar}" title="${m.fullName || m.username}" class="w-8 h-8 rounded-xl object-cover ring-2 ring-white" />`;
                });
                if (members.length > 4) {
                    avatarsHtml += `<span class="w-8 h-8 rounded-xl bg-slate-100 text-[10px] font-extrabold text-slate-600 flex items-center justify-center ring-2 ring-white">+${members.length - 4}</span>`;
                }
                avatarsHtml += `</div>`;

                cardEl.innerHTML = `
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="inline-flex items-center gap-1.5 bg-blue-50 text-blue-700 text-xs font-bold px-3 py-1 rounded-full border border-blue-100">
                                <i data-feather="${iconName}" class="w-3.5 h-3.5"></i>
                                ${team.category || 'Keluarga'}
                            </span>
                            <div class="flex items-center gap-1">
                                <span class="text-[11px] font-bold text-slate-400">${teamEvents.length} Jadwal</span>
                                ${isOwner ? `
                                    <button class="btn-delete-team p-1 text-slate-300 hover:text-rose-500 transition cursor-pointer" data-id="${team.id}" title="Hapus Tim">
                                        <i data-feather="trash-2" class="w-4 h-4"></i>
                                    </button>
                                ` : `
                                    <button class="btn-leave-team p-1 text-slate-300 hover:text-rose-500 transition cursor-pointer" data-id="${team.id}" title="Keluar dari Tim Ini">
                                        <i data-feather="log-out" class="w-4 h-4"></i>
                                    </button>
                                `}
                            </div>
                        </div>

                        <h3 class="text-xl font-extrabold text-slate-900 group-hover:text-primary transition-colors mb-2">${team.name}</h3>
                        <p class="text-xs text-slate-500 font-medium mb-5">${members.length} Anggota terdaftar di tim ini</p>
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-3">
                        ${avatarsHtml}
                        <button class="btn-open-team-calendar inline-flex items-center gap-1.5 bg-slate-900 hover:bg-black text-white font-bold px-4 py-2.5 rounded-xl text-xs transition cursor-pointer shadow-xs" data-id="${team.id}">
                            <span>Buka Kalender</span>
                            <i data-feather="arrow-right" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                `;

                gridContainer.appendChild(cardEl);
            });

            gridContainer.querySelectorAll('.btn-open-team-calendar').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const id = e.currentTarget.getAttribute('data-id');
                    if (id) openTeamCalendarView(id);
                });
            });

            gridContainer.querySelectorAll('.btn-delete-team').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const id = e.currentTarget.getAttribute('data-id');
                    const targetTeam = teams.find(t => t.id === id);
                    const teamName = targetTeam ? targetTeam.name : 'tim ini';

                    const isConfirmed = await customConfirm({
                        title: "Confirmation",
                        message: `Are you sure you want to delete team "${teamName}"? This action cannot be undone and will delete all team schedules.`,
                        confirmText: "Yes, delete it!"
                    });

                    if (id && isConfirmed) {
                        teams = teams.filter(t => t.id !== id);
                        allEvents = allEvents.filter(evt => evt.team_id !== id);
                        saveLocalTeams();
                        saveLocalEvents();
                        renderTeamsOverview();

                        try {
                            await fetch('/api/team-calendar', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ action: 'DELETE_TEAM', teamId: id })
                            });
                        } catch (err) {}
                    }
                });
            });

            gridContainer.querySelectorAll('.btn-leave-team').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const id = e.currentTarget.getAttribute('data-id');
                    if (id) leaveTeam(id);
                });
            });

            if (window.feather) window.feather.replace();
        }

        // RENDER VIEW 2: ACTIVE TEAM CALENDAR VIEW
        function openTeamCalendarView(teamId) {
            const overviewView = document.getElementById('teams-overview-view');
            const detailView = document.getElementById('team-calendar-detail-view');
            const teamNameTitle = document.getElementById('active-team-name-title');
            const teamCatBadge = document.getElementById('active-team-category-badge');
            const switchSelect = document.getElementById('switch-team-select');
            const leaveBtn = document.getElementById('active-team-leave-btn');

            if (!overviewView || !detailView) return;

            const activeTeam = teams.find(t => t.id === teamId);
            if (!activeTeam) return;

            activeTeamId = teamId;
            overviewView.classList.add('hidden');
            detailView.classList.remove('hidden');

            if (teamNameTitle) teamNameTitle.textContent = activeTeam.name;
            if (teamCatBadge) teamCatBadge.textContent = activeTeam.category || 'Tim';

            const isOwner = activeTeam.owner_username.toLowerCase() === currentUser.username.toLowerCase();
            if (leaveBtn) {
                if (!isOwner) {
                    leaveBtn.classList.remove('hidden');
                    leaveBtn.onclick = () => leaveTeam(activeTeamId);
                } else {
                    leaveBtn.classList.add('hidden');
                }
            }

            if (switchSelect) {
                switchSelect.innerHTML = '';
                const myTeams = teams.filter(t => {
                    const isOwner = (t.owner_username || '').toLowerCase() === currentUser.username.toLowerCase();
                    const isMember = (t.members || []).some(m => (m.username || '').toLowerCase() === currentUser.username.toLowerCase());
                    return isOwner || isMember;
                });
                myTeams.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.id;
                    opt.textContent = `${t.name} (${t.category})`;
                    if (t.id === activeTeamId) opt.selected = true;
                    switchSelect.appendChild(opt);
                });
            }

            renderActiveTeamMembers();
            renderCalendar();
            renderSelectedDayEvents();
        }

        // Active Team Members Manager
        function renderActiveTeamMembers() {
            const container = document.getElementById('team-members-list');
            const countBadge = document.getElementById('active-team-member-count');
            const activeTeam = teams.find(t => t.id === activeTeamId);
            if (!activeTeam || !container || !countBadge) return;

            const members = activeTeam.members || [currentUser];
            countBadge.textContent = `${members.length} Orang`;

            container.innerHTML = '';

            members.forEach(member => {
                const isOwner = member.username.toLowerCase() === (activeTeam.owner_username || '').toLowerCase();
                const isMe = member.username.toLowerCase() === currentUser.username.toLowerCase();

                const memberEl = document.createElement('div');
                memberEl.className = `flex items-center justify-between p-3 rounded-2xl transition border ${isOwner ? 'bg-blue-50/70 border-blue-100/80' : 'bg-white border-slate-100 hover:bg-slate-50'}`;
                
                memberEl.innerHTML = `
                    <div class="flex items-center gap-3 min-w-0">
                        <img src="${getAvatarUrl(member)}" alt="${member.fullName}" class="w-9 h-9 rounded-xl object-cover ring-2 ring-white flex-shrink-0" />
                        <div class="min-w-0">
                            <h4 class="text-xs font-bold text-slate-900 truncate">${member.fullName} ${isMe ? '(Anda)' : ''}</h4>
                            <p class="text-[10px] font-medium text-slate-500">@${member.username}</p>
                        </div>
                    </div>
                    ${isOwner 
                        ? `<span class="bg-blue-600 text-white text-[9px] font-extrabold px-2 py-0.5 rounded-full uppercase">Pemilik</span>`
                        : (activeTeam.owner_username.toLowerCase() === currentUser.username.toLowerCase() ? `
                            <button class="btn-remove-active-member text-slate-400 hover:text-rose-600 p-1 transition cursor-pointer" data-username="${member.username}" title="Keluarkan Anggota">
                                <i data-feather="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        ` : (isMe ? `
                            <button class="btn-leave-sidebar-team bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold px-2.5 py-1 rounded-xl text-[10px] flex items-center gap-1 transition cursor-pointer" title="Keluar dari Tim Ini">
                                <i data-feather="log-out" class="w-3 h-3"></i>
                                <span>Keluar</span>
                            </button>
                        ` : ''))
                    }
                `;
                container.appendChild(memberEl);
            });

            container.querySelectorAll('.btn-leave-sidebar-team').forEach(btn => {
                btn.addEventListener('click', () => leaveTeam(activeTeamId));
            });

            container.querySelectorAll('.btn-remove-active-member').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const username = e.currentTarget.getAttribute('data-username');
                    if (username) {
                        const isConfirmed = await customConfirm({
                            title: "Confirmation",
                            message: `Are you sure you want to remove @${username} from this team?`,
                            confirmText: "Yes, delete it!"
                        });

                        if (!isConfirmed) return;

                        activeTeam.members = activeTeam.members.filter(m => m.username.toLowerCase() !== username.toLowerCase());
                        saveLocalTeams();
                        renderActiveTeamMembers();
                        renderCalendar();
                        renderSelectedDayEvents();

                        const notifObj = {
                            id: 'notif_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                            recipient_username: username.toLowerCase(),
                            sender_username: currentUser.username.toLowerCase(),
                            type: 'REMOVED_FROM_TEAM',
                            team_name: activeTeam.name,
                            title: `Status Keanggotaan Tim: ${activeTeam.name}`,
                            message: `@${currentUser.username} telah mengeluarkan Anda dari tim "${activeTeam.name}".`,
                            status: 'UNREAD',
                            created_at: new Date().toISOString()
                        };
                        pushGlobalNotification(notifObj);

                        fetch('/api/team-calendar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                action: 'NOTIFY_REMOVED',
                                recipient_username: username,
                                sender_username: currentUser.username,
                                team_name: activeTeam.name
                            })
                        }).catch(() => {});

                        fetch('/api/team-calendar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ action: 'UPDATE_MEMBERS', teamId: activeTeamId, members: activeTeam.members })
                        }).catch(() => {});
                    }
                });
            });

            if (window.feather) window.feather.replace();
        }

        // Invite Member to Active Team
        const searchInput = document.getElementById('search-username-input');
        const addBtn = document.getElementById('add-member-btn');
        const feedback = document.getElementById('username-search-feedback');

        if (addBtn && searchInput && feedback) {
            addBtn.addEventListener('click', async () => {
                const activeTeam = teams.find(t => t.id === activeTeamId);
                if (!activeTeam) return;

                let usernameVal = searchInput.value.trim();
                if (usernameVal.startsWith('@')) usernameVal = usernameVal.substring(1);
                
                if (!usernameVal) {
                    showFeedback("Masukkan @username terlebih dahulu.", "text-rose-500");
                    return;
                }

                if ((activeTeam.members || []).some(m => m.username.toLowerCase() === usernameVal.toLowerCase())) {
                    showFeedback("Username ini sudah ada di tim ini.", "text-amber-600");
                    return;
                }

                addBtn.disabled = true;
                addBtn.innerHTML = `<i data-feather="loader" class="w-3.5 h-3.5 animate-spin"></i><span>Cari...</span>`;
                if (window.feather) window.feather.replace();

                try {
                    const res = await fetch(`/api/check-username?username=${encodeURIComponent(usernameVal)}`);
                    const data = await res.json();

                    if (res.ok && data.user) {
                        const invitedUser = {
                            username: data.user.username,
                            fullName: data.user.fullName || data.user.username,
                            avatarUrl: data.user.avatarUrl,
                            isOwner: false
                        };

                        const notifObj = {
                            id: 'notif_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
                            recipient_username: invitedUser.username.toLowerCase(),
                            sender_username: currentUser.username.toLowerCase(),
                            type: 'TEAM_INVITE',
                            team_id: activeTeamId,
                            team_name: activeTeam.name,
                            team_category: activeTeam.category || 'Lainnya',
                            title: `Undangan Tim: ${activeTeam.name}`,
                            message: `@${currentUser.username} mengundang Anda bergabung ke tim "${activeTeam.name}".`,
                            status: 'PENDING',
                            created_at: new Date().toISOString()
                        };
                        pushGlobalNotification(notifObj);

                        fetch('/api/team-calendar', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                action: 'SEND_INVITE_NOTIF',
                                recipient_username: invitedUser.username,
                                sender_username: currentUser.username,
                                sender_fullname: currentUser.fullName,
                                team_id: activeTeamId,
                                team_name: activeTeam.name,
                                team_category: activeTeam.category
                            })
                        }).catch(() => {});

                        searchInput.value = '';
                        showFeedback(`Undangan telah dikirim ke Inbox @${invitedUser.username}`, "text-emerald-600");
                    } else {
                        showFeedback(`Username @${usernameVal} tidak ditemukan di database.`, "text-rose-500");
                    }
                } catch (err) {
                    showFeedback("Kesalahan koneksi.", "text-rose-500");
                } finally {
                    addBtn.disabled = false;
                    addBtn.innerHTML = `<i data-feather="send" class="w-3.5 h-3.5"></i><span>Undang</span>`;
                    if (window.feather) window.feather.replace();
                }
            });
        }

        function showFeedback(msg, colorClass) {
            if (!feedback) return;
            feedback.textContent = msg;
            feedback.className = `text-[11px] font-semibold mt-1.5 ${colorClass}`;
            feedback.classList.remove('hidden');
            setTimeout(() => feedback.classList.add('hidden'), 4000);
        }

        // Render Calendar Grid for Active Team
        function renderCalendar() {
            const grid = document.getElementById('calendar-days-grid');
            const monthYearTitle = document.getElementById('calendar-month-year');
            if (!grid || !monthYearTitle || !activeTeamId) return;

            const activeTeamEvents = allEvents.filter(e => e.team_id === activeTeamId);

            const year = currentDate.getFullYear();
            const month = currentDate.getMonth();
            const monthNames = ["Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember"];
            monthYearTitle.textContent = `${monthNames[month]} ${year}`;

            const firstDayOfMonth = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();
            const todayStr = formatDateKey(new Date());

            grid.innerHTML = '';

            for (let i = 0; i < firstDayOfMonth; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = "h-20 md:h-24 bg-slate-50/50 rounded-2xl border border-dashed border-slate-100 opacity-40";
                grid.appendChild(emptyCell);
            }

            for (let day = 1; day <= daysInMonth; day++) {
                const dayDate = new Date(year, month, day);
                const dateKey = formatDateKey(dayDate);

                const dayEvents = activeTeamEvents.filter(e => e.event_date === dateKey);
                const isSelected = dateKey === selectedDateStr;
                const isToday = dateKey === todayStr;

                const dayCell = document.createElement('div');
                dayCell.className = `h-16 sm:h-20 md:h-24 p-1 sm:p-2 rounded-xl sm:rounded-2xl border transition-all cursor-pointer flex flex-col justify-between relative group overflow-hidden ${
                    isSelected 
                        ? 'bg-blue-50/80 border-primary ring-2 ring-primary/30 shadow-sm' 
                        : (isToday ? 'bg-amber-50/40 border-amber-200' : 'bg-white border-slate-100 hover:border-slate-300 hover:shadow-xs')
                }`;

                let badgeHtml = '';
                const hasGroupEvt = dayEvents.some(e => e.is_group_event);
                if (dayEvents.length > 0) {
                    if (hasGroupEvt) {
                        badgeHtml = `
                            <span class="hidden md:inline-block bg-purple-600 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded-full shadow-2xs">🤝 Bersama</span>
                            <span class="inline-block md:hidden bg-purple-600 text-white text-[8px] font-extrabold px-1 py-0.5 rounded-md shadow-2xs leading-none" title="Agenda Bersama">🤝</span>
                        `;
                    } else {
                        badgeHtml = `
                            <span class="hidden md:inline-block bg-rose-500 text-white text-[9px] font-extrabold px-1.5 py-0.5 rounded-full shadow-2xs">${dayEvents.length} Busy</span>
                            <span class="inline-block md:hidden bg-rose-500 text-white text-[8px] font-extrabold px-1 py-0.5 rounded-md shadow-2xs leading-none" title="${dayEvents.length} Kesibukan">${dayEvents.length}B</span>
                        `;
                    }
                } else {
                    badgeHtml = `<span class="bg-emerald-50 text-emerald-700 text-[9px] font-bold px-1.5 py-0.5 rounded-full hidden md:inline">Free</span>`;
                }

                let memberAvatarsHtml = '';
                if (dayEvents.length > 0) {
                    const uniqueUsernames = [...new Set(dayEvents.map(e => e.is_group_event ? 'ALL' : (e.member_username || e.owner_username).toLowerCase()))];
                    const activeTeam = teams.find(t => t.id === activeTeamId);
                    const membersList = activeTeam?.members || [currentUser];

                    memberAvatarsHtml = `<div class="flex items-center -space-x-1 sm:-space-x-1.5 overflow-hidden pt-0.5 sm:pt-1">`;
                    if (uniqueUsernames.includes('ALL')) {
                        membersList.slice(0, 3).forEach(m => {
                            memberAvatarsHtml += `<img src="${getAvatarUrl(m)}" title="${m.fullName}" class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-5 md:h-5 rounded-full object-cover ring-1 sm:ring-2 ring-white flex-shrink-0" />`;
                        });
                    } else {
                        uniqueUsernames.slice(0, 3).forEach(uname => {
                            const m = membersList.find(tm => tm.username.toLowerCase() === uname);
                            const avatar = getAvatarUrl(m || { username: uname, fullName: uname });
                            memberAvatarsHtml += `<img src="${avatar}" title="${m?.fullName || uname}" class="w-3.5 h-3.5 sm:w-4 sm:h-4 md:w-5 md:h-5 rounded-full object-cover ring-1 sm:ring-2 ring-white flex-shrink-0" />`;
                        });
                    }
                    if (membersList.length > 3) {
                        memberAvatarsHtml += `<span class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full bg-slate-200 text-[7px] sm:text-[8px] font-bold text-slate-600 flex items-center justify-center ring-1 sm:ring-2 ring-white">+${membersList.length - 3}</span>`;
                    }
                    memberAvatarsHtml += `</div>`;
                }

                dayCell.innerHTML = `
                    <div class="flex items-center justify-between w-full">
