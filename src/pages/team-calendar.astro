        // Free Time Slot Detector (08:00 to 22:00)
        function calculateFreeTimeSlots(dayEvents, formattedDateStr) {
            const freeSlotsContainer = document.getElementById('free-slots-summary-container');
            if (!freeSlotsContainer) return;

            freeSlotsContainer.innerHTML = '';

            if (dayEvents.length === 0) {
                freeSlotsContainer.innerHTML = `
                    <div class="p-3 bg-emerald-500/10 rounded-2xl border border-emerald-200 text-xs text-emerald-900">
                        <span class="font-black text-emerald-800 block mb-0.5">🌟 Full Free 1 Hari Full!</span>
                        Tanggal <strong>${formattedDateStr}</strong> tidak ada kegiatan tim sama sekali (08:00 - 22:00 WIB).
                    </div>
                `;
                return;
            }

            const busyIntervals = dayEvents.map(e => {
                const [h1, m1] = e.start_time.split(':').map(Number);
                const [h2, m2] = e.end_time.split(':').map(Number);
                return { start: h1 * 60 + m1, end: h2 * 60 + m2 };
            }).sort((a, b) => a.start - b.start);

            const mergedBusy = [];
            busyIntervals.forEach(curr => {
                if (mergedBusy.length === 0) {
                    mergedBusy.push(curr);
                } else {
                    const prev = mergedBusy[mergedBusy.length - 1];
                    if (curr.start <= prev.end) {
                        prev.end = Math.max(prev.end, curr.end);
                    } else {
                        mergedBusy.push(curr);
                    }
                }
            });

            const dayStart = 8 * 60;
            const dayEnd = 22 * 60;
            const freeGaps = [];
            let lastEnd = dayStart;

            mergedBusy.forEach(b => {
                if (b.start > lastEnd) {
                    freeGaps.push({ start: lastEnd, end: b.start });
                }
                lastEnd = Math.max(lastEnd, b.end);
            });

            if (lastEnd < dayEnd) {
                freeGaps.push({ start: lastEnd, end: dayEnd });
            }

            function minsToTimeStr(mins) {
                const h = String(Math.floor(mins / 60)).padStart(2, '0');
                const m = String(mins % 60).padStart(2, '0');
                return `${h}:${m}`;
            }

            if (freeGaps.length === 0) {
                freeSlotsContainer.innerHTML = `
                    <div class="p-3 bg-rose-50 rounded-2xl border border-rose-100 text-xs text-rose-800">
                        <span class="font-bold block mb-0.5">⚠️ Jadwal Padat</span>
                        Pada tanggal ini kegiatan anggota tim penuh dari jam 08:00 hingga 22:00.
                    </div>
                `;
            } else {
                freeGaps.forEach(gap => {
                    const durationMins = gap.end - gap.start;
                    if (durationMins >= 60) {
                        const gapEl = document.createElement('div');
                        gapEl.className = "p-3 bg-white rounded-2xl border border-emerald-100 text-xs text-slate-800 flex items-center justify-between";
                        gapEl.innerHTML = `
                            <div>
                                <span class="font-extrabold text-emerald-600 text-xs block">🕒 ${minsToTimeStr(gap.start)} - ${minsToTimeStr(gap.end)} WIB</span>
                                <span class="text-[11px] text-slate-500">Durasi: ${Math.floor(durationMins/60)} jam ${durationMins%60} mnt</span>
                            </div>
                            <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-1 rounded-lg">Bisa Dipakai</span>
                        `;
                        freeSlotsContainer.appendChild(gapEl);
                    }
                });
            }
        }

