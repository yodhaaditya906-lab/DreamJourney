import Layout from '../layouts/Layout.astro';
import { fetchCachedCSV } from '../lib/fetchCache';

const { userId, sessionClaims } = Astro.locals.auth();

if (!userId) {
    return Astro.redirect('/');
}

const clerkUser = await Astro.locals.currentUser();
const unsafeMeta = (sessionClaims?.unsafe_metadata || sessionClaims?.unsafeMetadata || clerkUser?.unsafeMetadata || {}) as any;
const hasDomisili = unsafeMeta?.domisili;
const hasDob = unsafeMeta?.dob;

if (!hasDomisili || !hasDob) {
    const currentUrl = Astro.url.pathname + Astro.url.search;
    return Astro.redirect('/onboarding?redirect_url=' + encodeURIComponent(currentUrl));
}

const title = Astro.url.searchParams.get('title') || 'Liburan Impian';
const priceStr = Astro.url.searchParams.get('price') || '0';
const dailyPriceStr = Astro.url.searchParams.get('dailyPrice') || '0';
const weeklyPriceStr = Astro.url.searchParams.get('weeklyPrice') || '0';
const monthlyPriceStr = Astro.url.searchParams.get('monthlyPrice') || '0';
const time = Astro.url.searchParams.get('time') || '';
const image = Astro.url.searchParams.get('image') || '';

let hargaPenginapanStr = Astro.url.searchParams.get('hargaPenginapan') || Astro.url.searchParams.get('akomodasi') || '';
let hargaTransportStr = Astro.url.searchParams.get('hargaTransport') || Astro.url.searchParams.get('transport') || '';
let hargaWahanaStr = Astro.url.searchParams.get('hargaWahana') || Astro.url.searchParams.get('wahana') || '';

let hargaPenginapan = parseInt(hargaPenginapanStr.replace(/[^\d]/g, ''), 10) || 0;
let hargaTransport = parseInt(hargaTransportStr.replace(/[^\d]/g, ''), 10) || 0;
let hargaWahana = parseInt(hargaWahanaStr.replace(/[^\d]/g, ''), 10) || 0;

const price = parseInt(priceStr, 10);
let dailyPrice = parseInt(dailyPriceStr, 10);
let weeklyPrice = parseInt(weeklyPriceStr, 10);
let monthlyPrice = parseInt(monthlyPriceStr, 10);

const investPrice = Math.round(price * 1.06); // 6% estimation logic
const formattedPrice = `Rp ${new Intl.NumberFormat('id-ID').format(price)}`;
const formattedInvestPrice = `Rp ${new Intl.NumberFormat('id-ID').format(investPrice)}`;

let lenteraIds: string[] = [];
let validMitras: any[] = [];

function parseCSVRow(row: string) {
    const result = [];
    let curVal = '';
    let inQuotes = false;
    for (let i = 0; i < row.length; i++) {
        if (row[i] === '"') {
            inQuotes = !inQuotes;
        } else if (row[i] === ',' && !inQuotes) {
            result.push(curVal.trim());
            curVal = '';
        } else {
            curVal += row[i];
        }
    }
    result.push(curVal.trim());
    return result;
}

// Fetch package sheet data for exact Harian, Mingguan, Bulanan figures if not passed in searchParams
try {
  const pkgCsvText = await fetchCachedCSV('https://docs.google.com/spreadsheets/d/1eD4zbqYsW-Ce6eLemIUt5VdSIykWnlhM0kwTVBgD1Yw/export?format=csv');
  const pkgRows = pkgCsvText.split('\n');
  if (pkgRows.length > 1) {
    const headers = parseCSVRow(pkgRows[0]);
    const idxTitle = headers.findIndex(h => h.toLowerCase().includes('title'));
    const idxDaily = headers.findIndex(h => h.toLowerCase().includes('harian') || h.toLowerCase().includes('daily'));
    const idxWeekly = headers.findIndex(h => h.toLowerCase().includes('mingguan') || h.toLowerCase().includes('weekly'));
    const idxMonthly = headers.findIndex(h => h.toLowerCase().includes('bulanan') || h.toLowerCase().includes('monthly'));

    const idxPenginapan = headers.findIndex(h => h.toLowerCase().includes('harga_penginapan') || h.toLowerCase().includes('harga_akomodasi'));
    const idxTransport = headers.findIndex(h => h.toLowerCase().includes('harga_transport'));
    const idxWahana = headers.findIndex(h => h.toLowerCase().includes('harga_wahana'));

    const matchRow = pkgRows.slice(1).find(row => {
      if (!row.trim() || row.startsWith(',')) return false;
      const cols = parseCSVRow(row);
      const rowTitle = (cols[idxTitle !== -1 ? idxTitle : 0] || '').trim();
      return rowTitle.toLowerCase().includes(title.toLowerCase()) || title.toLowerCase().includes(rowTitle.toLowerCase());
    });

    if (matchRow) {
      const cols = parseCSVRow(matchRow);
      if (!dailyPrice && idxDaily !== -1 && cols[idxDaily]) {
        dailyPrice = parseInt(cols[idxDaily].replace(/[^\d]/g, ''), 10) || 0;
      }
      if (!weeklyPrice && idxWeekly !== -1 && cols[idxWeekly]) {
        weeklyPrice = parseInt(cols[idxWeekly].replace(/[^\d]/g, ''), 10) || 0;
      }
      if (!monthlyPrice && idxMonthly !== -1 && cols[idxMonthly]) {
        monthlyPrice = parseInt(cols[idxMonthly].replace(/[^\d]/g, ''), 10) || 0;
      }
      if (idxPenginapan !== -1 && cols[idxPenginapan]) {
        hargaPenginapan = parseInt(cols[idxPenginapan].replace(/[^\d]/g, ''), 10) || hargaPenginapan;
      }
      if (idxTransport !== -1 && cols[idxTransport]) {
        hargaTransport = parseInt(cols[idxTransport].replace(/[^\d]/g, ''), 10) || hargaTransport;
      }
      if (idxWahana !== -1 && cols[idxWahana]) {
        hargaWahana = parseInt(cols[idxWahana].replace(/[^\d]/g, ''), 10) || hargaWahana;
      }
    }
  }
} catch (error) {
  console.error("Failed to fetch package CSV fallback:", error);
}

if (!weeklyPrice && dailyPrice) weeklyPrice = dailyPrice * 7;
if (!monthlyPrice && dailyPrice) monthlyPrice = dailyPrice * 30;

try {
  const csvText = await fetchCachedCSV('https://docs.google.com/spreadsheets/d/1qie-zXXTH6xqEn_oxlZEQYCU2DDGmQn_ACWZNFI7xOM/export?format=csv');
  const rows = csvText.split('\n').slice(1);
  lenteraIds = rows.filter(row => row.trim() && !row.startsWith(',')).map(row => {
      const cols = parseCSVRow(row);
      return cols[0] || "";
  }).filter(id => id !== "");
} catch (error) {
  console.error("Failed to fetch lentera data:", error);
}

try {
  const mitraCsvText = await fetchCachedCSV('https://docs.google.com/spreadsheets/d/1iF_gSErDUz9kMnDiSSgySE1gePeoFRmTdRffdQ4A9ys/export?format=csv');
  const mitraRows = mitraCsvText.split('\n').slice(1);
  validMitras = mitraRows.filter(row => row.trim() && !row.startsWith(',')).map(row => {
      const cols = parseCSVRow(row);
      return {
          id: (cols[1] || '').trim(),
          name: (cols[2] || '').trim(),
          domisili: (cols[3] || '').trim(),
          status: (cols[6] || '').trim()
      };
  }).filter(m => m.id !== "");
} catch (error) {
  console.error("Failed to fetch mitra data:", error);
}
