---
import Layout from '../../layouts/Layout.astro';

const { userId } = Astro.locals.auth();
if (!userId) {
    return Astro.redirect('/');
}

const goalId = Astro.url.searchParams.get('goalId') || `TRIP-${Date.now()}`;
const title = Astro.url.searchParams.get('title') || 'Perjalanan Impian';
const amountStr = Astro.url.searchParams.get('amount') || '50000';
const image = Astro.url.searchParams.get('image') || '';
const frequency = Astro.url.searchParams.get('frequency') || 'Mingguan';

const amount = parseInt(amountStr, 10) || 50000;
const formattedAmount = `Rp ${new Intl.NumberFormat('id-ID').format(amount)}`;
---

<Layout title="Pembayaran Setoran QRIS - DreamJourney">
    <main class="pt-24 pb-16 bg-blue-50/30 min-h-screen relative overflow-hidden">
        <div class="container mx-auto px-4 w-full max-w-5xl relative z-10 space-y-6">
            <!-- Back Navigation Header -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <a href="/dashboard" class="inline-flex items-center gap-2 text-xs md:text-sm font-bold text-gray-600 hover:text-primary transition-all group">
                    <i data-feather="arrow-left" class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform"></i>
                    <span>Kembali ke Dashboard Tabungan</span>
                </a>
                <span class="inline-flex items-center gap-1.5 bg-blue-50 border border-blue-200/80 text-primary px-3 py-1 rounded-full text-xs font-bold shadow-2xs">
                    <i data-feather="clock" class="w-3.5 h-3.5"></i>
                    <span>Setoran Tabungan {frequency}</span>
                </span>
            </div>

            <!-- Page Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                
                <!-- LEFT/MAIN COLUMN: QRIS Display Box -->
                <div class="lg:col-span-7 space-y-6">
                    <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100/80 space-y-6 text-center">
                        
                        <div class="inline-flex items-center gap-2 bg-blue-50 text-primary px-3.5 py-1 rounded-full text-xs font-bold">
                            <i data-feather="smartphone" class="w-4 h-4"></i> Pembayaran QRIS Resmi
                        </div>

                        <div>
                            <h2 class="text-xl md:text-2xl font-black text-gray-900">Setoran Tabungan: {title}</h2>
                            <p class="text-xs text-gray-500 mt-1">Lakukan scan QRIS di bawah ini untuk menambah saldo tabungan liburan Anda.</p>
                        </div>

                        <!-- Nominal Display -->
                        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 max-w-sm mx-auto">
                            <span class="text-xs text-gray-500 uppercase tracking-wider font-bold">Total Nominal Setoran</span>
                            <p class="text-2xl font-black text-primary mt-0.5">{formattedAmount}</p>
                            <p class="text-[11px] text-gray-400 mt-1">ID Target: <span class="font-mono text-gray-600">{goalId}</span></p>
                        </div>

                        <!-- QR Code Container -->
                        <div class="bg-white p-6 rounded-3xl border-2 border-dashed border-blue-200 inline-block shadow-inner relative max-w-xs mx-auto">
                            <div class="flex justify-between items-center mb-3">
                                <span class="text-[10px] font-black text-red-600 tracking-wider">QRIS</span>
                                <span class="text-[10px] font-bold text-gray-400">GPN</span>
                            </div>
                            
                            <!-- QR Image -->
                            <img id="qris-image" 
                                 src={`https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=00020101021226670016COM.DREAMJOURNEY01189360091430000000005204581253033605802ID5912DREAMJOURNEY6007JAKARTA61051211062070703A01`} 
                                 alt="QRIS Code Pembayaran" 
                                 class="w-52 h-52 object-contain mx-auto rounded-lg shadow-sm" />

                            <div class="mt-3 flex items-center justify-center gap-1.5 text-[11px] font-bold text-emerald-600">
                                <i data-feather="shield-check" class="w-4 h-4"></i> Terverifikasi Otomatis
                            </div>

                            <div class="mt-3.5 pt-3 border-t border-blue-100/80">
                                <button type="button" id="btn-download-qris" class="w-full inline-flex items-center justify-center gap-2 bg-blue-50 hover:bg-blue-100 text-primary font-bold text-xs py-2.5 px-3 rounded-xl transition border border-blue-200/80 cursor-pointer shadow-2xs">
                                    <i data-feather="download" class="w-3.5 h-3.5"></i>
                                    <span>Unduh Gambar QRIS</span>
                                </button>
                            </div>
                        </div>

                        <!-- Timer Box -->
                        <div class="flex items-center justify-center gap-2 text-xs font-semibold text-amber-800 bg-amber-50 p-3 rounded-xl border border-amber-200/80 max-w-md mx-auto">
                            <i data-feather="clock" class="w-4 h-4 text-amber-600 animate-pulse"></i>
                            <span>Batas Waktu Pembayaran: <strong id="countdown-timer" class="font-bold text-amber-900">14:59</strong></span>
                        </div>

                        <!-- Payment Instructions -->
                        <div class="text-left bg-slate-50 p-4 rounded-2xl border border-slate-100 text-xs text-gray-600 space-y-1.5 leading-relaxed">
                            <p class="font-bold text-gray-800 mb-1">Cara Pembayaran QRIS:</p>
                            <p>1. Buka aplikasi M-Banking (BCA, Mandiri, BRI, BNI) atau E-Wallet (GoPay, OVO, Dana, ShopeePay).</p>
                            <p>2. Pilih menu <strong>Scan / Bayar QRIS</strong> dan arahkan kamera ke kode QR di atas.</p>
                            <p>3. Periksa nominal sebesar <strong>{formattedAmount}</strong> dan konfirmasi pembayaran.</p>
                        </div>

                        <!-- Action CTA Buttons -->
                        <div class="pt-2 max-w-md mx-auto">
                            <button id="btn-confirm-payment" class="w-full bg-primary hover:bg-blue-700 text-white py-4 px-6 rounded-2xl font-extrabold text-sm shadow-lg shadow-blue-500/20 hover:shadow-xl transition-all flex items-center justify-center gap-2 cursor-pointer">
                                <i data-feather="check-circle" class="w-5 h-5"></i>
                                <span>Saya Sudah Bayar (Konfirmasi Setoran)</span>
                            </button>
                        </div>

                    </div>
                </div>

                <!-- RIGHT COLUMN: Sticky Summary -->
                <div class="lg:col-span-5 space-y-6">
                    <div class="bg-white rounded-3xl p-6 shadow-xl border border-slate-100/80 space-y-6">
                        <h3 class="text-base font-extrabold text-gray-800">Detail Target Tabungan</h3>
                        
                        <div class="relative rounded-2xl overflow-hidden shadow-md">
                            {image ? (
                                <img src={image} alt={title} class="w-full h-44 object-cover" />
                            ) : (
                                <div class="w-full h-44 bg-gradient-to-br from-primary to-indigo-700 flex items-center justify-center text-white">
                                    <i data-feather="map-pin" class="w-10 h-10 opacity-50"></i>
                                </div>
                            )}
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent flex flex-col justify-end p-4 text-white">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-blue-200">Destinasi Impian</span>
                                <h4 class="text-lg font-extrabold leading-tight text-white">{title}</h4>
                            </div>
                        </div>

                        <div class="bg-slate-50 rounded-2xl p-4 border border-slate-100 space-y-2.5 text-xs">
                            <div class="flex justify-between items-center">
                                <span class="text-gray-500">Frekuensi Menabung</span>
                                <span class="font-bold text-gray-800">{frequency}</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-gray-500">Metode Setoran</span>
                                <span class="font-bold text-primary">QRIS Dynamic</span>
                            </div>
                            <div class="flex justify-between items-center pt-2 border-t border-slate-200/60">
                                <span class="text-gray-500 font-medium">Status Verifikasi</span>
                                <span class="font-bold text-amber-600 flex items-center gap-1">
                                    <i data-feather="clock" class="w-3.5 h-3.5"></i> Menunggu Setoran
                                </span>
                            </div>
                        </div>

                        <div class="p-4 bg-emerald-50/80 rounded-2xl border border-emerald-100 text-xs text-emerald-900 flex items-start gap-2.5">
                            <i data-feather="shield-check" class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5"></i>
                            <div>
                                <p class="font-bold">Keamanan Terjamin (100% Escrow)</p>
                                <p class="text-[11px] text-emerald-700 mt-0.5">Setoran Anda akan langsung tercatat di Dashboard Tabungan Anda secara otomatis.</p>
                            </div>
                        </div>

                        <a href="/dashboard" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition text-xs">
                            <i data-feather="arrow-left" class="w-4 h-4"></i> Kembali ke Dashboard Tabungan
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Download / Save QRIS Image logic
        const btnDownloadQr = document.getElementById('btn-download-qris');
        const qrisImg = document.getElementById('qris-image') as HTMLImageElement;

        btnDownloadQr?.addEventListener('click', async () => {
            if (!qrisImg) return;
            const originalHtml = btnDownloadQr.innerHTML;
            btnDownloadQr.innerHTML = '<i data-feather="loader" class="w-3.5 h-3.5 animate-spin"></i> <span>Mengunduh...</span>';
            if ((window as any).feather) (window as any).feather.replace();

            const urlParams = new URLSearchParams(window.location.search);
            const goalId = urlParams.get('goalId') || `TRIP-${Date.now()}`;
            const qrUrl = qrisImg.src;

            try {
                const response = await fetch(qrUrl);
                const blob = await response.blob();
                const blobUrl = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = blobUrl;
                link.download = `QRIS-DreamJourney-${goalId}.png`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(blobUrl), 200);
            } catch (e) {
                const link = document.createElement('a');
                link.href = qrUrl;
                link.target = '_blank';
                link.download = `QRIS-DreamJourney-${goalId}.png`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            } finally {
                btnDownloadQr.innerHTML = originalHtml;
                if ((window as any).feather) (window as any).feather.replace();
            }
        });

        // Countdown timer (15 mins)
        let timeLeft = 15 * 60;
        const timerEl = document.getElementById('countdown-timer');
        
        const countdownInterval = setInterval(() => {
            if (timeLeft <= 0) {
                clearInterval(countdownInterval);
                if (timerEl) timerEl.innerText = "00:00 (Kadaluarsa)";
                return;
            }
            timeLeft--;
            const mins = Math.floor(timeLeft / 60);
            const secs = timeLeft % 60;
            if (timerEl) {
                timerEl.innerText = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
            }
        }, 1000);

        // Confirm Payment CTA -> Update Supabase & Return to Dashboard
        const btnConfirm = document.getElementById('btn-confirm-payment');
        btnConfirm?.addEventListener('click', async () => {
            const urlParams = new URLSearchParams(window.location.search);
            const goalId = urlParams.get('goalId') || '';
            const amount = urlParams.get('amount') || '';

            btnConfirm.innerHTML = '<i data-feather="loader" class="w-4 h-4 animate-spin"></i> Verifikasi Pembayaran & Simpan Setoran...';
            (btnConfirm as HTMLButtonElement).disabled = true;

            try {
                // Call wallet API to record deposit transaction & update saved_amount in Supabase
                await fetch('/api/wallet', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: 'SIMULATE_DEBIT',
                        goalId,
                        amount: parseInt(amount, 10) || 50000
                    })
                });
            } catch (err) {
                console.error("Failed to update deposit in Supabase:", err);
            } finally {
                alert("🎉 Setoran Tabungan QRIS Berhasil Diverifikasi! Anda akan diarahkan kembali ke Dashboard Tabungan.");
                window.location.href = '/dashboard';
            }
        });
    });
</script>
