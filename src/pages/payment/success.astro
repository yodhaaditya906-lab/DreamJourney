---
import Layout from '../../layouts/Layout.astro';

const { userId } = Astro.locals.auth();
if (!userId) {
    return Astro.redirect('/');
}

const goalId = Astro.url.searchParams.get('goalId') || '';
const title = Astro.url.searchParams.get('title') || 'Perjalanan Impian';
const amountStr = Astro.url.searchParams.get('amount') || '0';
const image = Astro.url.searchParams.get('image') || '';
const type = Astro.url.searchParams.get('type') || 'qris';

const amount = parseInt(amountStr, 10) || 0;
const formattedAmount = amount > 0 ? `Rp ${new Intl.NumberFormat('id-ID').format(amount)}` : 'Setoran Tunai (Mitra)';
---

<Layout title="Selamat! Perjalanan Dimulai - DreamJourney">
    <main class="pt-24 pb-16 bg-gradient-to-b from-blue-50/50 via-slate-50 to-white min-h-screen relative overflow-hidden">
        <div class="container mx-auto px-4 w-full max-w-4xl relative z-10 space-y-6">
            <!-- Header Info -->
            <div class="text-right">
                <span class="text-xs font-semibold text-gray-400">Tahap 3 dari 3 (Selesai)</span>
            </div>

            <!-- Stepper Indicator Bar (3 Steps Wizard) -->
            <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-100 flex items-center justify-between max-w-3xl mx-auto mb-6">
                <!-- Step 1: Completed -->
                <div class="flex items-center gap-2.5 text-emerald-600">
                    <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-xs border border-emerald-300">
                        <i data-feather="check" class="w-4 h-4"></i>
                    </div>
                    <span class="text-xs md:text-sm font-bold">Atur Tabungan</span>
                </div>

                <div class="flex-1 max-w-[60px] md:max-w-[100px] h-0.5 bg-emerald-400 mx-2"></div>

                <!-- Step 2: Completed -->
                <div class="flex items-center gap-2.5 text-emerald-600">
                    <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-xs border border-emerald-300">
                        <i data-feather="check" class="w-4 h-4"></i>
                    </div>
                    <span class="text-xs md:text-sm font-bold hidden sm:inline">Bayar QRIS</span>
                    <span class="text-xs md:text-sm font-bold sm:hidden">QRIS</span>
                </div>

                <div class="flex-1 max-w-[60px] md:max-w-[100px] h-0.5 bg-emerald-400 mx-2"></div>

                <!-- Step 3: Active (Selesai) -->
                <div class="flex items-center gap-2.5 text-emerald-600">
                    <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-extrabold text-xs shadow-md shadow-emerald-500/20">
                        3
                    </div>
                    <span class="text-xs md:text-sm font-extrabold text-emerald-700">Selesai</span>
                </div>
            </div>

            <!-- Celebration Card -->
            <div class="bg-white rounded-3xl p-8 md:p-10 shadow-xl border border-slate-100 text-center space-y-6 max-w-2xl mx-auto relative overflow-hidden">
                
                <!-- Confetti / Success Badge -->
                <div class="w-20 h-20 rounded-3xl bg-gradient-to-tr from-emerald-500 to-teal-400 text-white flex items-center justify-center mx-auto shadow-lg shadow-emerald-500/30 transform hover:scale-105 transition-transform duration-300">
                    <i data-feather="check-circle" class="w-10 h-10"></i>
                </div>

                <div>
                    <span class="inline-block bg-emerald-50 text-emerald-700 text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider mb-2">
                        🎉 Selamat! Perjalanan Dimulai
                    </span>
                    <h1 class="text-2xl md:text-3xl font-black text-gray-900 tracking-tight">Liburan Impian Anda Resmi Terdaftar!</h1>
                    <p class="text-gray-600 text-xs md:text-sm mt-2 max-w-md mx-auto leading-relaxed">
                        Langkah pertama Anda untuk mewujudkan liburan ke <strong class="text-gray-800">{title}</strong> telah berhasil dicatat dan aktif di akun Anda.
                    </p>
                </div>

                <!-- Destination Card Preview -->
                <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200/80 space-y-4 text-left">
                    <div class="flex items-center gap-4">
                        {image ? (
                            <img src={image} alt={title} class="w-20 h-20 object-cover rounded-xl shadow-sm flex-shrink-0" />
                        ) : (
                            <div class="w-20 h-20 bg-primary text-white rounded-xl flex items-center justify-center flex-shrink-0">
                                <i data-feather="map-pin" class="w-8 h-8"></i>
                            </div>
                        )}
                        <div>
                            <span class="text-[10px] font-bold uppercase tracking-wider text-primary">Target Perjalanan</span>
                            <h3 class="text-base font-extrabold text-gray-900">{title}</h3>
                            <p class="text-xs text-gray-500 mt-0.5">Status Goal: <span class="font-bold text-emerald-600">Aktif & Menabung</span></p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 pt-3 border-t border-slate-200/60 text-xs">
                        <div>
                            <span class="text-gray-500 block">Setoran Awal</span>
                            <span class="font-bold text-gray-900 text-sm">{formattedAmount}</span>
                        </div>
                        <div>
                            <span class="text-gray-500 block">Proteksi Keamanan</span>
                            <span class="font-bold text-emerald-600 flex items-center gap-1">
                                <i data-feather="shield" class="w-3.5 h-3.5"></i> Escrow 100%
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Primary CTA Button -->
                <div class="pt-4">
                    <a href="/dashboard" class="inline-flex items-center justify-center gap-2.5 w-full bg-primary hover:bg-blue-700 text-white py-4 px-8 rounded-2xl font-extrabold text-base shadow-lg shadow-blue-500/25 hover:shadow-xl transition-all transform hover:-translate-y-0.5">
                        <span>Lihat Dashboard Tabungan Saya</span>
                        <i data-feather="arrow-right" class="w-5 h-5"></i>
                    </a>
                </div>

            </div>
        </div>
    </main>
</Layout>
