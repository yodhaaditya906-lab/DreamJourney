                                <h3 class="font-bold text-sm text-gray-900 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                                    </svg>
                                    Filter Pencarian
                                </h3>
                                <button type="button" id="sidebar-reset-btn" class="text-xs text-blue-600 font-semibold hover:underline cursor-pointer">Reset</button>
                            </div>

                            <!-- Filter: Tipe Liburan / Category -->
                            <div>
                                <h4 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-2.5">Kategori Liburan</h4>
                                <div class="space-y-2 text-xs text-gray-600 font-medium">
                                    <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                                        <input type="checkbox" value="Open Trip" class="filter-checkbox rounded text-blue-600 focus:ring-blue-500 w-4 h-4">
                                        <span>Open Trip</span>
                                    </label>
                                    <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                                        <input type="checkbox" value="Private Trip" class="filter-checkbox rounded text-blue-600 focus:ring-blue-500 w-4 h-4">
                                        <span>Private Trip</span>
                                    </label>
                                    <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                                        <input type="checkbox" value="Bebas" class="filter-checkbox rounded text-blue-600 focus:ring-blue-500 w-4 h-4">
                                        <span>Tiket Liburan (Bebas Tanggal)</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Filter: Fasilitas Included -->
                            <div class="pt-3 border-t border-gray-100">
                                <h4 class="text-xs font-bold text-gray-700 uppercase tracking-wider mb-2.5">Fasilitas Termasuk</h4>
                                <div class="space-y-2 text-xs text-gray-600 font-medium">
                                    <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                                        <input type="checkbox" value="facility_transport" class="filter-checkbox rounded text-blue-600 focus:ring-blue-500 w-4 h-4">
                                        <span>🚗 Transportasi Keberangkatan</span>
                                    </label>
                                    <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                                        <input type="checkbox" value="facility_akomodasi" class="filter-checkbox rounded text-blue-600 focus:ring-blue-500 w-4 h-4">
                                        <span>🏨 Hotel / Penginapan</span>
                                    </label>
                                    <label class="flex items-center gap-2.5 cursor-pointer hover:text-gray-900">
                                        <input type="checkbox" value="facility_wahana" class="filter-checkbox rounded text-blue-600 focus:ring-blue-500 w-4 h-4">
                                        <span>🎟️ Tiket Entry Wisata</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </aside>

                    <!-- RIGHT COLUMN: Header Toolbar & Ticket Cards List (3/4 width on desktop) -->
                    <main class="lg:col-span-3 space-y-5">
                        
                        <!-- Toolbar Header -->
                        <div class="bg-white rounded-2xl p-4 border border-gray-200/80 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                            <div>
                                <h2 id="results-heading" class="text-base md:text-lg font-bold text-gray-900 leading-tight">Semua Paket Wisata Impian</h2>
                                <span id="package-count" class="text-xs text-gray-500 font-medium">Menampilkan {packages.length} tiket perjalanan</span>
                            </div>

                            <div class="flex items-center gap-3 w-full sm:w-auto flex-wrap">
                                <!-- Frequency Selector -->
                                <div class="flex items-center gap-2 bg-gray-50 px-3 py-2 rounded-xl border border-gray-200 text-xs">
                                    <span class="font-semibold text-gray-500">Hitungan:</span>
                                    <select id="filter-tipe-tabungan-quick" class="bg-transparent font-bold text-blue-700 cursor-pointer outline-none">
                                        <option value="1">Harian (/hari)</option>
