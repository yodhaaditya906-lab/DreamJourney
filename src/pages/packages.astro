                                    <div class="hidden md:block absolute bottom-0 right-[250px] lg:right-[270px] w-5 h-2.5 bg-slate-50 rounded-t-full border-t border-l border-r border-gray-200 -mr-2.5 z-20"></div>

                                    <!-- LEFT SIDE: Image & Badges (30-35% width) -->
