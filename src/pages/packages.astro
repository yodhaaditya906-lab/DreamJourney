                <button type="button" class="map-city-pill bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer" data-city="Yogyakarta">📍 Yogyakarta</button>
                <button type="button" class="map-city-pill bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer" data-city="Bali">📍 Bali</button>
                <button type="button" class="map-city-pill bg-blue-50 text-blue-700 hover:bg-blue-600 hover:text-white px-3 py-1 rounded-full text-xs font-bold transition cursor-pointer" data-city="Lombok">📍 Lombok</button>
