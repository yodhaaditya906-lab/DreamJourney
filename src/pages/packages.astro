                                    <!-- MIDDLE SECTION: Details & Facilities (Flexible width) -->
                                    <div class="p-5 flex-grow flex flex-col justify-between border-b md:border-b-0 md:border-r border-dashed border-gray-200 relative">
                                        <div>
                                            <div class="flex justify-between items-start gap-2 mb-2">
                                                <a href={`/package/${pkg.slug}`} class="hover:text-blue-600 transition">
                                                    <h3 class="font-bold text-base md:text-lg text-gray-900 leading-snug">{pkg.title}</h3>
                                                </a>
                                                <div class="flex items-center gap-1 flex-shrink-0 bg-blue-50 text-blue-700 px-2 py-0.5 rounded-lg text-xs font-bold">
                                                    <span>8.8/10</span>
