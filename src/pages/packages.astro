---
import Layout from '../layouts/Layout.astro';
import { fetchCachedCSV } from '../lib/fetchCache';

const { userId } = Astro.locals.auth();
const isLoggedIn = !!userId;

let packages = [];
try {
  const csvText = await fetchCachedCSV('https://docs.google.com/spreadsheets/d/1eD4zbqYsW-Ce6eLemIUt5VdSIykWnlhM0kwTVBgD1Yw/export?format=csv');
  
  const imageMap = {
    "bali": "https://images.unsplash.com/photo-1537996194471-e657df975ab4?q=80&w=600&auto=format&fit=crop",
    "jogja": "https://images.unsplash.com/photo-1626125345510-4603468eedfb?q=80&w=600&auto=format&fit=crop",
    "malioboro": "https://images.unsplash.com/photo-1626125345510-4603468eedfb?q=80&w=600&auto=format&fit=crop",
    "bandung": "https://images.unsplash.com/photo-1590559899147-eb54a69622df?q=80&w=600&auto=format&fit=crop",
    "puncak bogor": "https://images.unsplash.com/photo-1626082928503-4c91b5c4644d?q=80&w=600&auto=format&fit=crop",
    "malang": "https://images.unsplash.com/photo-1602167732001-97b7b137a1f5?q=80&w=600&auto=format&fit=crop",
    "gunung bromo": "https://images.unsplash.com/photo-1602167732001-97b7b137a1f5?q=80&w=600&auto=format&fit=crop",
    "surabaya": "https://images.unsplash.com/photo-1601999109332-542b18dbec57?q=80&w=600&auto=format&fit=crop",
    "pulau karimun jawa": "https://images.unsplash.com/photo-1516690561799-46d8f74f9abf?q=80&w=600&auto=format&fit=crop",
    "banda neira": "https://images.unsplash.com/photo-1516483638261-f4dbaf036963?q=80&w=600&auto=format&fit=crop",
    "raja ampat": "https://images.unsplash.com/photo-1544551763-46a013bb70d5?q=80&w=600&auto=format&fit=crop"
  };

  const defaultImage = "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600&auto=format&fit=crop";

  function slugify(text) {
      if (!text) return '';
      return text.toString().toLowerCase()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
  }

  function parseCSVRow(row) {
      const result = [];
      let curVal = '';
      let inQuotes = false;
      for (let i = 0; i < row.length; i++) {
          if (row[i] === '"') {
              inQuotes = !inQuotes;
          } else if (row[i] === ',' && !inQuotes) {
              result.push(curVal.trim());
              curVal = '';
          } else {
              curVal += row[i];
          }
      }
      result.push(curVal.trim());
      return result;
  }

  const allRows = csvText.split('\n');
  const headerCols = allRows.length > 0 ? parseCSVRow(allRows[0]) : [];
  
  const findHeaderIdx = (keywords: string[], defaultIdx: number) => {
      const found = headerCols.findIndex(h => keywords.some(k => h.toLowerCase().includes(k)));
      return found !== -1 ? found : defaultIdx;
  };

  const idxTitle = findHeaderIdx(['title'], 0);
  const idxDesc = findHeaderIdx(['description', 'desc'], 1);
  const idxDaily = findHeaderIdx(['daily', 'harian'], 2);
  const idxTotal = findHeaderIdx(['total_price', 'total'], 3);
  const idxWeekly = findHeaderIdx(['weekly', 'mingguan'], -1);
  const idxMonthly = findHeaderIdx(['monthly', 'bulanan'], -1);
  const idxTime = findHeaderIdx(['durasi'], 4);
  const idxOrigin = findHeaderIdx(['origin'], 5);
  const idxDestination = findHeaderIdx(['destination'], 6);
  const idxWahana = findHeaderIdx(['wahana'], 9);
  const idxPenginapan = findHeaderIdx(['penginapan'], 10);
  const idxTransKeberangkatan = findHeaderIdx(['transportasi keberangkatan', 'keberangkatan'], 11);
  const idxTransKepulangan = findHeaderIdx(['transportasi kepulangan', 'kepulangan'], 12);
  const idxMainImage = findHeaderIdx(['main_image'], 14);
  const idxAkomodasi = findHeaderIdx(['harga_penginapan', 'harga_akomodasi'], 19);
  const idxTransport = findHeaderIdx(['harga_transport'], 20);
  const idxHargaWahana = findHeaderIdx(['harga_wahana'], 21);
  const idxLainnya = findHeaderIdx(['harga_lainnya'], 22);
  const idxJenis = findHeaderIdx(['jenis liburan', 'jenis'], 29);

  const isTidak = (str: string) => !str || str.trim() === "" || str.trim() === "-" || str.toLowerCase().includes('tidak') || str.toLowerCase().includes('tanpa');

  const rows = allRows.slice(1);
  packages = rows.filter(row => row.trim() && !row.startsWith(',')).map((row, index) => {
    const cols = parseCSVRow(row);
    
    const title = cols[idxTitle] || "Unknown";
    const desc = cols[idxDesc] || "";
    const dailyPrice = cols[idxDaily] || "";
    const rawDailyPrice = cols[idxDaily] ? cols[idxDaily].replace(/[^\d]/g, '') : "0";
    const parsedDailyPrice = parseInt(rawDailyPrice, 10) || 0;
    const rawPrice = cols[idxTotal] ? cols[idxTotal].replace(/[^\d]/g, '') : "0";
    const price = parseInt(rawPrice, 10) || 0;

    const rawWeeklyPrice = (idxWeekly !== -1 && cols[idxWeekly]) ? cols[idxWeekly].replace(/[^\d]/g, '') : "";
    const parsedWeeklyPrice = rawWeeklyPrice ? parseInt(rawWeeklyPrice, 10) : (parsedDailyPrice * 7);

    const rawMonthlyPrice = (idxMonthly !== -1 && cols[idxMonthly]) ? cols[idxMonthly].replace(/[^\d]/g, '') : "";
    const parsedMonthlyPrice = rawMonthlyPrice ? parseInt(rawMonthlyPrice, 10) : (parsedDailyPrice * 30);
    
    const time = cols[idxTime] || "";
    const origin = cols[idxOrigin] || "Unknown";
    const destination = cols[idxDestination] || title;
    const jenisLiburan = cols[idxJenis] || "Private Trip";

    const wahanaRaw = cols[idxWahana] || "";
    const penginapanRaw = cols[idxPenginapan] || "";
    const transKeberangkatanRaw = cols[idxTransKeberangkatan] || "";
    const transKepulanganRaw = cols[idxTransKepulangan] || "";

    const hasTransport = !isTidak(transKeberangkatanRaw) || !isTidak(transKepulanganRaw);
    const hasAkomodasi = !isTidak(penginapanRaw);
    const hasWahana = !isTidak(wahanaRaw);
    
    let mainImage = defaultImage;
    if (idxMainImage !== -1 && cols[idxMainImage] && (cols[idxMainImage].startsWith('http') || cols[idxMainImage].startsWith('"http') || cols[idxMainImage].startsWith('/'))) {
        mainImage = cols[idxMainImage];
    } else {
        const foundImg = cols.find(c => c && (c.startsWith('http') || c.startsWith('"http')));
        if (foundImg) mainImage = foundImg;
    }
    if (mainImage && mainImage.startsWith('"')) mainImage = mainImage.substring(1, mainImage.length-1);
    
    const priceAkomodasi = parseInt((cols[idxAkomodasi] || "0").replace(/[^\d]/g, ''), 10) || 0;
    const priceTransport = parseInt((cols[idxTransport] || "0").replace(/[^\d]/g, ''), 10) || 0;
    const priceWahana = parseInt((cols[idxHargaWahana] || "0").replace(/[^\d]/g, ''), 10) || 0;
    const priceLainnya = parseInt((cols[idxLainnya] || "0").replace(/[^\d]/g, ''), 10) || 0;
    
    return {
      title,
      slug: slugify(title),
      desc,
      dailyPrice,
      parsedDailyPrice,
      parsedWeeklyPrice,
      parsedMonthlyPrice,
      price,
      origin,
      destination,
      time,
      jenisLiburan,
      hasTransport,
      hasAkomodasi,
      hasWahana,
      badge: index === 0 ? "Hot Deal" : (index === 1 ? "Best Seller" : ""),
      badgeColor: index === 0 ? "bg-red-500 text-white" : (index === 1 ? "bg-blue-500 text-white" : ""),
      image: mainImage,
      priceAkomodasi,
      priceTransport,
      priceWahana,
      priceLainnya
    };
  });
} catch (error) {
  console.error("Failed to fetch packages:", error);
}
---

<Layout title="Featured Packages - DreamJourney">
    <main class="pt-20" data-is-logged-in={isLoggedIn ? 'true' : 'false'}>
        <section class="relative py-16 bg-cover bg-center" style="background-image: url('/images/bromo_hero_bg.png');">
            <!-- Overlay -->
            <div class="absolute inset-0" style="background-color: rgba(0,0,0,0.4);"></div>
            
            <div class="container mx-auto px-4 relative z-10">
                <div class="max-w-5xl mx-auto">
                    <!-- Search Bar with Interactive Autocomplete Dropdown -->
                    <div class="glass-card rounded-2xl p-5 md:p-6 mb-0 relative">
                        <h1 class="text-lg md:text-xl font-bold text-gray-800 mb-4 md:mb-6 text-center">Temukan Paket Perjalanan Terbaik</h1>
                        <div class="relative max-w-4xl mx-auto">
                            <div class="flex flex-col md:flex-row gap-3 md:gap-4">
                                <div class="flex-1 relative">
                                    <!-- Search Icon -->
                                    <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-blue-600">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                    </div>
                                    <input type="text" id="main-search-input" autocomplete="off" placeholder="Ketik nama kota atau destinasi (contoh: Bandung, Bali, Bromo)..." class="w-full pl-12 pr-10 py-3.5 md:py-3 border border-white/60 bg-white/95 backdrop-blur-sm rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all text-gray-800 placeholder-gray-400 shadow-sm font-medium text-sm md:text-base">
                                    
                                    <!-- Clear Input Button (X) -->
                                    <button type="button" id="search-clear-btn" class="hidden absolute inset-y-0 right-0 flex items-center pr-3.5 text-gray-400 hover:text-gray-600 transition cursor-pointer">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                        </svg>
                                    </button>
                                </div>
                                <button id="main-search-btn" class="tap-active bg-primary hover:bg-primary-dark text-white font-bold py-3.5 md:py-3 px-8 rounded-xl transition-smooth shadow-md w-full md:w-auto flex items-center justify-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                    </svg>
                                    <span>Cari</span>
                                </button>
                            </div>

                            <!-- Autocomplete Dropdown Popup -->
                            <div id="search-autocomplete-dropdown" class="hidden absolute top-full left-0 right-0 mt-3 bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl border border-gray-100 z-50 p-4 max-h-[460px] overflow-y-auto transition-all duration-200">
                                <div id="dropdown-results-container"></div>
                            </div>
                        </div>
                    </div>
            </div>
        </section>

        <section id="packages" class="py-10 bg-slate-50 min-h-screen">
            <div class="container mx-auto px-4 max-w-7xl">
                <!-- Promo Cashback Alert Banner -->
                <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-2xl p-4 md:p-5 mb-8 text-white shadow-lg flex flex-col md:flex-row items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="p-3 bg-white/20 backdrop-blur-md rounded-xl text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm md:text-base">Dapatkan Bonus Cashback & Diskon Eksklusif Paket Wisata!</h4>
                            <p class="text-xs text-blue-100">Menabung mulai hari ini untuk mengamankan harga tiket terendah & garansi berangkat 100%.</p>
                        </div>
                    </div>
                    <span class="text-xs bg-yellow-400 text-gray-900 font-bold px-3 py-1.5 rounded-lg whitespace-nowrap shadow-sm">
                        Promo Spesial 🎉
                    </span>
                </div>

                <!-- 2-COLUMN MAIN CONTENT (Left Filter Sidebar + Right Ticket Card List) -->
                <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
                    
                    <!-- LEFT SIDEBAR FILTER (1/4 width on desktop) -->
                    <aside class="lg:col-span-1 space-y-6">
                        <!-- 1. Map Widget Card -->
                        <div class="bg-white rounded-2xl p-4 border border-gray-200/80 shadow-sm relative overflow-hidden group">
                            <div class="h-28 rounded-xl bg-cover bg-center relative flex items-center justify-center" style="background-image: url('https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?q=80&w=600&auto=format&fit=crop');">
                                <div class="absolute inset-0 bg-blue-900/40 backdrop-blur-[1px] rounded-xl group-hover:bg-blue-900/50 transition"></div>
                                <button id="open-map-modal-btn" type="button" class="relative z-10 bg-white text-blue-700 hover:bg-blue-50 px-4 py-2 rounded-xl font-bold text-xs shadow-md flex items-center gap-2 transition transform group-hover:scale-105 cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                    <span>Tampilkan Peta</span>
                                </button>
                            </div>
                        </div>

                        <!-- 2. Price Range Filter Card -->
                        <div class="bg-white rounded-2xl p-5 border border-gray-200/80 shadow-sm space-y-4">
                            <div class="flex justify-between items-center pb-1 border-b border-gray-100">
                                <div>
                                    <h3 class="font-bold text-sm text-gray-900">Price Range</h3>
                                    <p id="price-range-subtitle" class="text-[11px] text-gray-400 font-medium">Rentang setoran tabungan harian</p>
                                </div>
                                <button type="button" id="price-range-reset" class="text-xs text-blue-600 font-semibold hover:underline cursor-pointer">Reset</button>
                            </div>

                            <!-- Frequency Mode Switcher Pills (Harian / Mingguan / Bulanan) -->
                            <div class="flex bg-gray-100 p-1 rounded-xl gap-1 text-[11px] font-semibold text-gray-500">
                                <button type="button" class="freq-tab-btn flex-1 py-1.5 rounded-lg text-center transition cursor-pointer bg-white text-blue-700 shadow-xs font-bold" data-freq="1">Harian</button>
                                <button type="button" class="freq-tab-btn flex-1 py-1.5 rounded-lg text-center transition cursor-pointer hover:text-gray-900" data-freq="7">Mingguan</button>
                                <button type="button" class="freq-tab-btn flex-1 py-1.5 rounded-lg text-center transition cursor-pointer hover:text-gray-900" data-freq="30">Bulanan</button>
                            </div>

                            <!-- Dual Range Slider Control -->
                            <div class="relative py-3 px-1">
                                <div class="relative w-full h-2 bg-gray-200 rounded-full">
                                    <div id="price-slider-track" class="absolute top-0 bottom-0 bg-blue-600 rounded-full transition-all duration-75" style="left: 0%; right: 0%;"></div>
                                </div>
                                <input type="range" id="price-slider-min" min="0" max="250000" step="5000" value="0" class="absolute top-1/2 -translate-y-1/2 left-0 w-full h-2 appearance-none bg-transparent pointer-events-none cursor-pointer z-30 [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-white [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-blue-600 [&::-webkit-slider-thumb]:shadow-md [&::-webkit-slider-thumb]:appearance-none">
                                <input type="range" id="price-slider-max" min="0" max="250000" step="5000" value="250000" class="absolute top-1/2 -translate-y-1/2 left-0 w-full h-2 appearance-none bg-transparent pointer-events-none cursor-pointer z-40 [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:w-5 [&::-webkit-slider-thumb]:h-5 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-white [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-blue-600 [&::-webkit-slider-thumb]:shadow-md [&::-webkit-slider-thumb]:appearance-none">
                            </div>

                            <!-- Grid Min - Max Input Boxes (Editable Manual Input) -->
                            <div class="grid grid-cols-2 gap-2.5 pt-1">
                                <div class="bg-gray-50/90 border border-gray-200/90 rounded-xl p-2.5 flex flex-col justify-center focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500/30 focus-within:border-blue-500 transition cursor-text">
                                    <span class="text-[9px] text-gray-400 font-bold uppercase tracking-wider">Minimal</span>
                                    <input type="text" id="price-min-input" value="IDR 0" class="w-full text-xs font-bold text-gray-900 bg-transparent outline-none truncate mt-0.5 cursor-text">
                                </div>
                                <div class="bg-gray-50/90 border border-gray-200/90 rounded-xl p-2.5 flex flex-col justify-center focus-within:bg-white focus-within:ring-2 focus-within:ring-blue-500/30 focus-within:border-blue-500 transition cursor-text">
                                    <span class="text-[9px] text-gray-400 font-bold uppercase tracking-wider">Maksimal</span>
                                    <input type="text" id="price-max-input" value="IDR 250.000" class="w-full text-xs font-bold text-gray-900 bg-transparent outline-none truncate mt-0.5 cursor-text">
