                                            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 mb-3">
                                                <span class="flex items-center gap-1 font-medium">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                                                    Keberangkatan {pkg.origin}
                                                </span>
                                                <span>•</span>
                                                <span class="flex items-center gap-1 font-medium">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                    {pkg.time || "Fleksibel"}
                                                </span>
                                            </div>

                                            <div class="flex flex-wrap gap-1.5 mb-3">
                                                {pkg.hasAkomodasi && (
                                                    <span class="text-[11px] bg-blue-50 text-blue-700 border border-blue-200/60 px-2 py-0.5 rounded-md font-semibold">🏨 Hotel / Penginapan</span>
                                                )}
                                                {pkg.hasTransport && (
                                                    <span class="text-[11px] bg-indigo-50 text-indigo-700 border border-indigo-200/60 px-2 py-0.5 rounded-md font-semibold">🚗 Transportasi</span>
                                                )}
                                                {pkg.hasWahana && (
                                                    <span class="text-[11px] bg-amber-50 text-amber-700 border border-amber-200/60 px-2 py-0.5 rounded-md font-semibold">🎟️ Tiket Rekreasi</span>
                                                )}
                                            </div>

                                            <p class="text-gray-500 text-xs line-clamp-2">{pkg.desc}</p>
                                        </div>

                                        <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between text-[11px] text-gray-400">
                                            <span>No. Tiket: DJ-77{10 + index}</span>
                                            <span class="text-emerald-600 font-semibold flex items-center gap-1">
                                                ✓ Garansi Berangkat 100%
                                            </span>
                                        </div>
                                    </div>

                                    <!-- RIGHT STUB: Pricing & Action Button (250px-270px width on desktop) -->
                                    <div class="w-full md:w-[250px] lg:w-[270px] bg-gradient-to-br from-blue-50/30 via-white to-slate-50 p-5 flex flex-col justify-between items-center md:items-end text-center md:text-right flex-shrink-0">
                                        <div>
                                            <div class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full text-[11px] font-bold mb-2">
                                                🏷️ Best Deal For You!
                                            </div>

                                            <p class="text-gray-400 text-xs line-through">Rp {Math.round(pkg.price * 1.15).toLocaleString('id-ID')}</p>

                                            <div class="price-display-text text-primary font-extrabold text-xl lg:text-2xl leading-tight">
                                                {pkg.dailyPrice}<span class="text-xs font-normal text-gray-500">/hari</span>
                                            </div>

                                            <p class="text-gray-500 text-[11px] mt-1 font-medium">Total: Rp {pkg.price.toLocaleString('id-ID')}</p>
                                            <p class="text-emerald-600 text-[10px] font-semibold">Bisa ditabung harian/mingguan/bulanan/acak</p>
                                        </div>

                                        <div class="w-full mt-4">
                                            <button class="w-full bg-primary hover:bg-primary-dark text-white py-2.5 px-4 rounded-xl font-bold text-xs md:text-sm shadow-md hover:shadow-lg transition-all tap-active start-saving-btn flex items-center justify-center gap-1.5 cursor-pointer">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H5z" />
                                                </svg>
                                                <span>Mulai Menabung</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </main>
                </div>
            </div>
        </section>
<!-- Leaflet Map CSS & JS -->
