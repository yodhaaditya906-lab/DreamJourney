<script define:vars={{ packages }}>
    window.__PACKAGES_DATA__ = packages;
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tipeTabunganQuick = document.getElementById('filter-tipe-tabungan-quick') as HTMLSelectElement;
        const sortSelect = document.getElementById('sort-price') as HTMLSelectElement;
        const packageCountEl = document.getElementById('package-count');
        
        const mainSearchInput = document.getElementById('main-search-input') as HTMLInputElement;
        const mainSearchBtn = document.getElementById('main-search-btn');
        const searchDropdown = document.getElementById('search-autocomplete-dropdown');
        const dropdownContainer = document.getElementById('dropdown-results-container');
        const searchClearBtn = document.getElementById('search-clear-btn');

        const rawPackages = (window as any).__PACKAGES_DATA__ || [];

        // Location Metadata
        const locationMeta: Record<string, { sub: string; type: string; image: string }> = {
            "Bandung": { sub: "Jawa Barat, Indonesia", type: "Kota", image: "https://images.unsplash.com/photo-1590559899147-eb54a69622df?q=80&w=600&auto=format&fit=crop" },
            "Bali": { sub: "Bali, Indonesia", type: "Destinasi", image: "https://images.unsplash.com/photo-1537996194471-e657df975ab4?q=80&w=600&auto=format&fit=crop" },
            "Jakarta": { sub: "DKI Jakarta, Indonesia", type: "Kota", image: "https://images.unsplash.com/photo-1555899434-94d1368aa7af?q=80&w=600&auto=format&fit=crop" },
            "Jogja": { sub: "DI Yogyakarta, Indonesia", type: "Kota", image: "https://images.unsplash.com/photo-1626125345510-4603468eedfb?q=80&w=600&auto=format&fit=crop" },
            "Yogyakarta": { sub: "DI Yogyakarta, Indonesia", type: "Kota", image: "https://images.unsplash.com/photo-1626125345510-4603468eedfb?q=80&w=600&auto=format&fit=crop" },
            "Lombok": { sub: "Nusa Tenggara Barat, Indonesia", type: "Destinasi", image: "https://images.unsplash.com/photo-1570784400788-b2a488667b45?q=80&w=600&auto=format&fit=crop" },
            "Bromo": { sub: "Jawa Timur, Indonesia", type: "Wisata Alam", image: "https://images.unsplash.com/photo-1602167732001-97b7b137a1f5?q=80&w=600&auto=format&fit=crop" },
            "Purwokerto": { sub: "Jawa Tengah, Indonesia", type: "Kota", image: "https://images.unsplash.com/photo-1596402184320-417e7178b2cd?q=80&w=600&auto=format&fit=crop" },
            "Surabaya": { sub: "Jawa Timur, Indonesia", type: "Kota", image: "https://images.unsplash.com/photo-1601999109332-542b18dbec57?q=80&w=600&auto=format&fit=crop" },
            "Raja Ampat": { sub: "Papua Barat, Indonesia", type: "Bahari", image: "https://images.unsplash.com/photo-1544551763-46a013bb70d5?q=80&w=600&auto=format&fit=crop" },
            "Labuan Bajo": { sub: "Nusa Tenggara Timur, Indonesia", type: "Destinasi", image: "https://images.unsplash.com/photo-1516690561799-46d8f74f9abf?q=80&w=600&auto=format&fit=crop" },
            "Dufan": { sub: "Ancol, Jakarta", type: "Wahana Rekreasi", image: "https://images.unsplash.com/photo-1513836279014-a89f7a76ae86?q=80&w=600&auto=format&fit=crop" }
        };

        const locCounts: Record<string, number> = {};
        const locImages: Record<string, string> = {};

        if (Array.isArray(rawPackages)) {
            rawPackages.forEach((pkg: any) => {
                const dest = (pkg.destination || "").trim();
                const title = (pkg.title || "").trim();

                if (dest && dest !== "Unknown") {
                    locCounts[dest] = (locCounts[dest] || 0) + 1;
                    if (!locImages[dest] && pkg.image) locImages[dest] = pkg.image;
                }

                Object.keys(locationMeta).forEach(loc => {
                    if (title.toLowerCase().includes(loc.toLowerCase()) && loc !== dest) {
                        locCounts[loc] = (locCounts[loc] || 0) + 1;
                        if (!locImages[loc] && pkg.image) locImages[loc] = pkg.image;
                    }
                });
            });
        }

        const availableLocations = Object.keys(locCounts).sort((a, b) => (locCounts[b] || 0) - (locCounts[a] || 0));
        const allLocationKeys = availableLocations.length > 0 ? availableLocations : Object.keys(locationMeta);

        function renderDropdown(searchTerm = "") {
            if (!dropdownContainer) return;
            const query = searchTerm.toLowerCase().trim();

            const filteredLocs = allLocationKeys.filter(loc => {
                const meta = locationMeta[loc] || {};
                return query === "" || 
                       loc.toLowerCase().includes(query) || 
                       (meta.sub && meta.sub.toLowerCase().includes(query)) ||
                       (meta.type && meta.type.toLowerCase().includes(query));
            });

            let html = "";

            if (filteredLocs.length > 0) {
                html += `<div class="mb-3"><h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider px-2 mb-2">Destinasi Sesuai Spreadsheet</h4><div class="space-y-1">`;
                
                filteredLocs.slice(0, 5).forEach(loc => {
                    const meta = locationMeta[loc] || { sub: "Indonesia", type: "Destinasi", image: locImages[loc] || "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600&auto=format&fit=crop" };
                    const count = locCounts[loc] || 1;
                    
                    html += `
                        <div class="suggestion-item flex items-center justify-between p-3 rounded-xl hover:bg-blue-50/80 cursor-pointer transition group" data-location="${loc}">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-blue-100 text-blue-600 rounded-xl group-hover:bg-blue-600 group-hover:text-white transition">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                                    </svg>
                                </div>
                                <div>
                                    <h4 class="font-bold text-gray-900 text-sm group-hover:text-blue-700 transition">${loc}</h4>
                                    <p class="text-xs text-gray-500">${meta.sub}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded-full font-medium group-hover:bg-blue-100 group-hover:text-blue-800 transition">${meta.type}</span>
                                <span class="text-xs bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold shadow-xs">${count} Paket Wisata</span>
                            </div>
                        </div>
                    `;
                });
                html += `</div></div>`;
            } else {
                html += `
                    <div class="p-4 text-center text-gray-500 text-sm">
                        Tidak ditemukan destinasi untuk "<span class="font-semibold text-gray-800">${searchTerm}</span>"
                    </div>
                `;
            }

            const popularCards = allLocationKeys.slice(0, 4);
            if (popularCards.length > 0) {
                html += `
                    <div class="pt-3 border-t border-gray-100">
                        <div class="flex justify-between items-center mb-2.5 px-2">
                            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Discover the best places to go</h4>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                `;

                popularCards.forEach(loc => {
                    const meta = locationMeta[loc] || { sub: "Indonesia", type: "Destinasi", image: locImages[loc] || "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600&auto=format&fit=crop" };
                    const count = locCounts[loc] || 1;
                    const img = meta.image || locImages[loc] || "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=600&auto=format&fit=crop";

                    html += `
                        <div class="suggestion-card relative rounded-xl overflow-hidden aspect-[4/3] group cursor-pointer shadow-xs hover:shadow-md transition" data-location="${loc}">
                            <img src="${img}" alt="${loc}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent p-2.5 flex flex-col justify-between">
                                <span class="self-start text-[10px] bg-black/50 backdrop-blur-xs text-white px-2 py-0.5 rounded-md font-semibold">${meta.type}</span>
                                <div>
                                    <span class="text-[11px] font-bold text-amber-300 block">${count} Paket</span>
                                    <h5 class="text-xs font-bold text-white leading-tight truncate">${loc}</h5>
                                </div>
                            </div>
                        </div>
                    `;
                });

                html += `</div></div>`;
            }

            dropdownContainer.innerHTML = html;

            const suggestionElements = dropdownContainer.querySelectorAll('.suggestion-item, .suggestion-card');
            suggestionElements.forEach(el => {
                el.addEventListener('click', () => {
                    const selectedLoc = el.getAttribute('data-location');
                    if (selectedLoc && mainSearchInput) {
                        mainSearchInput.value = selectedLoc;
                        if (searchClearBtn) searchClearBtn.classList.remove('hidden');
                        filterPackages();
                        hideDropdown();
                    }
                });
            });
        }

        function showDropdown() {
            if (searchDropdown) {
                renderDropdown(mainSearchInput ? mainSearchInput.value : "");
                searchDropdown.classList.remove('hidden');
            }
        }

        function hideDropdown() {
            if (searchDropdown) {
                searchDropdown.classList.add('hidden');
            }
        }

        // Price Range Slider Controls & Dynamic Frequency Presets
        const sliderMin = document.getElementById('price-slider-min') as HTMLInputElement;
        const sliderMax = document.getElementById('price-slider-max') as HTMLInputElement;
        const sliderTrack = document.getElementById('price-slider-track');
        const inputMin = document.getElementById('price-min-input') as HTMLInputElement;
        const inputMax = document.getElementById('price-max-input') as HTMLInputElement;
        const priceResetBtn = document.getElementById('price-range-reset');
        const sidebarResetBtn = document.getElementById('sidebar-reset-btn');
        const filterCheckboxes = document.querySelectorAll('.filter-checkbox') as NodeListOf<HTMLInputElement>;
        const freqTabBtns = document.querySelectorAll('.freq-tab-btn');
        const presetContainer = document.getElementById('preset-buttons-container');
        const priceSubtitle = document.getElementById('price-range-subtitle');

        let currentFreqMultiplier = 1; // 1 = Harian, 7 = Mingguan, 30 = Bulanan

        const presetsByFreq: Record<number, { label: string; min: number; max: number }[]> = {
            1: [
                { label: "< 10rb/hari", min: 0, max: 10000 },
                { label: "10rb - 50rb", min: 10000, max: 50000 },
                { label: "50rb - 100rb", min: 50000, max: 100000 },
                { label: "> 100rb/hari", min: 100000, max: 250000 }
            ],
            7: [
                { label: "< 350rb/minggu", min: 0, max: 350000 },
                { label: "350rb - 700rb", min: 350000, max: 700000 },
                { label: "> 700rb/minggu", min: 700000, max: 1750000 }
            ],
            30: [
                { label: "< 1,5 Jt/bulan", min: 0, max: 1500000 },
                { label: "1,5 Jt - 3 Jt", min: 1500000, max: 3000000 },
                { label: "> 3 Jt/bulan", min: 3000000, max: 7500000 }
            ]
        };

        const maxLimitByFreq: Record<number, number> = {
            1: 250000,
            7: 1750000,
            30: 7500000
        };

        function renderPresets(freq: number) {
            if (!presetContainer) return;
            const presets = presetsByFreq[freq] || presetsByFreq[1];
            const maxLim = maxLimitByFreq[freq] || 250000;

            let html = "";
            presets.forEach(p => {
                html += `<button type="button" class="preset-price-btn text-[11px] bg-gray-100 hover:bg-blue-50 hover:text-blue-700 font-semibold text-gray-600 px-2.5 py-1 rounded-lg transition cursor-pointer border border-transparent hover:border-blue-200" data-min="${p.min}" data-max="${p.max}">${p.label}</button>`;
            });

            presetContainer.innerHTML = html;

            presetContainer.querySelectorAll('.preset-price-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const min = btn.getAttribute('data-min') || "0";
                    const max = btn.getAttribute('data-max') || maxLim.toString();
                    if (sliderMin && sliderMax) {
                        sliderMin.value = min;
                        sliderMax.value = max;
                        updateSliderFill();
                    }
                });
            });
        }

        function updateSliderFill(updateInputs = true) {
            if (!sliderMin || !sliderMax || !sliderTrack) return;
            const maxLim = maxLimitByFreq[currentFreqMultiplier] || 250000;
            let minVal = parseInt(sliderMin.value);
            let maxVal = parseInt(sliderMax.value);

            if (minVal > maxVal - (maxLim * 0.02)) {
                minVal = Math.max(0, maxVal - (maxLim * 0.02));
                sliderMin.value = minVal.toString();
            }

            const percentMin = (minVal / maxLim) * 100;
            const percentMax = 100 - ((maxVal / maxLim) * 100);

            sliderTrack.style.left = `${percentMin}%`;
            sliderTrack.style.right = `${percentMax}%`;

            if (updateInputs) {
                if (inputMin && document.activeElement !== inputMin) {
                    inputMin.value = `IDR ${new Intl.NumberFormat('id-ID').format(minVal)}`;
                }
                if (inputMax && document.activeElement !== inputMax) {
                    inputMax.value = `IDR ${new Intl.NumberFormat('id-ID').format(maxVal)}`;
                }
            }

            filterPackages();
        }

        function setupManualInputEditing(inputEl: HTMLInputElement, isMin: boolean) {
            if (!inputEl) return;

            const getCleanNumber = (val: string) => {
                const clean = val.replace(/[^\d]/g, '');
                return clean ? parseInt(clean, 10) : 0;
            };

            inputEl.addEventListener('focus', () => {
                const num = getCleanNumber(inputEl.value);
                inputEl.value = num === 0 ? "" : new Intl.NumberFormat('id-ID').format(num);
                inputEl.select();
            });

            inputEl.addEventListener('input', () => {
                const num = getCleanNumber(inputEl.value);
                const maxLim = maxLimitByFreq[currentFreqMultiplier] || 250000;

                if (num > 0) {
                    inputEl.value = new Intl.NumberFormat('id-ID').format(num);
                } else {
                    inputEl.value = "";
                }

                if (isMin && sliderMin) {
                    sliderMin.value = Math.min(num, maxLim).toString();
                } else if (!isMin && sliderMax) {
                    sliderMax.value = Math.min(num, maxLim).toString();
                }

                updateSliderFill(false);
            });

            const applyFormat = () => {
                const num = getCleanNumber(inputEl.value);
                const maxLim = maxLimitByFreq[currentFreqMultiplier] || 250000;
                
                let clampedNum = num;
                if (isMin && sliderMax) {
                    const currentMax = parseInt(sliderMax.value);
                    clampedNum = Math.min(num, currentMax);
                    if (sliderMin) sliderMin.value = clampedNum.toString();
                } else if (!isMin && sliderMin) {
                    const currentMin = parseInt(sliderMin.value);
                    clampedNum = Math.max(num, currentMin);
                    clampedNum = Math.min(clampedNum, maxLim);
                    if (sliderMax) sliderMax.value = clampedNum.toString();
                }

                inputEl.value = `IDR ${new Intl.NumberFormat('id-ID').format(clampedNum)}`;
                updateSliderFill(true);
            };

            inputEl.addEventListener('blur', applyFormat);
            inputEl.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    applyFormat();
                    inputEl.blur();
                }
            });
        }

        if (inputMin) setupManualInputEditing(inputMin, true);
        if (inputMax) setupManualInputEditing(inputMax, false);

        function setFrequencyMode(freq: number, updateQuickSelect = true) {
            currentFreqMultiplier = freq;
            const maxLim = maxLimitByFreq[freq] || 250000;

            if (sliderMin && sliderMax) {
                sliderMin.max = maxLim.toString();
                sliderMax.max = maxLim.toString();
                const stepVal = freq === 1 ? "100" : (freq === 7 ? "500" : "1000");
                sliderMin.step = stepVal;
                sliderMax.step = stepVal;
                sliderMin.value = "0";
                sliderMax.value = maxLim.toString();
            }

            if (priceSubtitle) {
                const labelMap: Record<number, string> = { 1: 'harian', 7: 'mingguan', 30: 'bulanan' };
                priceSubtitle.textContent = `Rentang setoran tabungan ${labelMap[freq] || 'harian'}`;
            }

            freqTabBtns.forEach(btn => {
                const f = parseInt(btn.getAttribute('data-freq') || "1");
                if (f === freq) {
                    btn.classList.add('bg-white', 'text-blue-700', 'shadow-xs', 'font-bold');
                    btn.classList.remove('hover:text-gray-900', 'text-gray-500');
                } else {
                    btn.classList.remove('bg-white', 'text-blue-700', 'shadow-xs', 'font-bold');
                    btn.classList.add('text-gray-500', 'hover:text-gray-900');
                }
            });

            if (updateQuickSelect && tipeTabunganQuick) {
                tipeTabunganQuick.value = freq.toString();
            }

            renderPresets(freq);
            updateSliderFill();
        }

        freqTabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const freq = parseInt(btn.getAttribute('data-freq') || "1");
                setFrequencyMode(freq);
            });
        });

        if (sliderMin && sliderMax) {
            sliderMin.addEventListener('input', updateSliderFill);
            sliderMax.addEventListener('input', updateSliderFill);
        }

        if (priceResetBtn) {
            priceResetBtn.addEventListener('click', () => {
                setFrequencyMode(currentFreqMultiplier);
            });
        }

        if (sidebarResetBtn) {
            sidebarResetBtn.addEventListener('click', () => {
                if (mainSearchInput) mainSearchInput.value = "";
                if (searchClearBtn) searchClearBtn.classList.add('hidden');
                filterCheckboxes.forEach(cb => cb.checked = false);
                setFrequencyMode(1);
            });
        }

        filterCheckboxes.forEach(cb => {
            cb.addEventListener('change', filterPackages);
        });

        function filterPackages() {
            const query = mainSearchInput ? mainSearchInput.value.toLowerCase().trim() : "";
            const activeTabunganVal = tipeTabunganQuick ? tipeTabunganQuick.value : "1";
            const tabunganMultiplier = parseInt(activeTabunganVal) || 1;
            const sortMode = sortSelect ? sortSelect.value : "";

            const maxLim = maxLimitByFreq[currentFreqMultiplier] || 250000;
            const minVal = sliderMin ? parseInt(sliderMin.value) : 0;
            const maxVal = sliderMax ? parseInt(sliderMax.value) : maxLim;

            const selectedCategories: string[] = [];
            const selectedFacilities: string[] = [];
            filterCheckboxes.forEach(cb => {
                if (cb.checked) {
                    const val = cb.value.toLowerCase();
                    if (val.startsWith('facility_')) {
                        selectedFacilities.push(val);
                    } else {
                        selectedCategories.push(val);
                    }
                }
            });

            const resultsHeading = document.getElementById('results-heading');
            if (resultsHeading) {
                if (query) {
                    resultsHeading.textContent = `Paket Wisata di ${mainSearchInput.value.trim()}`;
                } else {
                    resultsHeading.textContent = `Semua Paket Wisata Impian`;
                }
            }

            const packageItems = document.querySelectorAll('.package-item') as NodeListOf<HTMLElement>;
            let visibleCount = 0;

            packageItems.forEach(item => {
                const title = (item.getAttribute('data-title') || "").toLowerCase();
                const origin = (item.getAttribute('data-origin') || "").toLowerCase();
                const destination = (item.getAttribute('data-destination') || "").toLowerCase();
                const fullText = item.textContent ? item.textContent.toLowerCase() : "";

                const baseDailyPrice = parseInt(item.getAttribute('data-daily-price') || "0");
                const baseWeeklyPrice = parseInt(item.getAttribute('data-weekly-price') || "0");
                const baseMonthlyPrice = parseInt(item.getAttribute('data-monthly-price') || "0");
                const itemPrice = parseInt(item.getAttribute('data-price') || "0");
                
                let itemDailyPrice = baseDailyPrice;
                if (tabunganMultiplier === 7) {
                    itemDailyPrice = baseWeeklyPrice || (baseDailyPrice * 7);
                } else if (tabunganMultiplier === 30) {
                    itemDailyPrice = baseMonthlyPrice || (baseDailyPrice * 30);
                }

                if (itemPrice > 0 && (itemDailyPrice > itemPrice || baseDailyPrice === 0)) {
                    itemDailyPrice = itemPrice;
                }

                const priceTextEl = item.querySelector('.price-display-text');
                if (priceTextEl) {
                    const suffix = (itemDailyPrice === itemPrice && itemPrice <= 300000) ? ' total' : (tabunganMultiplier === 1 ? '/hari' : (tabunganMultiplier === 7 ? '/minggu' : '/bulan'));
                    const formatted = new Intl.NumberFormat('id-ID').format(itemDailyPrice);
                    priceTextEl.innerHTML = `Rp ${formatted}<span class="text-xs font-normal text-gray-500">${suffix}</span>`;
                }

                const matchesQuery = query === "" || 
                                     destination.includes(query) || 
                                     title.includes(query);

                const matchesPrice = itemDailyPrice >= minVal && (maxVal >= maxLim || itemDailyPrice <= maxVal);

                const jenisAttr = (item.getAttribute('data-jenis') || "").toLowerCase();
                const timeAttr = (item.getAttribute('data-time') || "").toLowerCase();

                const matchesCategory = selectedCategories.length === 0 || selectedCategories.some(cat => {
                    const catLower = cat.toLowerCase();
                    if (catLower === 'bebas' || catLower.includes('tiket')) {
                        return jenisAttr.includes('bebas') || 
                               jenisAttr.includes('tiket') || 
                               baseDailyPrice === 0 || 
                               title.includes('tiket') || 
                               fullText.includes('bebas');
                    }
                    return jenisAttr.includes(catLower) || title.includes(catLower) || fullText.includes(catLower);
                });

                const hasTransport = item.getAttribute('data-has-transport') === 'true';
                const hasAkomodasi = item.getAttribute('data-has-akomodasi') === 'true';
                const hasWahana = item.getAttribute('data-has-wahana') === 'true';

                let matchesFacility = true;
                if (selectedFacilities.includes('facility_transport') && !hasTransport) matchesFacility = false;
                if (selectedFacilities.includes('facility_akomodasi') && !hasAkomodasi) matchesFacility = false;
                if (selectedFacilities.includes('facility_wahana') && !hasWahana) matchesFacility = false;

                if (matchesQuery && matchesPrice && matchesCategory && matchesFacility) {
                    item.classList.remove('hidden');
                    visibleCount++;
                } else {
                    item.classList.add('hidden');
                }
            });

            if (packageCountEl) {
                packageCountEl.textContent = `Menampilkan ${visibleCount} tiket perjalanan`;
            }

            const container = document.getElementById('packages-container');
            if (container) {
                const itemsArray = Array.from(packageItems);
                if (sortMode === "asc") {
                    itemsArray.sort((a, b) => {
                        const priceA = parseInt(a.getAttribute('data-daily-price') || "0");
                        const priceB = parseInt(b.getAttribute('data-daily-price') || "0");
                        return priceA - priceB;
                    });
                } else if (sortMode === "desc") {
                    itemsArray.sort((a, b) => {
                        const priceA = parseInt(a.getAttribute('data-daily-price') || "0");
                        const priceB = parseInt(b.getAttribute('data-daily-price') || "0");
                        return priceB - priceA;
                    });
                } else {
                    itemsArray.sort((a, b) => {
                        const idxA = parseInt(a.getAttribute('data-index') || "0");
                        const idxB = parseInt(b.getAttribute('data-index') || "0");
                        return idxA - idxB;
                    });
                }
                itemsArray.forEach(item => container.appendChild(item));
            }
        }

        if (tipeTabunganQuick) {
            tipeTabunganQuick.addEventListener('change', () => {
                const freq = parseInt(tipeTabunganQuick.value) || 1;
                setFrequencyMode(freq, false);
            });
        }

        // Initialize Frequency Mode
        setFrequencyMode(1);

        // READ SEARCH PARAMETER FROM URL (e.g. /packages?search=Bandung)
        const urlParams = new URLSearchParams(window.location.search);
        const initialSearch = urlParams.get('search') || urlParams.get('q') || urlParams.get('dest') || "";

        if (initialSearch && mainSearchInput) {
            mainSearchInput.value = initialSearch;
            if (searchClearBtn) searchClearBtn.classList.remove('hidden');
            filterPackages();
        }

        if (mainSearchInput) {
            mainSearchInput.addEventListener('focus', showDropdown);
            mainSearchInput.addEventListener('input', () => {
                const val = mainSearchInput.value;
                if (searchClearBtn) {
                    if (val.trim() !== '') searchClearBtn.classList.remove('hidden');
                    else searchClearBtn.classList.add('hidden');
                }
                showDropdown();
                filterPackages();
            });
            mainSearchInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    hideDropdown();
                    filterPackages();
                }
            });
        }

        if (searchClearBtn) {
            searchClearBtn.addEventListener('click', () => {
                if (mainSearchInput) {
                    mainSearchInput.value = '';
                    searchClearBtn.classList.add('hidden');
                    filterPackages();
                    showDropdown();
                    mainSearchInput.focus();
                }
            });
        }

        if (mainSearchBtn) {
            mainSearchBtn.addEventListener('click', () => {
                hideDropdown();
                filterPackages();
            });
        }

        if (tipeTabunganQuick) {
            tipeTabunganQuick.addEventListener('change', filterPackages);
        }

        if (sortSelect) {
            sortSelect.addEventListener('change', filterPackages);
        }

        document.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (searchDropdown && !searchDropdown.contains(target) && mainSearchInput && !mainSearchInput.contains(target)) {
                hideDropdown();
            }
        });

        // Entire Package Card Click Listener (Navigates to detail page except when Mulai Menabung button is clicked)
        document.querySelectorAll('.package-item').forEach(item => {
            item.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                if (target.closest('.start-saving-btn')) {
                    return; // Ignore card click if Mulai Menabung button was pressed
                }
                const slug = item.getAttribute('data-slug');
                if (slug) {
                    window.location.href = `/package/${slug}`;
                }
            });
        });

        // Start Saving Button listener
        const startSavingBtns = document.querySelectorAll('.start-saving-btn');
        startSavingBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                
                const mainEl = document.querySelector('main');
                const isLoggedIn = mainEl?.getAttribute('data-is-logged-in') === 'true';
                if (!isLoggedIn) {
                    const modal = document.getElementById('custom-login-modal');
                    if (modal) modal.classList.remove('hidden');
                    return;
                }

                const item = (e.target as HTMLElement).closest('.package-item');
                if (!item) return;
                
                const title = item.getAttribute('data-title') || '';
                const price = item.getAttribute('data-price') || '0';
                const dailyPrice = item.getAttribute('data-daily-price') || '0';
                const weeklyPrice = item.getAttribute('data-weekly-price') || '0';
                const monthlyPrice = item.getAttribute('data-monthly-price') || '0';
                const time = item.getAttribute('data-time') || '';

                const ak = parseInt(item.getAttribute('data-akomodasi') || '0');
                const tr = parseInt(item.getAttribute('data-transport') || '0');
                const wh = parseInt(item.getAttribute('data-wahana') || '0');
                const ln = parseInt(item.getAttribute('data-lainnya') || '0');
                const hasCustomBreakdown = (ak + tr + wh + ln) > 0;
                
                const imgEl = item.querySelector('img');
                const image = imgEl ? imgEl.getAttribute('src') : '';
                
                const query = new URLSearchParams({
                    title, price, dailyPrice, weeklyPrice, monthlyPrice, time, image: image || '',
                    akomodasi: (hasCustomBreakdown ? ak : parseInt(price) * 0.45).toString(),
                    transport: (hasCustomBreakdown ? tr : 0).toString(),
                    wahana: (hasCustomBreakdown ? wh : parseInt(price) * 0.30).toString(),
                    lainnya: (hasCustomBreakdown ? ln : parseInt(price) * 0.25).toString()
                }).toString();
                
                window.location.href = `/setup-saving?${query}`;
            });
        });

        // --- MAP MODAL & LEAFLET LOGIC ---
        const openMapModalBtn = document.getElementById('open-map-modal-btn');
        const closeMapModalBtn = document.getElementById('close-map-modal-btn');
        const mapModal = document.getElementById('map-modal');
        const mapShowAllBtn = document.getElementById('map-show-all-btn');
        const mapCityPills = document.querySelectorAll('.map-city-pill');

        let leafletMapObj: any = null;
        let markersGroup: any = null;

        const cityCoordsMap: Record<string, [number, number]> = {
            "jakarta": [-6.2088, 106.8456],
            "bandung": [-6.9175, 107.6191],
            "yogyakarta": [-7.7956, 110.3695],
            "jogja": [-7.7956, 110.3695],
            "bali": [-8.4095, 115.1889],
            "denpasar": [-8.6705, 115.2126],
            "lombok": [-8.6509, 116.3249],
            "malang": [-7.9666, 112.6326],
            "bromo": [-7.9425, 112.9530],
            "probolinggo": [-7.7543, 113.2159],
            "labuan bajo": [-8.4539, 119.8728],
            "semarang": [-6.9666, 110.4167],
            "surabaya": [-7.2575, 112.7521],
            "karimunjawa": [-5.8481, 110.4361],
            "raja ampat": [-0.2333, 130.5167]
        };

        function filterByCityFromMap(cityName: string) {
            if (mainSearchInput) {
                mainSearchInput.value = cityName;
                if (searchClearBtn) searchClearBtn.classList.remove('hidden');
            }
            filterPackages();
            closeMap();
            const container = document.getElementById('packages-container');
            if (container) {
                container.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        (window as any).filterByCityFromMap = filterByCityFromMap;

        function initLeafletMap() {
            if (!(window as any).L) return;
            const L = (window as any).L;

            if (!leafletMapObj) {
                leafletMapObj = L.map('leaflet-map').setView([-2.5489, 118.0149], 5);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 18,
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(leafletMapObj);
                markersGroup = L.layerGroup().addTo(leafletMapObj);
            }

            markersGroup.clearLayers();

            const packageItems = document.querySelectorAll('.package-item') as NodeListOf<HTMLElement>;
            const addedCoords = new Set<string>();

            packageItems.forEach(item => {
                const destination = item.getAttribute('data-destination') || item.getAttribute('data-title') || "";
                const title = item.getAttribute('data-title') || "";
                const image = item.querySelector('img')?.src || "";
                const destLower = destination.toLowerCase().trim();

                let coords: [number, number] | null = null;
                for (const [key, val] of Object.entries(cityCoordsMap)) {
                    if (destLower.includes(key) || title.toLowerCase().includes(key)) {
                        coords = val;
                        break;
                    }
                }

                if (!coords) {
                    coords = [-6.2088, 106.8456];
                }

                const coordKey = `${coords[0]},${coords[1]}`;
                if (!addedCoords.has(coordKey)) {
                    addedCoords.add(coordKey);

                    const customIcon = L.divIcon({
                        className: 'custom-map-pin',
                        html: `<div class="bg-blue-600 text-white font-extrabold text-xs px-2.5 py-1 rounded-full shadow-lg border-2 border-white flex items-center gap-1 cursor-pointer hover:bg-blue-800 hover:scale-110 transition transform">📍 ${destination}</div>`,
                        iconSize: [120, 30],
                        iconAnchor: [60, 15]
                    });

                    const marker = L.marker(coords, { icon: customIcon }).addTo(markersGroup);
                    
                    const popupHtml = `
                        <div class="p-1 max-w-[200px] font-sans">
                            <img src="${image}" class="w-full h-24 object-cover rounded-lg mb-2 shadow-xs">
                            <h4 class="font-extrabold text-xs text-gray-900 leading-snug mb-1">${title}</h4>
                            <p class="text-[11px] text-blue-600 font-bold mb-2">📍 ${destination}</p>
                            <button onclick="filterByCityFromMap('${destination}')" class="w-full bg-blue-600 text-white text-xs font-bold py-1.5 rounded-lg hover:bg-blue-700 transition cursor-pointer">
                                Lihat Paket ${destination}
                            </button>
                        </div>
                    `;

                    marker.bindPopup(popupHtml);
                }
            });

            setTimeout(() => {
                leafletMapObj.invalidateSize();
            }, 200);
        }

        function openMap() {
            if (mapModal) {
                mapModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
                initLeafletMap();
            }
        }

        function closeMap() {
            if (mapModal) {
                mapModal.classList.add('hidden');
                document.body.style.overflow = '';
            }
        }

        if (openMapModalBtn) openMapModalBtn.addEventListener('click', openMap);
        if (closeMapModalBtn) closeMapModalBtn.addEventListener('click', closeMap);

        if (mapModal) {
            mapModal.addEventListener('click', (e) => {
                if (e.target === mapModal) closeMap();
            });
        }

        if (mapShowAllBtn) {
            mapShowAllBtn.addEventListener('click', () => {
                if (mainSearchInput) mainSearchInput.value = "";
                if (searchClearBtn) searchClearBtn.classList.add('hidden');
                filterPackages();
                closeMap();
            });
        }

        mapCityPills.forEach(pill => {
            pill.addEventListener('click', () => {
                const city = pill.getAttribute('data-city') || "";
                filterByCityFromMap(city);
            });
        });
    });
</script>
