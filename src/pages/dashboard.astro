---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import { fetchCachedCSV } from '../lib/fetchCache';

const { userId } = Astro.locals.auth();

if (!userId) {
    return Astro.redirect('/');
}

const clerkUser = await Astro.locals.currentUser();
if (clerkUser) {
    const hasDomisili = clerkUser.unsafeMetadata?.domisili;
    const hasDob = clerkUser.unsafeMetadata?.dob;
    
    if (!hasDomisili || !hasDob) {
        return Astro.redirect('/onboarding?redirect_url=/dashboard');
    }
}

// 1. Get user data
let { data: user } = await supabase.from('users').select('*').eq('id', userId).single();
if (!user) {
    // If not exists, create it
    await supabase.from('users').insert({ id: userId });
    user = { id: userId, balance: 0, lentera_id: null };
}

// 2. Get goals
const { data: goalsData } = await supabase.from('goals').select('*').eq('user_id', userId).order('created_at', { ascending: false });
const goals = goalsData || [];

// 3. Get transactions (limit to 20)
const { data: transactionsData } = await supabase.from('transactions').select('*').eq('user_id', userId).order('created_at', { ascending: false }).limit(20);
const transactions = transactionsData || [];

function parseCSVRow(r: string) {
    const result = [];
    let curVal = '';
    let inQuotes = false;
    for (let i = 0; i < r.length; i++) {
        if (r[i] === '"') {
            inQuotes = !inQuotes;
        } else if (r[i] === ',' && !inQuotes) {
            result.push(curVal.trim());
            curVal = '';
        } else {
            curVal += r[i];
        }
    }
    result.push(curVal.trim());
    return result;
}

// --- FETCH DATA TABUNGAN DARI GOOGLE SHEET ---
const GOOGLE_SHEET_TABUNGAN_URL = "https://docs.google.com/spreadsheets/d/1RQkDKebj_FXnFZnom5JazwHz0f0JLKupHuWu8tebzZo/export?format=csv";
let tabunganMap = new Map<string, { totalAmount: number; savingType?: string }>();
try {
    const res = await fetch(GOOGLE_SHEET_TABUNGAN_URL);
    if (res.ok) {
        const csv = await res.text();
        const allRows = csv.split('\n').filter(r => r.trim());

        if (allRows.length > 0) {
            const headers = parseCSVRow(allRows[0]);
            const idxId = headers.findIndex(h => h.toLowerCase().includes('id target') || h.toLowerCase().includes('id'));
            const idxType = headers.findIndex(h => h.toLowerCase().includes('tipe tabungan') || h.toLowerCase().includes('tipe'));

            const startSetoranIdx = idxType !== -1 ? idxType + 1 : (idxId !== -1 ? idxId + 1 : 1);

            allRows.slice(1).forEach(row => {
                const cols = parseCSVRow(row);
                if (cols.length > 0) {
                    const goalId = cols[idxId !== -1 ? idxId : 0].replace(/"/g, '').trim();
                    const savingType = (idxType !== -1 && cols[idxType]) ? cols[idxType].replace(/"/g, '').trim() : undefined;

                    let totalAmount = 0;
                    for (let i = startSetoranIdx; i < cols.length; i++) {
                        const valStr = cols[i].replace(/[^\d]/g, '');
                        const val = parseInt(valStr, 10);
                        if (!isNaN(val)) {
                            totalAmount += val;
                        }
                    }

                    if (goalId) {
                        tabunganMap.set(goalId, { totalAmount, savingType });
                    }
                }
            });
        }
    }
} catch (e) {
    console.error("Gagal mengambil data tabungan dari Sheet", e);
}

// Map Supabase snake_case back to camelCase for UI
const wallet = {
    isLinked: goals.length > 0,
    balance: user.balance || 0,
    lenteraId: user.lentera_id,
    goals: goals.map((g: any) => ({
        id: g.id,
        title: g.title,
        targetAmount: g.target_amount,
        autoDebitAmount: g.auto_debit_amount,
        autoDebitFrequency: g.frequency === '1' ? 'Harian' : (g.frequency === '7' ? 'Mingguan' : (g.frequency === '30' ? 'Bulanan' : g.frequency)),
        paymentMethod: g.payment_method,
        paymentDetail: g.payment_detail,
        tripType: g.trip_type,
        savingType: (tabunganMap.has(g.id.toString()) && tabunganMap.get(g.id.toString())?.savingType)
            ? tabunganMap.get(g.id.toString())!.savingType
            : g.saving_type,
        groupMembers: g.group_members || [],
        savedAmount: tabunganMap.has(g.id.toString()) ? tabunganMap.get(g.id.toString())!.totalAmount : (g.saved_amount || 0),
        createdAt: g.created_at
    })),
    transactions: transactions.map((t: any) => ({
        id: t.id,
        type: t.type,
        amount: t.amount,
        desc: t.description,
        date: t.created_at
    }))
};

// --- GOAL SUMMARY STATS & COUNTS ---
const activeGoalsCount = wallet.goals.length;
const soloGoalsCount = wallet.goals.filter((g: any) => g.tripType === 'Solo' || !g.groupMembers || g.groupMembers.length === 0).length;
const groupGoalsCount = wallet.goals.filter((g: any) => g.tripType === 'Group' || g.tripType === 'Couple' || (g.groupMembers && g.groupMembers.length > 0)).length;
const completedGoalsCount = wallet.goals.filter((g: any) => g.savedAmount >= g.targetAmount).length;

// --- FETCH GROUP MEMBERS PROFILES & PROGRESS ---
let groupMemberProfilesMap = new Map<string, { username: string; fullName: string; avatarUrl: string | null; userGoals: any[] }>();
const allGroupUsernames = Array.from(new Set(wallet.goals.flatMap((g: any) => g.groupMembers || [])));

if (allGroupUsernames.length > 0) {
    const { data: dbMembers } = await supabase.from('users').select('id, username, full_name').in('username', allGroupUsernames);
    if (dbMembers && dbMembers.length > 0) {
        const memberIds = dbMembers.map(m => m.id);
        const { data: dbMemberGoals } = await supabase.from('goals').select('user_id, title, saved_amount, target_amount').in('user_id', memberIds);

        const clerkSecretKey = import.meta.env.CLERK_SECRET_KEY || process.env.CLERK_SECRET_KEY;

        await Promise.all(dbMembers.map(async (m) => {
            let avatarUrl: string | null = null;
            let fullName = m.full_name || m.username;

            if (clerkSecretKey && m.id) {
                try {
                    const cRes = await fetch(`https://api.clerk.com/v1/users/${m.id}`, {
                        headers: { 'Authorization': `Bearer ${clerkSecretKey}` }
                    });
                    if (cRes.ok) {
                        const cData = await cRes.json();
                        avatarUrl = cData.image_url || cData.profile_image_url || null;
                        if (!fullName || fullName === m.username) {
                            const combined = `${cData.first_name || ''} ${cData.last_name || ''}`.trim();
                            if (combined) fullName = combined;
                        }
                    }
                } catch (e) {
                    console.warn("Clerk fetch error for member:", e);
                }
            }

            const uGoals = (dbMemberGoals || []).filter(g => g.user_id === m.id);
            groupMemberProfilesMap.set(m.username.toLowerCase(), {
                username: m.username,
                fullName: fullName,
                avatarUrl: avatarUrl,
                userGoals: uGoals
            });
        }));
    }
}

// Calculate total saved amount across all goals
const totalSaved = wallet.goals.reduce((acc: number, goal: any) => acc + (goal.savedAmount || 0), 0);
const displayBalance = totalSaved; // Balance reflects total saved

// Helper for formatting currency
const formatRp = (num: number) => `Rp ${num.toLocaleString('id-ID')}`;

// Format date relative or simple
const formatDate = (dateStr: string) => {
    const d = new Date(dateStr);
    return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
};

// --- LENTERA DATA FETCHING ---
let lenteras: any[] = [];
try {
  const csvText = await fetchCachedCSV('https://docs.google.com/spreadsheets/d/1qie-zXXTH6xqEn_oxlZEQYCU2DDGmQn_ACWZNFI7xOM/export?format=csv');
  
  const rows = csvText.split('\n').slice(1);
  lenteras = rows.filter(row => row.trim() && !row.startsWith(',')).map(row => {
      const cols = parseCSVRow(row);
      return {
          id: cols[0] || "",
          name: cols[1] || "Unknown",
          desc: cols[2] || "",
          image: cols[3] || "https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=200",
          telegram: cols[4] || "#",
          line: cols[5] || "#",
          color: cols[6] || "bg-blue-100 text-blue-600"
      };
  });
} catch (error) {
  console.error("Failed to fetch lentera data:", error);
}

const activeLentera = lenteras.find(l => l.id === wallet.lenteraId);

// --- MITRA DATA FETCHING ---
let mitraMap = new Map();
try {
  const mitraCsvText = await fetchCachedCSV('https://docs.google.com/spreadsheets/d/1iF_gSErDUz9kMnDiSSgySE1gePeoFRmTdRffdQ4A9ys/export?format=csv');
  const mitraRows = mitraCsvText.split('\n');
  if (mitraRows.length > 0) {
      const headers = parseCSVRow(mitraRows[0]);
      const idxId = headers.findIndex(h => h.toLowerCase().includes('id'));
      const idxName = headers.findIndex(h => h.toLowerCase().includes('nama'));
      const idxWa = headers.findIndex(h => h.toLowerCase().includes('wa') || h.toLowerCase().includes('whatsapp') || h.toLowerCase().includes('hp') || h.toLowerCase().includes('telepon'));

      mitraRows.slice(1).forEach(row => {
          if (!row.trim() || row.startsWith(',')) return;
          const cols = parseCSVRow(row);
          const id = (cols[idxId !== -1 ? idxId : 1] || '').trim();
          const name = (cols[idxName !== -1 ? idxName : 2] || '').trim();
          const waRaw = (cols[idxWa !== -1 ? idxWa : 4] || '').trim().replace(/[^\d]/g, '');
          const wa = waRaw.startsWith('0') ? '62' + waRaw.slice(1) : waRaw;
          if (id) {
              mitraMap.set(id.toLowerCase(), { id, name, wa });
          }
      });
  }
} catch (error) {
  console.error("Failed to fetch mitra data:", error);
}

// --- PACKAGE DATA FETCHING FOR DEPARTURE DATES ---
let packageMap = new Map();
try {
  const pkgCsvText = await fetchCachedCSV('https://docs.google.com/spreadsheets/d/1eD4zbqYsW-Ce6eLemIUt5VdSIykWnlhM0kwTVBgD1Yw/export?format=csv');
  const pkgRows = pkgCsvText.split('\n');
  if (pkgRows.length > 0) {
      const headers = parseCSVRow(pkgRows[0]);
      const idxTitle = headers.findIndex(h => h.toLowerCase().includes('title'));
      const idxTanggal = headers.findIndex(h => h.toLowerCase().includes('tanggal pergi'));
      const idxHitung = headers.findIndex(h => h.toLowerCase().includes('hitung mundur liburan'));
      
      pkgRows.slice(1).forEach(row => {
          if (!row.trim() || row.startsWith(',')) return;
          const cols = parseCSVRow(row);
          const title = (cols[idxTitle !== -1 ? idxTitle : 0] || '').trim();
          const tanggalPergi = (cols[idxTanggal !== -1 ? idxTanggal : 25] || '').trim();
          const hitungMundur = (cols[idxHitung !== -1 ? idxHitung : 24] || '').trim();
          if (title) {
              packageMap.set(title.toLowerCase(), { tanggalPergi, hitungMundur });
          }
      });
  }
} catch (e) {
  console.error("Failed to fetch package data for departure estimation:", e);
}
---

<Layout title="Savings Dashboard - DreamJourney">
    <main class="pt-20 bg-slate-50/50 min-h-screen">
        <section class="py-10">
            <div class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-10">
                <!-- Dashboard Header Title -->
                <div class="mb-8 text-center md:text-left">
                    <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Dashboard Tabungan</h1>
                    <p class="text-xs md:text-sm text-slate-500 mt-1">Pantau perkembangan tabungan & rencana perjalanan impian Anda secara real-time.</p>
                </div>
                
                <!-- Financial Summary Balance Card & Sub-Stats -->
                <div class="bg-white border border-slate-200/80 rounded-2xl p-6 md:p-8 shadow-sm mb-8">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
                        <div>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider block mb-1">Total Tabungan Tersimpan</span>
                            <div class="text-3xl md:text-4xl font-black text-primary tracking-tight">{formatRp(displayBalance)}</div>
                        </div>
                        <div class="inline-flex items-center gap-2 bg-blue-50/80 border border-blue-100 text-primary px-4 py-2 rounded-xl text-xs font-bold shadow-2xs">
                            <i data-feather="shield-check" class="w-4 h-4"></i>
                            <span>Dana Tersimpan Aman & Terverifikasi</span>
                        </div>
                    </div>

                    <!-- Ringkasan Detail Perjalanan (Sub-Stats Grid) -->
                    <div class="pt-5 border-t border-slate-100 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                        <div class="bg-slate-50/90 p-3.5 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Target Aktif</span>
                            <span class="text-sm md:text-base font-extrabold text-slate-900 mt-0.5 block">{activeGoalsCount} Perjalanan</span>
                        </div>
                        <div class="bg-slate-50/90 p-3.5 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Solo Trip</span>
                            <span class="text-sm md:text-base font-extrabold text-slate-900 mt-0.5 block">{soloGoalsCount} Target</span>
                        </div>
                        <div class="bg-slate-50/90 p-3.5 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Tim / Group</span>
                            <span class="text-sm md:text-base font-extrabold text-slate-900 mt-0.5 block">{groupGoalsCount} Target</span>
                        </div>
                        <div class="bg-slate-50/90 p-3.5 rounded-xl border border-slate-200/60">
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Tercapai 100%</span>
                            <span class="text-sm md:text-base font-extrabold text-emerald-600 mt-0.5 block">{completedGoalsCount} Target</span>
                        </div>
                    </div>
                </div>

                <!-- Main Content Grid (70% Target Aktif / 30% Riwayat Aktivitas) -->
                <div class="grid grid-cols-1 lg:grid-cols-10 gap-6 lg:gap-8 mb-12">
                    
                    <!-- LEFT COLUMN: Target Aktif (70% Width) -->
                    <div class="lg:col-span-7 bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200/80">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
                            <h3 class="text-lg md:text-xl font-black text-slate-900 flex items-center gap-2.5">
                                <i data-feather="target" class="w-5 h-5 text-primary"></i> Target Aktif
                            </h3>
                            
                            <!-- Filter Buttons for Target Aktif -->
                            <div id="goal-filter-switcher" class="flex items-center p-1 bg-slate-100/90 rounded-xl border border-slate-200/70 text-xs font-semibold">
                                <button type="button" class="goal-filter-btn flex-1 px-2.5 py-1 rounded-lg transition-all bg-white text-primary font-bold shadow-2xs cursor-pointer text-center" data-filter="all">Semua ({activeGoalsCount})</button>
                                <button type="button" class="goal-filter-btn flex-1 px-2.5 py-1 rounded-lg transition-all text-slate-500 hover:text-slate-900 cursor-pointer text-center" data-filter="solo">Solo ({soloGoalsCount})</button>
                                <button type="button" class="goal-filter-btn flex-1 px-2.5 py-1 rounded-lg transition-all text-slate-500 hover:text-slate-900 cursor-pointer text-center" data-filter="group">Tim ({groupGoalsCount})</button>
                            </div>
                        </div>
                        
                        <div id="goals-list-container" class="space-y-6">
                            {wallet.goals.length === 0 ? (
                                <div class="text-center py-10 text-slate-500 bg-slate-50 rounded-xl border border-dashed border-slate-200">
                                    <i data-feather="flag" class="w-8 h-8 mx-auto mb-2 text-slate-400"></i>
                                    <p class="text-sm font-semibold">Belum ada target liburan aktif.</p>
                                    <a href="/packages" class="text-xs text-primary font-bold hover:underline mt-2 inline-block">Mulai Rencanakan Liburan Sekarang →</a>
                                </div>
                            ) : (
                                wallet.goals.map((goal: any, index: number) => {
                                    const percentage = Math.min(100, Math.round((goal.savedAmount / goal.targetAmount) * 100));

                                    // --- ESTIMATION CALCULATION ---
                                    const remainingAmount = Math.max(0, goal.targetAmount - goal.savedAmount);
                                    let remainingCycles = 0;
                                    if (goal.autoDebitAmount > 0) {
                                        remainingCycles = Math.ceil(remainingAmount / goal.autoDebitAmount);
                                    }
                                    
                                    let daysPerCycle = 30; // default Bulanan
                                    if (goal.autoDebitFrequency === 'Harian') daysPerCycle = 1;
                                    else if (goal.autoDebitFrequency === 'Mingguan') daysPerCycle = 7;
                                    
                                    const daysLeft = remainingCycles * daysPerCycle;
                                    
                                    const estimatedDate = new Date();
                                    estimatedDate.setDate(estimatedDate.getDate() + daysLeft);
                                    const dateOptions: Intl.DateTimeFormatOptions = { day: 'numeric', month: 'short', year: 'numeric' };
                                    const formattedDate = estimatedDate.toLocaleDateString('id-ID', dateOptions);
                                    const isAcakFreq = goal.autoDebitFrequency?.includes('Acak') || goal.autoDebitAmount === 0;
                                    const freqBadgeText = isAcakFreq ? 'Acak (Sesuka Hati)' : `${goal.autoDebitFrequency} (${formatRp(goal.autoDebitAmount)})`;
                                    
                                    // Check departure date from Google Sheet package
                                    const pkgInfo = packageMap.get(goal.title.toLowerCase().trim());
                                    const hasSheetDeparture = pkgInfo && pkgInfo.hitungMundur !== "0" && pkgInfo.tanggalPergi && !pkgInfo.tanggalPergi.toLowerCase().includes("tidak") && pkgInfo.tanggalPergi !== "-";
                                    
                                    let sheetDisplayDate = '';
                                    if (hasSheetDeparture) {
                                        sheetDisplayDate = pkgInfo.tanggalPergi;
                                        try {
                                            const parsedDate = new Date(pkgInfo.tanggalPergi);
                                            if (!isNaN(parsedDate.getTime())) {
                                                sheetDisplayDate = parsedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
                                            }
                                        } catch (e) {}
                                    }

                                     // --- DEPOSIT FREQUENCY & LAST DEPOSIT CALCULATION ---
                                    const goalTransactions = wallet.transactions.filter((t: any) => 
                                        t.desc?.toLowerCase().includes(goal.title.toLowerCase()) || 
                                        t.desc?.toLowerCase().includes(goal.id.toString().toLowerCase())
                                    );

                                    let lastDepositDate: Date | null = null;
                                    if (goalTransactions.length > 0) {
                                        const dates = goalTransactions.map((t: any) => new Date(t.date).getTime());
                                        lastDepositDate = new Date(Math.max(...dates));
                                    } else if (goal.savedAmount > 0) {
                                        lastDepositDate = new Date(goal.createdAt || Date.now());
                                    }

                                    const now = new Date();
                                    let depositStatusBadge = { text: '', colorClass: '', icon: '', isWarning: false };

                                    const freqType = goal.autoDebitFrequency;
                                    const isHarian = freqType === 'Harian';
                                    const isMingguan = freqType === 'Mingguan';
                                    const isBulanan = freqType === 'Bulanan';

                                    if (isHarian) {
                                        const hasSavedToday = lastDepositDate ? (
                                            lastDepositDate.getFullYear() === now.getFullYear() &&
                                            lastDepositDate.getMonth() === now.getMonth() &&
                                            lastDepositDate.getDate() === now.getDate()
                                        ) : false;

                                        if (hasSavedToday) {
                                            depositStatusBadge = {
                                                text: 'Sudah Menabung Hari Ini',
                                                colorClass: 'bg-emerald-50/90 text-emerald-800 border-emerald-200',
                                                icon: 'check-circle',
                                                isWarning: false
                                            };
                                        } else {
                                            depositStatusBadge = {
                                                text: 'Belum Menabung Hari Ini',
                                                colorClass: 'bg-amber-50/90 text-amber-800 border-amber-200',
                                                icon: 'alert-circle',
                                                isWarning: true
                                            };
                                        }
                                    } else if (isMingguan) {
                                        const getMonday = (d: Date) => {
                                            const date = new Date(d);
                                            const day = date.getDay();
                                            const diff = date.getDate() - day + (day === 0 ? -6 : 1);
                                            const m = new Date(date.setDate(diff));
                                            m.setHours(0,0,0,0);
                                            return m;
                                        };
                                        const hasSavedThisWeek = lastDepositDate ? (
                                            getMonday(lastDepositDate).getTime() === getMonday(now).getTime()
                                        ) : false;

                                        if (hasSavedThisWeek) {
                                            depositStatusBadge = {
                                                text: 'Sudah Menabung Minggu Ini',
                                                colorClass: 'bg-emerald-50/90 text-emerald-800 border-emerald-200',
                                                icon: 'check-circle',
                                                isWarning: false
                                            };
                                        } else {
                                            depositStatusBadge = {
                                                text: 'Belum Menabung Minggu Ini',
                                                colorClass: 'bg-amber-50/90 text-amber-800 border-amber-200',
                                                icon: 'alert-circle',
                                                isWarning: true
                                            };
                                        }
                                    } else if (isBulanan) {
                                        const hasSavedThisMonth = lastDepositDate ? (
                                            lastDepositDate.getFullYear() === now.getFullYear() &&
                                            lastDepositDate.getMonth() === now.getMonth()
                                        ) : false;

                                        if (hasSavedThisMonth) {
                                            depositStatusBadge = {
                                                text: 'Sudah Menabung Bulan Ini',
                                                colorClass: 'bg-emerald-50/90 text-emerald-800 border-emerald-200',
                                                icon: 'check-circle',
                                                isWarning: false
                                            };
                                        } else {
                                            depositStatusBadge = {
                                                text: 'Belum Menabung Bulan Ini',
                                                colorClass: 'bg-amber-50/90 text-amber-800 border-amber-200',
                                                icon: 'alert-circle',
                                                isWarning: true
                                            };
                                        }
                                    } else {
                                        if (lastDepositDate) {
                                            const diffMs = now.getTime() - lastDepositDate.getTime();
                                            const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
                                            let dateFormatted = '';
                                            if (diffDays === 0) dateFormatted = 'Hari ini';
                                            else if (diffDays === 1) dateFormatted = 'Kemarin';
                                            else if (diffDays < 7) dateFormatted = `${diffDays} hari yang lalu`;
                                            else dateFormatted = lastDepositDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });

                                            depositStatusBadge = {
                                                text: `Terakhir Menabung: ${dateFormatted}`,
                                                colorClass: 'bg-slate-50 text-slate-700 border-slate-200',
                                                icon: 'clock',
                                                isWarning: false
                                            };
                                        } else {
                                            depositStatusBadge = {
                                                text: 'Terakhir Menabung: Belum ada setoran',
                                                colorClass: 'bg-slate-50 text-slate-600 border-slate-200',
                                                icon: 'clock',
                                                isWarning: false
                                            };
                                        }
                                    }

                                    const isGroupTrip = goal.tripType === 'Group' || goal.tripType === 'Couple' || (goal.groupMembers && goal.groupMembers.length > 0);

                                    return (
                                        <div class="goal-item-card" data-trip-type={isGroupTrip ? 'group' : 'solo'}>
                                            {index > 0 && (
                                                <div class="my-8 relative flex items-center justify-center">
                                                    <div class="w-full border-t-2 border-dashed border-slate-200"></div>
                                                    <div class="absolute bg-white px-3 py-0.5 text-slate-400 text-xs font-semibold flex items-center gap-1.5 rounded-full border border-slate-200/80 shadow-2xs">
                                                        <i data-feather="scissors" class="w-3.5 h-3.5 transform -rotate-90 text-slate-400"></i>
                                                        <span class="text-[9px] uppercase tracking-widest text-slate-400 font-extrabold">Potong Di Sini</span>
                                                    </div>
                                                </div>
                                            )}

                                            <div class="flex justify-between items-baseline mb-2">
                                                <h4 class="font-bold text-slate-900 text-base">{goal.title}</h4>
                                                <span class="text-sm font-extrabold text-primary">{percentage}%</span>
                                            </div>

                                            <div class="w-full bg-slate-100 rounded-full h-2.5 mb-2 overflow-hidden">
                                                <div class="bg-primary h-2.5 rounded-full transition-all duration-700" style={`width: ${percentage}%`}></div>
                                            </div>

                                            <div class="flex justify-between items-center text-xs text-slate-500 mb-3">
                                                <span>{formatRp(goal.savedAmount)} / {formatRp(goal.targetAmount)}</span>
                                                <span class="font-semibold text-slate-600">{freqBadgeText}</span>
                                            </div>
                                            
                                            <!-- Estimasi Keberangkatan Box -->
                                            <div class="mt-2 bg-slate-50 text-slate-700 text-xs px-3.5 py-2.5 rounded-xl flex items-center border border-slate-200/70 font-medium">
                                                <i data-feather="calendar" class="w-3.5 h-3.5 mr-2 text-primary"></i>
                                                {hasSheetDeparture ? (
                                                    <span>Estimasi Keberangkatan: <strong>{sheetDisplayDate}</strong> ({pkgInfo.hitungMundur} hari lagi)</span>
                                                ) : percentage >= 100 ? (
                                                    <span>Target tercapai! Siap berangkat kapan saja. ✈️</span>
                                                ) : isAcakFreq ? (
                                                    <span>Estimasi Keberangkatan: <strong>Fleksibel (Menabung Acak)</strong></span>
                                                ) : (
                                                    <span>Estimasi Keberangkatan: <strong>{formattedDate}</strong> ({daysLeft} hari lagi)</span>
                                                )}
                                            </div>
                                            
                                            <!-- Status Menabung Indicator Badge -->
                                            <div class={`mt-2 text-xs px-3.5 py-2 rounded-xl flex items-center justify-between gap-2 border font-bold whitespace-nowrap overflow-hidden ${depositStatusBadge.colorClass}`}>
                                                <div class="flex items-center gap-1.5 min-w-0 truncate whitespace-nowrap">
                                                    <i data-feather={depositStatusBadge.icon} class="w-4 h-4 shrink-0"></i>
                                                    <span class="truncate whitespace-nowrap">Status Tabungan: <strong>{depositStatusBadge.text}</strong></span>
                                                </div>
                                                {depositStatusBadge.isWarning && (
                                                    <span class="shrink-0 text-[10px] uppercase tracking-wider bg-amber-100 text-amber-900 px-2 py-0.5 rounded font-extrabold whitespace-nowrap">Waktunya Setor</span>
                                                )}
                                            </div>
                                            
                                            <!-- Clean Neutral Tags for Trip Details -->
                                            <div class="flex flex-wrap gap-2 mt-3">
                                                <span class="bg-slate-100 text-slate-700 border border-slate-200/60 text-[11px] px-2.5 py-1 rounded-lg font-semibold flex items-center">
                                                    <i data-feather={goal.tripType === 'Solo' ? 'user' : 'users'} class="w-3 h-3 mr-1 text-slate-500"></i>
                                                    {goal.tripType === 'Solo' ? 'Solo' : goal.tripType} Trip
                                                </span>
                                                
                                                <span class="bg-slate-100 text-slate-700 border border-slate-200/60 text-[11px] px-2.5 py-1 rounded-lg font-semibold flex items-center">
                                                    <i data-feather="box" class="w-3 h-3 mr-1 text-slate-500"></i>
                                                    {goal.savingType || 'Konvensional'}
                                                </span>
                                                
                                                <span class="bg-slate-100 text-slate-700 border border-slate-200/60 text-[11px] px-2.5 py-1 rounded-lg font-semibold flex items-center">
                                                    <i data-feather={goal.paymentMethod === 'Cash' ? 'briefcase' : 'credit-card'} class="w-3 h-3 mr-1 text-slate-500"></i> 
                                                    {goal.paymentMethod === 'Cash' ? 'Mitra' : 'Cashless'}: {goal.paymentDetail ? goal.paymentDetail.split('|||')[0] : '-'}
                                                </span>
                                            </div>

                                            <!-- Group Members Section (Vertical List) -->
                                            {goal.groupMembers && goal.groupMembers.length > 0 && (
                                                <div class="mt-4 bg-slate-50/80 rounded-xl p-3.5 border border-slate-200/70 space-y-3">
                                                    <div class="flex items-center justify-between">
                                                        <h4 class="text-xs font-extrabold text-slate-800 flex items-center gap-1.5 uppercase tracking-wider">
                                                            <i data-feather="users" class="w-3.5 h-3.5 text-primary"></i>
                                                            Anggota Tim ({goal.groupMembers.length + 1} Orang)
                                                        </h4>
                                                        <span class="text-[10px] font-bold text-slate-400">Progress Tabungan</span>
                                                    </div>

                                                    <div class="space-y-2 divide-y divide-slate-200/60">
                                                        {/* Render Current Logged-in User First */}
                                                        {(() => {
                                                            const currentUserSaved = goal.savedAmount || 0;
                                                            const target = goal.targetAmount || 1;
                                                            const currentPct = Math.min(100, Math.round((currentUserSaved / target) * 100));
                                                            const userFullName = clerkUser?.fullName || user?.full_name || 'Saya';
                                                            const userAvatar = clerkUser?.imageUrl || null;
                                                            const userHandle = `@${user?.username || clerkUser?.username || 'saya'}`;

                                                            return (
                                                                <div class="flex items-center justify-between gap-3 pt-1">
                                                                    <div class="flex items-center gap-2.5 min-w-0">
                                                                        {userAvatar ? (
                                                                            <img src={userAvatar} alt={userFullName} class="w-8 h-8 rounded-full object-cover border border-slate-200 shadow-2xs shrink-0" />
                                                                        ) : (
                                                                            <div class="w-8 h-8 rounded-full bg-blue-600 text-white font-bold text-xs flex items-center justify-center shrink-0">
                                                                                {userFullName.charAt(0).toUpperCase()}
                                                                            </div>
                                                                        )}
                                                                        <div class="min-w-0">
                                                                            <p class="text-xs font-bold text-slate-900 truncate flex items-center gap-1">
                                                                                <span>{userFullName}</span>
                                                                                <span class="bg-blue-50 text-primary text-[9px] px-1.5 py-0.2 rounded font-extrabold border border-blue-100">Saya</span>
                                                                            </p>
                                                                            <p class="text-[10px] text-slate-400 truncate">{userHandle}</p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="text-right shrink-0">
                                                                        <span class="text-xs font-extrabold text-primary">{currentPct}%</span>
                                                                        <p class="text-[10px] text-slate-500 font-medium">{formatRp(currentUserSaved)}</p>
                                                                    </div>
                                                                </div>
                                                            );
                                                        })()}

                                                        {/* Render Other Group Members Vertically */}
                                                        {goal.groupMembers.map((memberUsername: string) => {
                                                            const profile = groupMemberProfilesMap.get(memberUsername.toLowerCase());
                                                            const mFullName = profile?.fullName || `@${memberUsername}`;
                                                            const mAvatar = profile?.avatarUrl || null;
                                                            
                                                            let mSaved = 0;
                                                            if (profile && profile.userGoals) {
                                                                const matched = profile.userGoals.find((g: any) => g.title === goal.title);
                                                                if (matched) mSaved = matched.saved_amount || 0;
                                                            }
                                                            const target = goal.targetAmount || 1;
                                                            const mPct = Math.min(100, Math.round((mSaved / target) * 100));

                                                            return (
                                                                <div class="flex items-center justify-between gap-3 pt-2">
                                                                    <div class="flex items-center gap-2.5 min-w-0">
                                                                        {mAvatar ? (
                                                                            <img src={mAvatar} alt={mFullName} class="w-8 h-8 rounded-full object-cover border border-slate-200 shadow-2xs shrink-0" />
                                                                        ) : (
                                                                            <div class="w-8 h-8 rounded-full bg-slate-600 text-white font-bold text-xs flex items-center justify-center shrink-0">
                                                                                {memberUsername.charAt(0).toUpperCase()}
                                                                            </div>
                                                                        )}
                                                                        <div class="min-w-0">
                                                                            <p class="text-xs font-bold text-slate-900 truncate">{mFullName}</p>
                                                                            <p class="text-[10px] text-slate-400 truncate">@{memberUsername}</p>
                                                                        </div>
                                                                    </div>
                                                                    <div class="text-right shrink-0">
                                                                        <span class="text-xs font-extrabold text-slate-700">{mPct}%</span>
                                                                        <p class="text-[10px] text-slate-500 font-medium">{formatRp(mSaved)}</p>
                                                                    </div>
                                                                </div>
                                                            );
                                                        })}
                                                    </div>
                                                </div>
                                            )}
                                            
                                            <!-- Action Links -->
                                            <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs font-semibold">
                                                <a href={`/goal-detail/${goal.id}`} class="text-primary hover:text-blue-700 transition flex items-center gap-1">
                                                    <i data-feather="file-text" class="w-3.5 h-3.5"></i> Rincian Biaya
                                                </a>
                                                <a href={`/cancel-trip/${goal.id}`} class="text-red-600 hover:text-red-800 transition flex items-center gap-1">
                                                    <i data-feather="x-circle" class="w-3.5 h-3.5"></i> Batalkan Target
                                                </a>
                                            </div>
                                            
                                            <!-- Main Action Button -->
                                            {(() => {
                                                const isMitra = goal.paymentMethod === 'Cash' || (goal.paymentDetail && goal.paymentDetail.toLowerCase().includes('mitra'));
                                                let waNumber = '6287896108664';
                                                let waButtonText = 'Setor via WA (QRIS)';
                                                const nominalText = (goal.autoDebitAmount && goal.autoDebitAmount > 0 && !isAcakFreq) ? `Rp ${goal.autoDebitAmount.toLocaleString('id-ID')}` : 'Tidak Ditentukan';
                                                let waText = `Halo Admin DreamJourney! Saya ingin setor tabungan untuk destinasi ${goal.title}.\n\nID Target: ${goal.id}\nNominal: ${nominalText}\nMohon info QRIS-nya ya, terima kasih!`;

                                                if (isMitra) {
                                                    let mitraId: string | null = null;
                                                    if (goal.paymentDetail) {
                                                        const match = goal.paymentDetail.match(/Mitra ID:\s*([A-Za-z0-9]+)/i);
                                                        if (match) {
                                                            mitraId = match[1].trim().toLowerCase();
                                                        } else {
                                                            mitraId = goal.paymentDetail.split('|||')[0].trim().toLowerCase();
                                                        }
                                                    }
                                                    const mitraObj = mitraId ? mitraMap.get(mitraId) : null;
                                                    if (mitraObj && mitraObj.wa) {
                                                        waNumber = mitraObj.wa;
                                                    }
                                                    const mitraNameText = mitraObj ? `${mitraObj.name}` : 'Mitra';
                                                    waButtonText = `Chat Mitra (${mitraNameText}) via WhatsApp`;
                                                    waText = `Halo Mitra DreamJourney (${mitraNameText})!\n\nSaya ingin melakukan setoran tunai untuk target tabungan saya:\n• Destinasi: ${goal.title}\n• ID Target: ${goal.id}\n• Nominal Setoran: ${nominalText}\n\nMohon bantuannya untuk proses setoran tunai ini ya. Terima kasih!`;
                                                }

                                                const hasAlreadySavedCycle = !depositStatusBadge.isWarning && !isAcakFreq && goal.autoDebitFrequency !== 'Acak (Sesuka Hati)';
                                                let cyclePeriodText = 'Periode Ini';
                                                if (isHarian) cyclePeriodText = 'Hari Ini';
                                                else if (isMingguan) cyclePeriodText = 'Minggu Ini';
                                                else if (isBulanan) cyclePeriodText = 'Bulan Ini';

                                                return (
                                                    <div class="mt-3">
                                                        {isMitra ? (
                                                            <a href={`https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`} target="_blank" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition shadow-sm cursor-pointer text-xs">
                                                                <i data-feather="message-circle" class="w-4 h-4"></i>
                                                                <span>{waButtonText}</span>
                                                            </a>
                                                        ) : (
                                                            hasAlreadySavedCycle ? (
                                                                <div class="bg-emerald-50 text-emerald-800 font-bold text-xs text-center py-3 px-4 rounded-xl border border-emerald-200/80 flex items-center justify-center gap-2 cursor-not-allowed">
                                                                    <i data-feather="check-circle" class="w-4 h-4 text-emerald-600"></i>
                                                                    <span>Anda Sudah Menabung {cyclePeriodText}</span>
                                                                </div>
                                                            ) : (
                                                                <div class="space-y-2">
                                                                    {(() => {
                                                                        const payAmount = goal.autoDebitAmount > 0 ? goal.autoDebitAmount : (goal.targetAmount - goal.savedAmount);
                                                                        const qrisUrl = `/payment/qris?goalId=${encodeURIComponent(goal.id)}&amount=${payAmount}&title=${encodeURIComponent(goal.title)}&image=${encodeURIComponent(goal.packageImage || '')}&frequency=${encodeURIComponent(goal.autoDebitFrequency || 'Mingguan')}`;
                                                                        return (
                                                                            <a href={qrisUrl}
                                                                               target="_blank"
                                                                               rel="noopener noreferrer"
                                                                               class="w-full bg-primary hover:bg-blue-700 text-white font-bold py-3 rounded-xl flex items-center justify-center gap-2 transition shadow-sm cursor-pointer text-xs">
                                                                                <i data-feather="qr-code" class="w-4 h-4"></i> Bayar Setoran (Bayar QRIS)
                                                                            </a>
                                                                        );
                                                                    })()}
                                                                    <a href={`https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`} target="_blank" class="w-full bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold py-2 rounded-xl flex items-center justify-center gap-2 transition border border-slate-200 text-xs">
                                                                        <i data-feather="message-circle" class="w-3.5 h-3.5"></i> Setor via WA Admin
                                                                    </a>
                                                                </div>
                                                            )
                                                        )}
                                                    </div>
                                                );
                                            })()}
                                        </div>
                                    );
                                })
                            )}
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: Riwayat Aktivitas (30% Width) -->
                    <div class="lg:col-span-3 bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-slate-200/80 flex flex-col h-full">
                        <h3 class="text-base md:text-lg font-black text-slate-900 mb-6 flex items-center gap-2.5">
                            <i data-feather="clock" class="w-4.5 h-4.5 text-primary shrink-0"></i>
                            <span>Riwayat Aktivitas</span>
                        </h3>
                        
                        <div class="space-y-3.5 flex-1 overflow-y-auto pr-1 max-h-[650px]">
                            {wallet.transactions.length === 0 ? (
                                <p class="text-center text-slate-400 italic py-8 text-xs">Belum ada riwayat aktivitas transaksi.</p>
                            ) : (
                                wallet.transactions.map((trx: any) => {
                                    let icon = "activity";
                                    let iconColor = "bg-slate-100 text-slate-600";
                                    if (trx.type === 'DEPOSIT' || trx.type === 'SETORAN' || trx.type === 'SETORAN_MITRA') {
                                        icon = "arrow-up-right";
                                        iconColor = "bg-emerald-50 text-emerald-600 border border-emerald-100";
                                    } else if (trx.type === 'WITHDRAWAL' || trx.type === 'PENARIKAN') {
                                        icon = "arrow-down-left";
                                        iconColor = "bg-amber-50 text-amber-600 border border-amber-100";
                                    } else if (trx.type === 'GOAL_CREATED') {
                                        icon = "flag";
                                        iconColor = "bg-blue-50 text-primary border border-blue-100";
                                    }

                                    return (
                                        <div class="flex items-center justify-between p-3.5 bg-slate-50/70 rounded-xl border border-slate-200/60 hover:bg-slate-50 transition gap-2">
                                            <div class="flex items-center gap-3 min-w-0 pr-1">
                                                <div class={`p-2 rounded-lg ${iconColor} shrink-0`}>
                                                    <i data-feather={icon} class="w-4 h-4"></i>
                                                </div>
                                                <div class="min-w-0">
                                                    <p class="text-xs font-bold text-slate-900 leading-snug truncate">{trx.desc || 'Transaksi Tabungan'}</p>
                                                    <p class="text-[10px] text-slate-400 mt-0.5">{formatDate(trx.date)}</p>
                                                </div>
                                            </div>
                                            {trx.amount > 0 && (
                                                <span class="text-xs font-extrabold text-emerald-600 shrink-0">
                                                    + {formatRp(trx.amount)}
                                                </span>
                                            )}
                                        </div>
                                    );
                                })
                            )}
                        </div>
                    </div>

                </div>

                <!-- LENTERA SECTION -->
                <div class="max-w-4xl mx-auto bg-white p-6 md:p-8 rounded-xl shadow-lg border border-gray-100 mb-12">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="font-bold text-2xl flex items-center text-gray-800">
                            <i data-feather="heart" class="mr-3 text-red-500"></i> Pendamping Lentera Anda
                        </h3>
                        {activeLentera && (
                            <button id="btn-change-lentera" class="text-sm font-semibold text-blue-600 hover:text-blue-800 flex items-center transition">
                                <i data-feather="repeat" class="w-4 h-4 mr-1"></i> Ganti Lentera
                            </button>
                        )}
                    </div>

                    {!activeLentera ? (
                        <div>
                            <p class="text-gray-600 mb-6 text-sm">Pilih satu pendamping (Lentera) yang akan memotivasi Anda mencapai target tabungan impian Anda!</p>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6" id="lentera-gallery">
                                {lenteras.map((lentera) => (
                                    <div class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-primary hover:shadow-xl transition-all duration-300 group flex flex-col hover:-translate-y-1">
                                        <div class="h-40 w-full overflow-hidden relative">
                                            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition z-10"></div>
                                            <img src={lentera.image} alt={lentera.name} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                                        </div>
                                        <div class="p-5 flex flex-col flex-grow text-center">
                                            <h4 class="font-bold text-xl text-gray-900 mb-2">{lentera.name}</h4>
                                            <p class="text-sm text-gray-500 mb-6 flex-grow">{lentera.desc}</p>
                                            <button class="btn-select-lentera w-full bg-blue-50 text-blue-600 hover:bg-primary hover:text-white font-bold py-2.5 rounded-lg transition mt-auto shadow-sm" data-id={lentera.id}>
                                                Pilih {lentera.name}
                                            </button>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ) : (
                        <div class="flex flex-col md:flex-row items-center gap-8 bg-blue-50/50 p-6 rounded-xl border border-blue-100" id="active-lentera-view">
                            <img src={activeLentera.image} alt={activeLentera.name} class="w-32 h-32 rounded-full object-cover border-4 border-white shadow-md">
                            <div class="flex-1 text-center md:text-left">
                                <span class="bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full inline-block mb-2">Lentera Aktif</span>
                                <h4 class="font-bold text-3xl text-gray-800 mb-2">{activeLentera.name}</h4>
                                <p class="text-gray-600 italic mb-4">"{activeLentera.desc}"</p>
                                
                                <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                                    <a href={activeLentera.telegram} target="_blank" class="bg-[#0088cc] hover:bg-[#007ab8] text-white font-bold py-2.5 px-5 rounded-lg flex items-center transition shadow-sm">
                                        <i data-feather="message-circle" class="w-4 h-4 mr-2"></i> Chat Telegram
                                    </a>
                                    <a href={activeLentera.line} target="_blank" class="bg-[#06C755] hover:bg-[#05b34c] text-white font-bold py-2.5 px-5 rounded-lg flex items-center transition shadow-sm">
                                        <i data-feather="message-square" class="w-4 h-4 mr-2"></i> Chat Line
                                    </a>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </section>
    </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        // Lentera Selection Logic
        const lenteraBtns = document.querySelectorAll('.btn-select-lentera');
        lenteraBtns.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const target = e.currentTarget as HTMLElement;
                const lenteraId = target.getAttribute('data-id');
                if (!lenteraId) return;

                target.innerHTML = '<i data-feather="loader" class="w-4 h-4 animate-spin mx-auto"></i>';
                
                try {
                    const res = await fetch('/api/wallet', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'SET_LENTERA', lenteraId })
                    });
                    
                    if (res.ok) {
                        window.location.reload();
                    }
                } catch (e) {
                    console.error(e);
                    alert("Gagal menyimpan Lentera.");
                }
            });
        });

        const btnChangeLentera = document.getElementById('btn-change-lentera');
        if (btnChangeLentera) {
            btnChangeLentera.addEventListener('click', async () => {
                const confirmChange = confirm("Anda yakin ingin mengganti pendamping Lentera Anda?");
                if (!confirmChange) return;

                btnChangeLentera.innerHTML = '<i data-feather="loader" class="w-4 h-4 animate-spin"></i>';
                try {
                    const res = await fetch('/api/wallet', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'SET_LENTERA', lenteraId: "" })
                    });
                    
                    if (res.ok) {
                        window.location.reload();
                    }
                } catch (e) {
                    console.error(e);
                }
            });
        }

        // --- GOAL FILTER TAB SWITCHER ---
        const goalFilterBtns = document.querySelectorAll('.goal-filter-btn');
        const goalCards = document.querySelectorAll('.goal-item-card');

        goalFilterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const filter = btn.getAttribute('data-filter');

                goalFilterBtns.forEach(b => {
                    b.classList.remove('bg-white', 'text-primary', 'font-bold', 'shadow-2xs');
                    b.classList.add('text-slate-500');
                });

                btn.classList.add('bg-white', 'text-primary', 'font-bold', 'shadow-2xs');
                btn.classList.remove('text-slate-500');

                goalCards.forEach(card => {
                    const cardType = card.getAttribute('data-trip-type');
                    if (filter === 'all' || cardType === filter) {
                        (card as HTMLElement).style.display = 'block';
                    } else {
                        (card as HTMLElement).style.display = 'none';
                    }
                });
            });
        });

        // --- MIDTRANS SNAP PAY BUTTON LISTENER ---
        const payBtns = document.querySelectorAll('.btn-midtrans-pay');
        payBtns.forEach(btn => {
            btn.addEventListener('click', async (e) => {
                const target = e.currentTarget as HTMLButtonElement;
                const goalId = target.getAttribute('data-goal-id') || '';
                const amount = parseFloat(target.getAttribute('data-amount') || '0');
                const title = target.getAttribute('data-title') || 'Setoran Tabungan';

                if (!goalId || amount <= 0) return;

                const origHtml = target.innerHTML;
                target.disabled = true;
                target.innerHTML = '<i data-feather="loader" class="w-4 h-4 animate-spin mr-2"></i> Memproses QRIS...';

                try {
                    const res = await fetch('/api/payment/midtrans', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ goalId, amount, title })
                    });
                    const data = await res.json();

                    if (data.success && data.token && !data.is_mock && (window as any).snap) {
                        (window as any).snap.pay(data.token, {
                            onSuccess: () => window.location.reload(),
                            onPending: () => window.location.reload(),
                            onError: () => alert('Pembayaran gagal atau dibatalkan.'),
                            onClose: () => window.location.reload()
                        });
                    } else if (data.is_mock) {
                        alert('Mode Simulasi: Server Key belum terbaca oleh Astro. Mohon restart dev server terminal Anda.');
                    } else {
                        alert('Gagal membuka QRIS Midtrans.');
                    }
                } catch (err) {
                    console.error("Midtrans Pay Error:", err);
                    alert('Gangguan koneksi.');
                } finally {
                    target.disabled = false;
                    target.innerHTML = origHtml;
                }
            });
        });
    });
</script>
