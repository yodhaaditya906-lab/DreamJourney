---
import Layout from '../layouts/Layout.astro';

const { userId } = Astro.locals.auth();

if (!userId) {
    return Astro.redirect('/');
}
---

<Layout title="Lengkapi Profil - DreamJourney">
    <main class="min-h-screen bg-gray-50 flex flex-col justify-center items-center pt-28 pb-16 px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-md w-full bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
            <div class="bg-primary px-6 py-8 text-center">
                <h2 class="text-2xl font-bold text-white">Lengkapi Profil Anda</h2>
                <p class="text-white/90 font-medium mt-2 text-sm leading-relaxed">Tinggal selangkah lagi untuk mulai merencanakan liburan impian dan menabung bersama DreamJourney!</p>
            </div>
            
            <div class="p-8">
                <form id="onboarding-form" class="space-y-5">
                    <!-- Error Alert -->
                    <div id="error-alert" class="hidden bg-red-50 text-red-600 p-4 rounded-xl text-sm font-medium border border-red-100">
                    </div>

                    <div>
                        <label for="fullName" class="block text-sm font-semibold text-gray-700">Nama Lengkap</label>
                        <p class="text-xs text-gray-500 mb-2">Nama sesuai Kartu Identitas / KTP</p>
                        <input type="text" name="fullName" id="fullName" required minlength="2" placeholder="Contoh: Budi Santoso" 
                            class="appearance-none block w-full px-4 py-3 border border-gray-300 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition">
                        <p id="fullname-error" class="text-xs mt-2 font-medium text-red-600 hidden"></p>
                    </div>

                    <div>
                        <label for="username" class="block text-sm font-semibold text-gray-700">Username</label>
                        <p class="text-xs text-gray-500 mb-2">Nama panggilan Anda di DreamJourney</p>
                        <input type="text" name="username" id="username" required minlength="3" placeholder="Contoh: travelholic99" 
                            class="appearance-none block w-full px-4 py-3 border border-gray-300 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition">
                        <p id="username-status" class="text-xs mt-2 font-medium hidden"></p>
                    </div>

                    <div>
                        <label for="domisili" class="block text-sm font-semibold text-gray-700">Domisili Kota</label>
                        <p class="text-xs text-gray-500 mb-2">Pilih kota tempat Anda tinggal saat ini</p>
                        <input type="text" name="domisili" id="domisili" required placeholder="Contoh: Jakarta Selatan" 
                            class="appearance-none block w-full px-4 py-3 border border-gray-300 rounded-xl placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition">
                        <p id="domisili-error" class="text-xs mt-2 font-medium text-red-600 hidden"></p>
                    </div>

                    <div>
                        <label for="dob" class="block text-sm font-semibold text-gray-700">Tanggal Lahir</label>
                        <p class="text-xs text-gray-500 mb-2">Anda harus berusia minimal 17 tahun untuk mendaftar</p>
                        <input type="date" name="dob" id="dob" required 
                            class="appearance-none block w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-700 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition">
                        <p id="dob-error" class="text-xs mt-2 font-medium text-red-600 hidden"></p>
                    </div>

                    <!-- Nomor WhatsApp & Verifikasi OTP -->
                    <div class="pt-1">
                        <label for="whatsapp" class="block text-sm font-semibold text-gray-700">Nomor WhatsApp</label>
                        <p class="text-xs text-gray-500 mb-2">Diperlukan untuk koordinasi & notifikasi rencana liburan</p>
                        <div class="relative flex items-center bg-[#edf3fb] border border-[#d2def0] rounded-2xl p-1.5 focus-within:ring-2 focus-within:ring-primary focus-within:border-transparent transition">
                            <span class="pl-3.5 pr-1 text-[#566882] font-semibold text-sm select-none pointer-events-none">+62</span>
                            <input type="tel" name="whatsapp" id="whatsapp" required placeholder="85779132226" 
                                class="appearance-none bg-transparent w-full py-2 px-1 text-gray-900 font-semibold placeholder-gray-400 focus:outline-none text-base tracking-wide">
                            <button type="button" id="send-otp-btn" class="px-4 py-2.5 bg-[#009b67] hover:bg-[#008558] text-white font-bold text-xs sm:text-sm rounded-xl transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1 shrink-0 cursor-pointer">
                                <span>Kirim OTP</span>
                            </button>
                        </div>
                        <p id="whatsapp-status" class="text-xs mt-2 font-medium hidden"></p>
                    </div>

                    <!-- Container Input Kode OTP (Hidden Secara Default) -->
                    <div id="otp-container" class="hidden bg-[#eafaf1] border border-[#a8f0cc] rounded-2xl p-4 sm:p-5 space-y-3 transition-all">
                        <div class="flex items-center justify-between">
                            <label for="otp-code" class="block text-xs font-bold text-[#005c3e] uppercase tracking-wider">MASUKKAN KODE OTP WA</label>
                            <span id="otp-timer" class="text-xs font-semibold text-emerald-700"></span>
                        </div>

                        <!-- Banner Mode Simulasi (Muncul jika tidak ada gateway WA terpasang) -->
                        <div id="simulated-otp-banner" class="hidden bg-amber-100/90 border border-amber-300 rounded-xl p-2.5 text-xs text-amber-900 flex items-start gap-2">
                            <span class="text-base leading-none">💡</span>
                            <div>
                                <strong class="font-bold">Mode Simulasi OTP:</strong> Kode Anda adalah <span id="simulated-otp-code" class="font-mono font-bold text-amber-950 underline text-sm"></span>
                            </div>
                        </div>

                        <div class="flex gap-2.5 items-center">
                            <input type="text" id="otp-code" maxlength="6" placeholder="6 Digit Kode" 
                                class="tracking-widest font-mono text-center font-bold text-lg block w-full px-3 py-2.5 border-2 border-[#00a86b] rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-400 bg-white text-gray-900 placeholder:font-normal placeholder:tracking-normal placeholder:text-gray-400">
                            <button type="button" id="verify-otp-btn" class="px-5 py-3 bg-[#009b67] hover:bg-[#008558] text-white font-bold text-sm rounded-xl transition whitespace-nowrap shadow-xs cursor-pointer">
                                Verifikasi
                            </button>
                        </div>
                    </div>

                    <div class="pt-3">
                        <button type="submit" id="submit-btn" disabled class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-2xl text-base font-bold text-[#68768a] bg-[#cbd3df] transition-all cursor-not-allowed">
                            Simpan & Mulai Menabung
                        </button>
                    </div>
                </form>
            </div>
        </div>
        
    </main>
</Layout>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('onboarding-form') as HTMLFormElement;
        const btn = document.getElementById('submit-btn') as HTMLButtonElement;
        const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
        const fullNameInput = document.getElementById('fullName') as HTMLInputElement;
        const usernameInput = document.getElementById('username') as HTMLInputElement;
        const usernameStatus = document.getElementById('username-status') as HTMLParagraphElement;
        const dobInput = document.getElementById('dob') as HTMLInputElement;
        const dobError = document.getElementById('dob-error') as HTMLParagraphElement;

        const whatsappInput = document.getElementById('whatsapp') as HTMLInputElement;
        const sendOtpBtn = document.getElementById('send-otp-btn') as HTMLButtonElement;
        const whatsappStatus = document.getElementById('whatsapp-status') as HTMLParagraphElement;
        const otpContainer = document.getElementById('otp-container') as HTMLDivElement;
        const otpCodeInput = document.getElementById('otp-code') as HTMLInputElement;
        const verifyOtpBtn = document.getElementById('verify-otp-btn') as HTMLButtonElement;
        const otpTimer = document.getElementById('otp-timer') as HTMLSpanElement;
        const simulatedOtpBanner = document.getElementById('simulated-otp-banner') as HTMLDivElement;
        const simulatedOtpCode = document.getElementById('simulated-otp-code') as HTMLSpanElement;

        let isWhatsappVerified = false;
        let resendTimer = 0;
        let timerInterval: any;
        
        // Batasi tanggal lahir maksimum (pengguna harus berusia minimal 17 tahun)
        const today = new Date();
        const maxDobDate = new Date(today.getFullYear() - 17, today.getMonth(), today.getDate());
        const yyyy = maxDobDate.getFullYear();
        const mm = String(maxDobDate.getMonth() + 1).padStart(2, '0');
        const dd = String(maxDobDate.getDate()).padStart(2, '0');
        if (dobInput) {
            dobInput.max = `${yyyy}-${mm}-${dd}`;
        }

        const isAgeValid = (dobStr: string): boolean => {
            if (!dobStr) return false;
            const birthDate = new Date(dobStr);
            if (isNaN(birthDate.getTime())) return false;
            const now = new Date();
            let age = now.getFullYear() - birthDate.getFullYear();
            const monthDiff = now.getMonth() - birthDate.getMonth();
            if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < birthDate.getDate())) {
                age--;
            }
            return age >= 17;
        };

        const validateDob = (): boolean => {
            const val = dobInput ? dobInput.value : '';
            if (val && !isAgeValid(val)) {
                if (dobError) {
                    dobError.innerText = '❌ Layanan ini khusus pengguna berusia 17 tahun ke atas.';
                    dobError.classList.remove('hidden');
                }
                return false;
            } else {
                if (dobError) {
                    dobError.classList.add('hidden');
                }
                return true;
            }
        };

        dobInput?.addEventListener('change', validateDob);
        dobInput?.addEventListener('input', validateDob);

        let isUsernameValid = false;
        let usernameTimeout: any;

        // Coba isi otomatis jika data sudah ada
        const attemptPrefill = () => {
            if (window.Clerk && window.Clerk.user) {
                const user = window.Clerk.user;
                if (user.fullName && !fullNameInput.value) {
                    fullNameInput.value = user.fullName;
                } else if (user.unsafeMetadata?.fullName && !fullNameInput.value) {
                    fullNameInput.value = user.unsafeMetadata.fullName as string;
                }

                if (user.username && !usernameInput.value) {
                    usernameInput.value = user.username;
                    checkUsername(user.username);
                }
                if (user.unsafeMetadata?.domisili) {
                    (document.getElementById('domisili') as HTMLInputElement).value = user.unsafeMetadata.domisili as string;
                }
                if (user.unsafeMetadata?.dob) {
                    (document.getElementById('dob') as HTMLInputElement).value = user.unsafeMetadata.dob as string;
                    validateDob();
                }
                if (user.unsafeMetadata?.whatsapp) {
                    let waVal = String(user.unsafeMetadata.whatsapp);
                    if (waVal.startsWith('+62')) waVal = waVal.substring(3);
                    else if (waVal.startsWith('62')) waVal = waVal.substring(2);
                    else if (waVal.startsWith('0')) waVal = waVal.substring(1);
                    whatsappInput.value = waVal;

                    if (user.unsafeMetadata?.whatsappVerified) {
                        markWhatsappVerified();
                    }
                }
            } else {
                setTimeout(attemptPrefill, 500);
            }
        };
        attemptPrefill();

        const checkUsername = async (username: string) => {
            if (username.length < 3) {
                usernameStatus.classList.add('hidden');
                isUsernameValid = false;
                return;
            }

            usernameStatus.classList.remove('hidden');
            usernameStatus.className = 'text-xs mt-2 font-medium text-gray-500';
            usernameStatus.innerText = 'Mengecek ketersediaan...';
            isUsernameValid = false;

            try {
                const res = await fetch(`/api/check-username?username=${encodeURIComponent(username)}`);
                const data = await res.json();

                if (res.ok && data.isAvailable) {
                    usernameStatus.className = 'text-xs mt-2 font-medium text-green-600';
                    usernameStatus.innerText = '✅ Username tersedia!';
                    isUsernameValid = true;
                } else if (res.ok && !data.isAvailable) {
                    usernameStatus.className = 'text-xs mt-2 font-medium text-red-600';
                    usernameStatus.innerText = '❌ Username sudah terpakai, pilih yang lain.';
                    isUsernameValid = false;
                } else {
                    usernameStatus.className = 'text-xs mt-2 font-medium text-red-600';
                    usernameStatus.innerText = 'Gagal mengecek username.';
                }
            } catch (err) {
                usernameStatus.className = 'text-xs mt-2 font-medium text-red-600';
                usernameStatus.innerText = 'Kesalahan jaringan.';
            }
        };

        usernameInput.addEventListener('input', (e) => {
            const val = (e.target as HTMLInputElement).value.trim();
            clearTimeout(usernameTimeout);
            usernameTimeout = setTimeout(() => {
                checkUsername(val);
            }, 600);
        });

        // Format nomor WhatsApp lengkap (+62...)
        const getFullWhatsappNumber = (): string => {
            let num = whatsappInput.value.trim().replace(/\D/g, '');
            if (num.startsWith('0')) {
                num = num.substring(1);
            }
            return '+62' + num;
        };

        const markWhatsappVerified = () => {
            isWhatsappVerified = true;
            whatsappInput.disabled = true;
            sendOtpBtn.disabled = true;
            sendOtpBtn.innerHTML = '<span>Verified ✓</span>';
            sendOtpBtn.className = 'px-4 py-2.5 bg-green-100 text-green-700 font-bold text-xs sm:text-sm rounded-xl flex items-center gap-1 cursor-default shrink-0';

            whatsappStatus.className = 'text-xs mt-2 font-bold text-emerald-600 flex items-center gap-1';
            whatsappStatus.innerText = '✅ Nomor WhatsApp telah terverifikasi!';
            whatsappStatus.classList.remove('hidden');

            otpContainer.classList.add('hidden');
            clearInterval(timerInterval);

            // Aktifkan dan ubah warna tombol submit ke biru setelah OTP terverifikasi
            if (btn) {
                btn.disabled = false;
                btn.className = 'w-full flex justify-center py-3.5 px-4 border border-transparent rounded-2xl shadow-md text-base font-bold text-white bg-primary hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all cursor-pointer';
            }
        };

        const startResendTimer = (seconds: number = 60) => {
            resendTimer = seconds;
            sendOtpBtn.disabled = true;
            
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                resendTimer--;
                if (resendTimer <= 0) {
                    clearInterval(timerInterval);
                    sendOtpBtn.disabled = false;
                    sendOtpBtn.innerHTML = '<span>Kirim Ulang</span>';
                    otpTimer.innerText = '';
                } else {
                    sendOtpBtn.innerHTML = `<span>Resend (${resendTimer}s)</span>`;
                    otpTimer.innerText = `Ulangi dalam ${resendTimer}s`;
                }
            }, 1000);
        };

        // Kirim OTP via API
        sendOtpBtn.addEventListener('click', async () => {
            const num = whatsappInput.value.trim();
            const clean = num.replace(/\D/g, '');
            
            if (clean.length < 8) {
                whatsappStatus.className = 'text-xs mt-2 font-medium text-red-600';
                whatsappStatus.innerText = '❌ Masukkan nomor WhatsApp yang valid (minimal 8 digit)';
                whatsappStatus.classList.remove('hidden');
                return;
            }

            const fullNumber = getFullWhatsappNumber();
            whatsappStatus.className = 'text-xs mt-2 font-medium text-emerald-600';
            whatsappStatus.innerText = 'Mengirimkan kode OTP...';
            whatsappStatus.classList.remove('hidden');
            sendOtpBtn.disabled = true;

            try {
                const res = await fetch('/api/send-whatsapp-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ whatsappNumber: fullNumber })
                });

                const data = await res.json();

                if (res.ok && data.success) {
                    whatsappStatus.className = 'text-xs mt-2 font-medium text-emerald-700';
                    whatsappStatus.innerText = `📩 ${data.message}`;
                    
                    otpContainer.classList.remove('hidden');
                    otpCodeInput.focus();

                    if (data.isSimulated && data.simulatedOtp) {
                        simulatedOtpCode.innerText = data.simulatedOtp;
                        simulatedOtpBanner.classList.remove('hidden');
                        // auto fill ke input OTP untuk kenyamanan testing
                        otpCodeInput.value = data.simulatedOtp;
                    } else {
                        simulatedOtpBanner.classList.add('hidden');
                    }

                    startResendTimer(60);
                } else {
                    whatsappStatus.className = 'text-xs mt-2 font-medium text-red-600';
                    whatsappStatus.innerText = `❌ ${data.error || 'Gagal mengirim OTP'}`;
                    sendOtpBtn.disabled = false;
                }
            } catch (err) {
                whatsappStatus.className = 'text-xs mt-2 font-medium text-red-600';
                whatsappStatus.innerText = '❌ Gagal terhubung ke server untuk pengiriman OTP.';
                sendOtpBtn.disabled = false;
            }
        });

        // Verifikasi Kode OTP
        verifyOtpBtn.addEventListener('click', async () => {
            const otpCode = otpCodeInput.value.trim();
            if (otpCode.length !== 6) {
                whatsappStatus.className = 'text-xs mt-2 font-medium text-red-600';
                whatsappStatus.innerText = '❌ Masukkan 6 digit kode OTP yang benar.';
                whatsappStatus.classList.remove('hidden');
                return;
            }

            const fullNumber = getFullWhatsappNumber();
            verifyOtpBtn.disabled = true;
            verifyOtpBtn.innerText = 'Memeriksa...';

            try {
                const res = await fetch('/api/verify-whatsapp-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ whatsappNumber: fullNumber, otpCode })
                });

                const data = await res.json();

                if (res.ok && data.success) {
                    markWhatsappVerified();
                } else {
                    whatsappStatus.className = 'text-xs mt-2 font-medium text-red-600 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-red-50 p-2.5 rounded-lg border border-red-200';
                    const errorMsg = data.error || 'Kode OTP tidak sesuai atau sudah kadaluwarsa.';
                    whatsappStatus.innerHTML = `
                        <div class="flex items-center gap-1.5 flex-1">
                            <span>❌ ${errorMsg}</span>
                        </div>
                        <button type="button" id="retry-send-otp-btn" class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded-md transition shadow-xs whitespace-nowrap cursor-pointer">
                            <span>🔄 Minta Kode Baru</span>
                        </button>
                    `;
                    whatsappStatus.classList.remove('hidden');
                    verifyOtpBtn.disabled = false;
                    verifyOtpBtn.innerText = 'Verifikasi';

                    const retryBtn = document.getElementById('retry-send-otp-btn');
                    if (retryBtn) {
                        retryBtn.addEventListener('click', () => {
                            sendOtpBtn.disabled = false;
                            sendOtpBtn.click();
                        });
                    }
                }
            } catch (err) {
                whatsappStatus.className = 'text-xs mt-2 font-medium text-red-600 flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-red-50 p-2.5 rounded-lg border border-red-200';
                whatsappStatus.innerHTML = `
                    <div class="flex items-center gap-1.5 flex-1">
                        <span>❌ Terjadi kesalahan saat memverifikasi OTP.</span>
                    </div>
                    <button type="button" id="retry-send-otp-btn" class="inline-flex items-center gap-1 px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded-md transition shadow-xs whitespace-nowrap cursor-pointer">
                        <span>🔄 Minta Kode Baru</span>
                    </button>
                `;
                whatsappStatus.classList.remove('hidden');
                verifyOtpBtn.disabled = false;
                verifyOtpBtn.innerText = 'Verifikasi';

                const retryBtn = document.getElementById('retry-send-otp-btn');
                if (retryBtn) {
                    retryBtn.addEventListener('click', () => {
                        sendOtpBtn.disabled = false;
                        sendOtpBtn.click();
                    });
                }
            }
        });

        const fullnameError = document.getElementById('fullname-error') as HTMLParagraphElement;
        const domisiliError = document.getElementById('domisili-error') as HTMLParagraphElement;
        const domisiliInput = document.getElementById('domisili') as HTMLInputElement;

        // Form Submit
        form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            if (fullnameError) fullnameError.classList.add('hidden');
            if (domisiliError) domisiliError.classList.add('hidden');
            if (errorAlert) errorAlert.classList.add('hidden');

            const fullName = fullNameInput.value.trim();
            const username = usernameInput.value.trim();
            const domisili = domisiliInput ? domisiliInput.value.trim() : '';
            const dob = dobInput ? dobInput.value.trim() : '';

            // 1. Validasi Nama Lengkap
            if (!fullName || fullName.length < 2) {
                if (fullnameError) {
                    fullnameError.innerText = "❌ Nama Lengkap wajib diisi (minimal 2 karakter).";
                    fullnameError.classList.remove('hidden');
                }
                fullNameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                fullNameInput.focus();
                return;
            }

            // 2. Validasi Username
            if (!username || !isUsernameValid) {
                usernameStatus.className = 'text-xs mt-2 font-medium text-red-600';
                usernameStatus.innerText = '❌ Silakan gunakan username yang valid & tersedia.';
                usernameStatus.classList.remove('hidden');
                usernameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                usernameInput.focus();
                return;
            }

            // 3. Validasi Domisili
            if (!domisili) {
                if (domisiliError) {
                    domisiliError.innerText = "❌ Domisili Kota wajib diisi.";
                    domisiliError.classList.remove('hidden');
                }
                if (domisiliInput) {
                    domisiliInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    domisiliInput.focus();
                }
                return;
            }

            // 4. Validasi Tanggal Lahir (17 tahun)
            if (!dob || !validateDob()) {
                if (dobError) {
                    dobError.innerText = "❌ Maaf, Anda harus berusia minimal 17 tahun untuk mendaftar.";
                    dobError.classList.remove('hidden');
                }
                if (dobInput) {
                    dobInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    dobInput.focus();
                }
                return;
            }

            // 5. Validasi WhatsApp OTP
            if (!isWhatsappVerified) {
                whatsappStatus.className = 'text-xs mt-2 font-medium text-red-600 flex items-center gap-1';
                whatsappStatus.innerText = '❌ Silakan masukkan nomor WhatsApp dan lakukan verifikasi OTP terlebih dahulu.';
                whatsappStatus.classList.remove('hidden');
                whatsappInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
                whatsappInput.focus();
                return;
            }
            
            const whatsapp = getFullWhatsappNumber();
            
            errorAlert.classList.add('hidden');
            btn.innerHTML = 'Berhasil! Mengarahkan...';
            btn.disabled = true;
            btn.classList.add('opacity-70');
            
            try {
                if (window.Clerk && window.Clerk.user) {
                    // 1. Simpan metadata ke Clerk secara await agar terdaftar di sesi user
                    await window.Clerk.user.update({
                        unsafeMetadata: {
                            fullName: fullName,
                            username: username,
                            domisili: domisili,
                            dob: dob,
                            whatsapp: whatsapp,
                            whatsappVerified: true
                        }
                    });

                    // 2. Simpan juga ke Supabase database
                    await fetch('/api/save-user', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            userId: window.Clerk.user.id,
                            fullName: fullName,
                            username: username,
                            domisili: domisili,
                            dob: dob,
                            whatsapp: whatsapp,
                            whatsappVerified: true
                        })
                    }).catch(err => console.warn("Supabase sync:", err));
                }

                // 3. Ambil & decode URL redirect (misal /setup-saving?title=Bandung...)
                const urlParams = new URLSearchParams(window.location.search);
                let redirectUrl = urlParams.get('redirect_url') || '/dashboard';
                
                if (redirectUrl.startsWith('%2F') || redirectUrl.startsWith('%2f')) {
                    redirectUrl = decodeURIComponent(redirectUrl);
                }

                // 4. Langsung arahkan ke halaman tujuan tanpa memutar kembali ke onboarding!
                window.location.replace(redirectUrl);
                
            } catch (error: any) {
                console.error("Redirect Error:", error);
                window.location.replace('/dashboard');
            }
        });
    });
</script>
