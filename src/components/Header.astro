---
import { Show, UserButton, SignInButton, SignUpButton } from '@clerk/astro/components';
import { supabase } from '../lib/supabase';

const currentPath = Astro.url.pathname;
const { userId } = Astro.locals.auth();

let mobileUserAvatar = '';
let hasUsername = true;
if (userId) {
    const user = await Astro.locals.currentUser();
    const { data: dbUser } = await supabase.from('users').select('*').eq('id', userId).maybeSingle();
    mobileUserAvatar = dbUser?.avatar_url || dbUser?.image_url || user?.imageUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(user?.fullName || 'User')}&background=random&color=fff&bold=true`;
    hasUsername = !!(dbUser?.username || user?.username);
}
---

<header class="fixed top-0 left-0 right-0 bg-white/90 backdrop-blur-md shadow-sm border-b border-gray-100 z-50">
    <div class="w-full lg:w-[85%] mx-auto px-3 sm:px-4 h-14 sm:h-16 lg:h-20 flex justify-between items-center">
        
        <!-- Toggle Button for Mobile Menu (Hamburger) - Left on Mobile -->
        <button class="lg:hidden text-gray-600 cursor-pointer p-2 order-1 lg:order-none" id="mobile-menu-btn" aria-label="Toggle Menu">
            <i data-feather="menu"></i>
        </button>

        <!-- Search Input - Center on Mobile -->
        <div class="lg:hidden order-2 lg:order-none flex-1 mx-2 flex justify-center">
            <form action="/packages" method="GET" class="relative w-full">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <i data-feather="search" class="w-4 h-4 text-gray-400"></i>
                </div>
                <input type="text" name="q" placeholder="Cari destinasi wisata..." class="bg-gray-100 border border-gray-200 text-gray-800 text-[13px] rounded-full w-full pl-9 pr-4 py-2 focus:bg-white focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all shadow-sm">
            </form>
        </div>

        <!-- Mobile User Profile Icon / Avatar - Right on Mobile Only -->
        <div class="lg:hidden order-3 flex items-center pl-1">
            <Show when="signed-in">
                <a href="/profile" class="block relative flex-shrink-0 cursor-pointer" title="Profil Saya">
                    <img 
                        id="header-mobile-avatar-img"
                        src={mobileUserAvatar} 
                        alt="Profil Saya" 
                        class="w-9 h-9 rounded-full object-cover ring-2 ring-primary/40 shadow-2xs bg-slate-100"
                    />
                </a>
            </Show>
            <Show when="signed-out">
                <SignInButton 
                    mode="modal" 
                    class="w-9 h-9 rounded-full bg-indigo-50 text-primary flex items-center justify-center cursor-pointer shadow-2xs border border-indigo-100/80 hover:bg-indigo-100 transition-colors"
                    title="Masuk Akun"
                >
                    <i data-feather="user" class="w-4.5 h-4.5"></i>
                </SignInButton>
            </Show>
        </div>

        <!-- Desktop Logo - Hidden on Mobile, Left on Desktop -->
        <a href="/" class="hidden lg:flex items-center gap-2 tap-active order-1">
            <img src="/images/logo.png" alt="DreamJourney Logo" class="h-10 w-auto object-contain" />
            <span class="text-2xl font-bold text-primary tracking-tight">DreamJourney</span>
        </a>
        
        <!-- Desktop Nav - Center on Desktop, Hidden on Mobile -->
        <nav class="hidden lg:flex items-center gap-8 order-2">
            <a href="/" class={`font-medium transition ${currentPath === '/' ? 'text-primary' : 'text-gray-600 hover:text-primary'}`}>Beranda</a>
            <a href="/packages" class={`font-medium transition ${currentPath === '/packages' ? 'text-primary' : 'text-gray-600 hover:text-primary'}`}>Paket Liburan</a>
            <a href="/planner" class={`font-medium transition ${currentPath === '/planner' ? 'text-primary' : 'text-gray-600 hover:text-primary'}`}>Rencana Perjalanan</a>
            <a href="/team-calendar" class={`font-medium transition ${currentPath === '/team-calendar' ? 'text-primary' : 'text-gray-600 hover:text-primary'}`}>Kalender Tim</a>
            <a href="/community" class={`font-medium transition ${currentPath === '/community' ? 'text-primary' : 'text-gray-600 hover:text-primary'}`}>Komunitas</a>
        </nav>

        <!-- Desktop Auth & Profile - Right on Desktop, Hidden on Mobile -->
        <div class="hidden lg:flex items-center gap-4 order-3">
            <Show when="signed-out">
                <SignInButton mode="modal" class="text-gray-600 hover:text-primary font-medium transition cursor-pointer">
                    Masuk
                </SignInButton>
                <SignUpButton mode="modal" fallbackRedirectUrl="/" class="bg-primary hover:bg-primary-dark text-white px-6 py-2 rounded-full font-semibold transition cursor-pointer shadow-sm hover:shadow">
                    Daftar
                </SignUpButton>
            </Show>
            <Show when="signed-in">
                <div class="flex items-center gap-4 sm:gap-5">
                    {!hasUsername && (
                        <a href="/onboarding" class="flex items-center gap-1.5 text-xs font-bold bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-3.5 py-1.5 rounded-full transition shadow-xs hover:shadow-sm" title="Lengkapi data profil & username">
                            <i data-feather="shield-check" class="w-3.5 h-3.5"></i>
                            <span>Verifikasi Profil</span>
                        </a>
                    )}
                    <a href="/dashboard" class={`flex items-center gap-2 font-medium transition ${currentPath === '/dashboard' ? 'text-primary' : 'text-gray-600 hover:text-primary'}`} title="Savings Tracker Dashboard">
                        <i data-feather="pie-chart" class="w-5 h-5"></i>
                        <span>Dashboard</span>
                    </a>
                    <div class="h-6 w-px bg-gray-200"></div>
                    <UserButton 
                        userProfileMode="navigation" 
                        userProfileUrl="/profile" 
                        appearance={{
                            elements: {
                                userPreviewSecondaryIdentifier: "capitalize"
                            }
                        }}
                    />
                </div>
            </Show>
        </div>
    </div>

    <!-- Mobile Drawer Navigation -->
    <div class="hidden lg:hidden bg-white border-t border-gray-100 shadow-inner px-4 py-6" id="mobile-menu-drawer">
        <Show when="signed-in">
            <div class="flex items-center justify-between gap-3 mb-5">
                <a href="/profile" class="flex items-center gap-3 group min-w-0">
                    <UserButton 
                        userProfileMode="navigation" 
                        userProfileUrl="/profile" 
                        appearance={{
                            elements: {
                                userPreviewSecondaryIdentifier: "capitalize"
                            }
                        }}
                    />
                    <div class="text-left min-w-0">
                        <p id="header-mobile-fullname" class="font-bold text-gray-800 text-sm group-hover:text-primary transition truncate">Profil Akun Saya</p>
                        <p id="header-mobile-username" class="text-xs text-gray-500 truncate">{hasUsername ? 'Lihat profil & opsi keluar' : '⚠️ Username belum diset'}</p>
                    </div>
                </a>
                {!hasUsername && (
                    <a href="/onboarding" class="flex items-center gap-1 text-xs font-bold bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white px-3 py-1.5 rounded-full transition shadow-xs flex-shrink-0">
                        <i data-feather="shield-check" class="w-3.5 h-3.5"></i>
                        <span>Verifikasi</span>
                    </a>
                )}
            </div>
            <hr class="border-gray-100 mb-5">
        </Show>
        <nav class="flex flex-col gap-4">
            <a href="/" class={`font-medium transition py-2 ${currentPath === '/' ? 'text-primary' : 'text-gray-600'}`}>Beranda</a>
            <a href="/packages" class={`font-medium transition py-2 ${currentPath === '/packages' ? 'text-primary' : 'text-gray-600'}`}>Paket Liburan</a>
            <a href="/planner" class={`font-medium transition py-2 ${currentPath === '/planner' ? 'text-primary' : 'text-gray-600'}`}>Rencana Perjalanan</a>
            <a href="/team-calendar" class={`font-medium transition py-2 ${currentPath === '/team-calendar' ? 'text-primary' : 'text-gray-600'}`}>Kalender Tim</a>
            <a href="/community" class={`font-medium transition py-2 ${currentPath === '/community' ? 'text-primary' : 'text-gray-600'}`}>Komunitas</a>
            <hr class="border-gray-100 my-2">
            <div class="flex flex-col gap-3">
                <Show when="signed-out">
                    <SignInButton mode="modal" class="text-gray-600 font-medium py-2 text-center w-full cursor-pointer hover:bg-gray-50 rounded-lg">
                        Masuk
                    </SignInButton>
                    <SignUpButton mode="modal" fallbackRedirectUrl="/" class="bg-primary hover:bg-primary-dark text-white py-2.5 rounded-full font-semibold text-center w-full transition cursor-pointer shadow-sm">
                        Daftar
                    </SignUpButton>
                </Show>
            </div>
        </nav>
    </div>
</header>

<script is:inline>
    // Toggle Mobile Drawer Menu
    document.addEventListener("DOMContentLoaded", function() {
        const btn = document.getElementById('mobile-menu-btn');
        const drawer = document.getElementById('mobile-menu-drawer');
        if (btn && drawer) {
            btn.addEventListener('click', function() {
                drawer.classList.toggle('hidden');
            });
        }

        // Sync cached avatar for mobile header avatar
        const mobileAvatarImg = document.getElementById('header-mobile-avatar-img');
        if (mobileAvatarImg && window.Clerk && window.Clerk.user) {
            const username = (window.Clerk.user.username || '').toLowerCase();
            if (username) {
                const cached = localStorage.getItem('dream_user_avatar_' + username);
                if (cached) {
                    mobileAvatarImg.src = cached;
                } else if (window.Clerk.user.imageUrl) {
                    mobileAvatarImg.src = window.Clerk.user.imageUrl;
                }
            }
        }
    });
</script>
